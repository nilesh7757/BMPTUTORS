          "content": {
            "size": 10720,
            "mimeType": "application/javascript",
            "text": "// Object to store references to each TomSelect instance\r\nvar phoneCodeTomSelectInstances = {};\r\n// <select id='countryPhoneCodeId' .....>\r\n// e.g. selectedPhoneCodeCountryIdMap.set('countryPhoneCodeId', 111) Use this map to make values selected when page loads for particular select instance.\r\nconst selectedPhoneCodeCountryIdMap = new Map();\r\nvar initTomSelectForPhoneCode = function(){\r\n\t// Select all elements with the class .ts-custom-phone-code\r\n\tdocument.querySelectorAll('.ts-custom-phone-code').forEach(function(selectElement) {\r\n\t\t// Initialize a new TomSelect instance for each select element\r\n\t\t// e.g. userPhoneCountryId, studentPhoneCodeCountryId etc\r\n\t\tlet instanceId = selectElement.id;  // Use the select element's ID as the key\r\n\t\tconsole.log(' ---- selected Element ---- ', instanceId);\r\n\t\tlet countryPhoneCodeTomSelectInstance = new TomSelect(selectElement, {\r\n\t\t\tvalueField: 'countryId',   // Use countryId as the value field\r\n\t\t\tlabelField: 'countryName', // Use countryName as the label field\r\n\t\t\tsearchField: ['countryName', 'phoneCode'],  // Search by countryName\r\n\t\t\tmaxItems: 1,  // Single select,\r\n\t\t\tmaxOptions: null,\r\n\t\t\t//openOnFocus: false,  // Ensure dropdown does not open on focus (dont use)\r\n\t\t\t// fetch remote data\r\n\t\t\t/*load: function(query, callback) {\r\n                // Do nothing, so no loader appears.\r\n                callback();\r\n            },*/\r\n\t\t\tonInitialize: function() {\r\n\t\t\t\t// Access the ts-wrapper element\r\n\t\t\t\tconst tsWrapper = this.wrapper;\r\n\t\t\t\t// Remove the unwanted class from the ts-wrapper\r\n\t\t\t\tif (tsWrapper.classList.contains('form-control')) {\r\n\t\t\t\t\ttsWrapper.classList.remove('form-control');\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\t// Event to hide cursor after selection\r\n\t\t\tonItemAdd: function(value, item) {\r\n\t\t\t\tthis.blur();\r\n\t\t\t\t// THis is required to set new value. e.g. if old phone code is +1 and user changed location whose phone code is +91 then system is still using old phone code.\r\n\t\t\t\tsetPhoneCountryIdToHiddenFieldUsingTomSelect(instanceId);\r\n\t\t\t},\r\n\t\t\t// Handle when the user opens the dropdown to change selection\r\n\t\t\tonDropdownOpen: function(dropdown) {\r\n\t\t\t\tconst input = this.control_input;\r\n\t\t\t\tinput.value = '';  // Clear the input field\r\n\t\t\t\tinput.focus();     // Place focus in the search field\r\n\r\n\t\t\t\tconst selectedItem = this.control.querySelector('.item');  // Select the currently selected item\r\n\t\t\t\t// Apply a custom class to the selected item\r\n\t\t\t\tif (selectedItem) {\r\n\t\t\t\t\tselectedItem.classList.add('ts-float-selected');\r\n\t\t\t\t}\r\n\t\t\t\tdropdown.classList.add('displayTable');\r\n\t\t\t\t// const selectedValue = this.getValue();  // Get the currently selected value\r\n\t\t\t},\r\n\t\t\tonDropdownClose: function(dropdown) {\r\n\t\t\t\tconst selectedItem = this.control.querySelector('.item');  // Select the currently selected item\r\n\t\t\t\t// Apply a custom class to the selected item\r\n\t\t\t\tif (selectedItem) {\r\n\t\t\t\t\tselectedItem.classList.remove('ts-float-selected');\r\n\t\t\t\t}\r\n\t\t\t\tdropdown.classList.remove('displayTable');\r\n\t\t\t\tthis.blur();\r\n\t\t\t},\r\n\t\t\trender: {\r\n\t\t\t\t// Custom rendering to display additional details (like description)\r\n\t\t\t\toption: function(item, escape) {\r\n\t\t\t\t\tvar countryFlag = '';\r\n\t\t\t\t\tif(isNotBlank(item.flagCode))\r\n\t\t\t\t\t\tcountryFlag = item.flagCode;\r\n\t\t\t\t\tvar data = \"<div><span>\" +countryFlag+ \" +\" + item.phoneCode+ \" \" + item.countryName + \"</span>\";\r\n\t\t\t\t\treturn data;\r\n\t\t\t\t},\r\n\t\t\t\titem: function(item, escape) {\r\n\t\t\t\t\tvar countryFlag = '';\r\n\t\t\t\t\tif(isNotBlank(item.flagCode))\r\n\t\t\t\t\t\tcountryFlag = item.flagCode;\r\n\t\t\t\t\tvar data = \"<div><span>\" +countryFlag+ \" +\" + item.phoneCode+ \"</span>\";\r\n\t\t\t\t\treturn data;\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t});\r\n\r\n\t\t// Store the instance using its ID as the key\r\n\t\tphoneCodeTomSelectInstances[instanceId] = countryPhoneCodeTomSelectInstance;\r\n\r\n\t\t// Manually trigger loading the data after initializing TomSelect\r\n\t\tfetch(URL_PREFIX_API_USER+\"/country-phone-code\")\r\n\t\t\t.then(response => response.json())\r\n\t\t\t.then(json => {\r\n\t\t\t\tif (json && json.data) {\r\n\t\t\t\t\tcountryPhoneCodeTomSelectInstance.addOption(json.data);  // Add options programmatically\r\n\t\t\t\t\t// countryPhoneCodeTomSelectInstance.refreshOptions();  // Refresh options (Don't use it. It keeps dropdown open when editing page)\r\n\t\t\t\t\tif(isNotBlank(selectedPhoneCodeCountryIdMap) && selectedPhoneCodeCountryIdMap.size>0){\r\n\t\t\t\t\t\tselectedPhoneCodeCountryIdMap.forEach((value, key) => {\r\n\t\t\t\t\t\t\tif (instanceId === key && isNotBlank(value)) {\r\n\t\t\t\t\t\t\t\tconsole.log(' Make option selected: ---key -- ', key, ' --- value -- ', value, ' --- instanceId -- ', instanceId);\r\n\t\t\t\t\t\t\t\tcountryPhoneCodeTomSelectInstance.setValue(value);\r\n\t\t\t\t\t\t\t\tsetPhoneCountryIdToHiddenFieldUsingTomSelect(instanceId); // Update the job if phoneCode was not set earlier\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t\t.catch((error) => {\r\n\t\t\t\tconsole.error(\"Failed to fetch country phone code using tom select\", error);\r\n\t\t\t});\r\n\t});\r\n};\r\n\r\n/*// Function to keep checking until TomSelect instance is ready\r\nfunction setUserPhoneCountryIdTsSelect(countryId) {\r\n\tconsole.log(' -- Calling user phone code by countryId:', countryId);\r\n\t// Keep checking until TomSelect is initialized\r\n\tconst userPhoneCodeTsSelectInterval = setInterval(function() {\r\n\t\tif (typeof countryPhoneCodeTomSelectInstance !== 'undefined') {\r\n\t\t\tclearInterval(userPhoneCodeTsSelectInterval); // Stop checking once it's initialized\r\n\t\t\tif(isNotBlank(countryId)) {\r\n\t\t\t\tconsole.log(' --------->> setting phone code by countryId:', countryId);\r\n\t\t\t\t// Set the value of the TomSelect instance\r\n\t\t\t\tcountryPhoneCodeTomSelectInstance.setValue(parseInt(countryId));\r\n\t\t\t} else {\r\n\t\t\t\t// Clear all selected options\r\n\t\t\t\tcountryPhoneCodeTomSelectInstance.clear();\r\n\t\t\t\tsetPhoneCountryIdToHiddenFieldUsingTomSelect();\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tconsole.log('not ready, keep trying...');\r\n\t\t}\r\n\t}, 100); // Check every 100 milliseconds\r\n}*/\r\n\r\nvar userPhoneCodeTsSelectIntervalCount=0;\r\nfunction setUserPhoneCountryIdTsSelect(countryId, instanceId) {\r\n\tconsole.log(' -- Calling user phone code by countryId:', countryId, \", instanceId: \", instanceId);\r\n\r\n\t// Keep checking until the specific TomSelect instance is initialized\r\n\tconst userPhoneCodeTsSelectInterval = setInterval(function() {\r\n\t\tconst countryPhoneCodeTomSelectInstance = phoneCodeTomSelectInstances[instanceId]; // Get the specific instance\r\n\t\tif (typeof countryPhoneCodeTomSelectInstance !== 'undefined') {\r\n\t\t\tclearInterval(userPhoneCodeTsSelectInterval); // Stop checking once it's initialized\r\n\t\t\tif (isNotBlank(countryId)) {\r\n\t\t\t\tconsole.log(' --------->> setting phone code by countryId:', countryId);\r\n\t\t\t\t// Set the value of the specific TomSelect instance\r\n\t\t\t\tcountryPhoneCodeTomSelectInstance.setValue(parseInt(countryId));\r\n\t\t\t} else {\r\n\t\t\t\t// Clear all selected options for the specific instance\r\n\t\t\t\tcountryPhoneCodeTomSelectInstance.clear();\r\n\t\t\t\tsetPhoneCountryIdToHiddenFieldUsingTomSelect(instanceId);\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tuserPhoneCodeTsSelectIntervalCount++;\r\n\t\t\tconsole.log('setUserPhoneCountryIdTsSelect() not ready, keep trying...');\r\n\t\t\tif(userPhoneCodeTsSelectIntervalCount>10){\r\n\t\t\t\tconsole.log(' -- to avoid infinite calling cleared interval for instanceId: ', instanceId);\r\n\t\t\t\tclearInterval(userPhoneCodeTsSelectInterval); // Stop checking once it's initialized\r\n\t\t\t}\r\n\t\t}\r\n\t}, 100); // Check every 100 milliseconds\r\n}\r\n\r\n\r\n// Get the selected value (countryId)\r\n// const selectedCountryId = countryPhoneCodeTomSelectInstance.getValue();\r\n// Get the label (countryName) from the selected option\r\n// const selectedCountryData = countryPhoneCodeTomSelectInstance.options[selectedCountryId];\r\n\r\n/**\r\n * Call this function whenever phone code dropdown is changed otherwise it will show mismatched values countryId and different phone code.\r\n */\r\n/*function setPhoneCountryIdToHiddenFieldUsingTomSelect(){\r\n\tconst getSelectedPhoneCodeValueFromTsSelectInterval = setInterval(function() {\r\n\t\tif (typeof countryPhoneCodeTomSelectInstance !== 'undefined') {\r\n\t\t\tclearInterval(getSelectedPhoneCodeValueFromTsSelectInterval); // Stop checking once it's initialized\r\n\t\t\t// Get the selected value (countryId)\r\n\t\t\tconst selectedCountryId = countryPhoneCodeTomSelectInstance.getValue();\r\n\t\t\tconsole.log(' ---->selectedCountryId:', selectedCountryId);\r\n\t\t\tif(isNotBlank(selectedCountryId)) {\r\n\t\t\t\t$(\"#userPhoneCountryIdHidden\").val(selectedCountryId);\r\n\t\t\t\tconsole.log('selectedPhoneCountryId for form:',$(\"#userPhoneCountryIdHidden\").val());\r\n\t\t\t}\r\n\t\t}\r\n\t}, 100);\r\n}*/\r\n\r\nvar selectedPhoneCodeValueFromTsSelectIntervalCount=0;\r\nfunction setPhoneCountryIdToHiddenFieldUsingTomSelect(instanceId) {\r\n\t// allow to select on particular fields only. (TutorProfile -> Contact tutor -> Phone code, Post Requirement -> Post code)\r\n\tif(isBlank(instanceId) || instanceId !== 'userPhoneCountryId'){\r\n\t\tconsole.log('Skipped setPhoneCountryIdToHiddenFieldUsingTomSelect for InstanceId: ', instanceId);\r\n\t\treturn;\r\n\t}\r\n\tconst getSelectedPhoneCodeValueFromTsSelectInterval = setInterval(function() {\r\n\t\tconst countryPhoneCodeTomSelectInstance = phoneCodeTomSelectInstances[instanceId]; // Get the specific instance\r\n\t\tif (typeof countryPhoneCodeTomSelectInstance !== 'undefined') {\r\n\t\t\tclearInterval(getSelectedPhoneCodeValueFromTsSelectInterval); // Stop checking once it's initialized\r\n\t\t\t// Get the selected value (countryId)\r\n\t\t\tconst selectedCountryId = countryPhoneCodeTomSelectInstance.getValue();\r\n\t\t\tconsole.log(' ---->selectedCountryId:', selectedCountryId);\r\n\t\t\tif (isNotBlank(selectedCountryId)) {\r\n\t\t\t\t$(\"#userPhoneCountryIdHidden\").val(selectedCountryId);\r\n\t\t\t\tconsole.log('selectedPhoneCountryId for form:', $(\"#userPhoneCountryIdHidden\").val());\r\n\t\t\t}\r\n\t\t} else {\r\n\t\t\tconsole.log('setPhoneCountryIdToHiddenFieldUsingTomSelect() not ready, keep trying...');\r\n\t\t\tselectedPhoneCodeValueFromTsSelectIntervalCount++;\r\n\t\t\tif(selectedPhoneCodeValueFromTsSelectIntervalCount>10)\r\n\t\t\t\tclearInterval(getSelectedPhoneCodeValueFromTsSelectInterval);\r\n\t\t}\r\n\t}, 100);\r\n}\r\n\r\n\r\n\r\nfunction getPhoneCodeValueFromSelectedCountry(instanceId){\r\n\ttry{\r\n\t\tconst countryPhoneCodeTomSelectInstance = phoneCodeTomSelectInstances[instanceId];\r\n\t\tif(isNotBlank(countryPhoneCodeTomSelectInstance.getValue()))\r\n\t\t\treturn countryPhoneCodeTomSelectInstance.options[countryPhoneCodeTomSelectInstance.getValue()].phoneCode\r\n\t} catch (e){\r\n\t\tconsole.log(\"getPhoneCodeValueFromSelectedCountry() failed. InstanceId:\", instanceId, \" Error: \", e);\r\n\t}\r\n\treturn null;\r\n}\r\n\r\nfunction makePhoneCodeOptionDisabled(instanceId){\r\n\ttry{\r\n\t\tconst countryPhoneCodeTomSelectInstance = phoneCodeTomSelectInstances[instanceId];\r\n\t\tcountryPhoneCodeTomSelectInstance.disable();\r\n\t} catch (e){\r\n\t\tconsole.log(\"makePhoneCodeOptionDisabled() failed. InstanceId:\", instanceId, \" Error: \", e);\r\n\t}\r\n\treturn null;\r\n}"
          },
