          "content": {
            "size": 25058,
            "mimeType": "application/javascript",
            "text": "\nvar showTutorCountWithSubjectSearch=false;var URL_POST_REQ_COMMON={GET_SUGGESTED_SUBJECT_FROM_DESCRIPTION:URL_PREFIX_API_USER+\"/get-suggested-subject-from-description\",VALIDATE_AND_SAVE_SUBJECT_BY_USER:URL_PREFIX_API_USER+\"/validate-save-subject\",SUBJECT_SEARCH_AJAX:URL_PREFIX_API+\"/subject-search\",LOGIN:getAppContext()+'login.html',EVALUATE_LEVEL_REQUIRED_FROM_SUBJECTS:URL_PREFIX_API_USER+\"/evaluate-level-required-from-subjects\"};subjectSearchCallingFlow=\"JOB_POST\";function correctCommonSpellingsAndSynonyms(str){str=str.toLowerCase();str=str.replaceAll(\"educator\",\"tutor\");str=str.replaceAll(\"teachor\",\"tutor\");str=str.replaceAll(\"tuitor\",\"tutor\");str=str.replaceAll(\"tuter\",\"tutor\");str=str.replaceAll(\"teacher\",\"tutor\");str=str.replaceAll(\"trainer\",\"tutor\");str=str.replaceAll(\"turor\",\"tutor\");str=str.replaceAll(\"expert\",\"tutor\");str=str.replaceAll(\"instructor\",\"tutor\");str=str.replaceAll(\"faculty\",\"tutor\");str=str.replaceAll(\"coaching\",\"tuition\");str=str.replaceAll(\"tution\",\"tuition\");str=str.replaceAll(\"tutuion\",\"tuition\");str=str.replaceAll(\"tuitionjob\",\"tuition job\");str=str.replaceAll(\" nees \",\" need \");str=str.replaceAll(\"privet\",\"private\");str=str.replaceAll(\"creator\",\"tutor\");return str;}\nvar readDescAndFindSubjectsCommon=function(){var titleSummary=$('#title').val();var description=$('#description').val();$('#description').val(description);var s=\"\";if(isNotBlank(titleSummary)){s+=\" \"+titleSummary;}\nif(isNotBlank(description)){s+=\" \"+description;}\nmatchSubjectFromDescAndAdd(s);};function replaceSubjectNameWithStringSubjectName(desc){var matchedSubjects=findMatchingSubjectFromDesc(desc);for(var i=0;i<matchedSubjects.length;i++){try{var regEx=new RegExp(matchedSubjects[i],\"ig\");desc=desc.replace(regEx,\"subjectName\");}\ncatch(err){}}\nreturn desc;};var addedSubjectInSuggestionIds=[];function findMatchingSubjectFromDesc(desc){desc=prepareTextForSubjectExtraction(desc);if(isNotBlank(desc)){var form_data=new FormData();form_data.append(\"desc\",desc);$.ajax({type:\"POST\",url:URL_POST_REQ_COMMON.GET_SUGGESTED_SUBJECT_FROM_DESCRIPTION,data:form_data,cache:false,processData:false,contentType:false,timeout:2000,error:function(jqXHR,textStatus,errorMessage){},success:function(data){var obj=JSON.parse(data);if(obj.status=='SUCCESS'){try{if(obj.size>0){showAllSuggestedSubjects(obj.subjectList);}}catch(e){console.log(e);}\ntry{if(isNotBlank(searchedSessionSubjectJson)){var obj=JSON.parse(searchedSessionSubjectJson);showAllSuggestedSubjects(obj);}}catch(e){console.log(e);}}}});}};var showAllSuggestedSubjects=function(obj){try{var addedSubjectsInSuggestions=false;for(var i=0;i<obj.length;i++){var subObj=obj[i];if(addedSubjectInSuggestionIds.indexOf(subObj.id)==-1&&!isSubjectAlreadyAdded(subObj.id)){addedSubjectsInSuggestions=true;addedSubjectInSuggestionIds.push(subObj.id);var newOption={value:subObj.id,label:subObj.name,};try{subjectSearchTomSelect.addOption(newOption);}catch(e){console.log('unable to add suggested subjects. Error: ',e);}}else{}}\nvar newOption={value:0,label:\"Type to find more subjects\",disabled:true,customClass:'dropdown-header'};try{subjectSearchTomSelect.addOption(newOption);}catch(e){console.log('Unable to add suggested subjects, Error: ',e);}}catch(e){console.log(e);}};var addSuggestedSubject=function(subjectName,id,liId){try{if(!isSubjectAlreadyAdded(id)){var newOption=new Option(subjectName,id,true,true);$('#subjectIds').append(newOption).trigger('change');}}catch(e){console.log(e);}\n$('#'+liId).remove();if($('ul.clsAppendSuggestedSubject li').length==0){$('#suggestedSubjectsDiv').hide();}};var matchSubjectFromDescAndAdd=function(desc){findMatchingSubjectFromDesc(desc);};var isSubjectAlreadyAdded=function(subjectId){var isSubjectAlreadyAdded=false;try{var subjectIdArray=$('#subjectIds').val();if(isNotBlank(subjectIdArray)&&subjectIdArray.length>0){for(i=0;i<subjectIdArray.length;i++){if(subjectIdArray[i]==subjectId){isSubjectAlreadyAdded=true;break;}}}}catch(e){console.log(e);}\nreturn isSubjectAlreadyAdded;};var prepareGetTutorFromDropdown=function(){var countryName=$('#countryName').val();var optionTxt='';optionTxt+='<option value=\"\">-- Select --</option>';optionTxt+='<option value=\"Any\">All countries</option>';optionTxt+='<option value=\"MyCountry\">'+countryName+' (Medium to high prices)</option>';if(!isPoor)\noptionTxt+='<option value=\"Developing\">Developing countries (Low to medium prices)</option>';return optionTxt;};var showOrHideGetTutorFromOption=function(){var cbxOnlineTutoring=$(\"input[name='cbxOnlineTutoring']\").is(':checked');var isPublicStudent=$('#isPublicStudent').val();if(cbxOnlineTutoring&&(isAdminOrAgent||(isNotBlank(isPublicStudent)&&isPublicStudent==1))){$('#getTutorFrom').html(prepareGetTutorFromDropdown());$('#tutorCountryOptionDiv').show();}else{$('#getTutorFrom').html('<option value=\"\">-- Select --</option>');$('#tutorCountryOptionDiv').hide();}};var showOrHideLoaderImageAndBtnForAddNewSubject=function(showBtn){if(showBtn){$('.clsAddNewSubject').show();$('#imgLoaderAddNewSubject').hide();}else{$('.clsAddNewSubject').hide();$('#imgLoaderAddNewSubject').show();}};var validateFileExtension=function(file){$('.clsUploadError').hide();var ext=file.split(\".\");try{if(ext.length>=2){ext=ext[ext.length-1].toLowerCase();if(uploadFilesExtNotAllowed.lastIndexOf(ext)>=0){$('#divQue').append('<div style=\"display: block;\" class=\"clsUploadError alert alert-danger-light\">'+ext+' file extension not allowed.</div>');return false;}else{$('.clsUploadError').hide();}\nreturn true;}else{$('#divQue').append('<div style=\"display: block;\" class=\"clsUploadError alert alert-danger-light\">Please upload a valid file with extension.</div>');return false;}}catch(e){return true;}};var getSelectedSubjectIds=function(){var subjectIdCsv='';try{var subjectIdArray=$('#subjectIds').val();if(isNotBlank(subjectIdArray)&&subjectIdArray.length>0){for(i=0;i<subjectIdArray.length;i++){if(subjectIdCsv==''){subjectIdCsv=subjectIdArray[i];}else{subjectIdCsv=subjectIdCsv+\",\"+subjectIdArray[i];}}}}catch(e){console.log('Error: ',e);}\nreturn subjectIdCsv;};var saveNewSubjectByUser=function(){var subjectName_add=$('#subjectName_add').val();if(subjectName_add==null||Trim(subjectName_add)==\"\"||subjectName_add==undefined){$('#reqSubjectNameToAddError').show();return false;}\n$('#reqSubjectNameToAddError').hide();var newSubjectObject={subjectName:subjectName_add};$.ajax({url:URL_POST_REQ_COMMON.VALIDATE_AND_SAVE_SUBJECT_BY_USER,type:'POST',data:JSON.stringify(newSubjectObject),dataType:'json',contentType:\"application/json;charset=utf-8\",beforeSend:function(){showOrHideLoaderImageAndBtnForAddNewSubject(false);},success:function(data){var obj=data;if(obj.status=='ERROR'){if(isNotBlank(obj.action)&&obj.action=='LABEL'){showOrHideLoaderImageAndBtnForAddNewSubject(true);alert('This is not a valid subject. If you think it is. Please contact us.');return false;}else{showOrHideLoaderImageAndBtnForAddNewSubject(true);alert(obj.ERROR_MSG);$('#subjectName_add').val('');return false;}}else if(obj.status=='SUCCESS'){var subId=obj.subjectId;var subName=obj.subjectName;if($('#subjectIds').find(\"option[value='\"+subId+\"']\").length){console.log('-- subjects already exists --- ');}else{var newOption={value:subId,label:subName};try{subjectSearchTomSelect.addOption(newOption);subjectSearchTomSelect.addItem(subId);}catch(e){console.log(\"Failed to add new subjects. Error: \",e);}}\nhideSubjectAddForm();}},error:function(e){showOrHideLoaderImageAndBtnForAddNewSubject(true);alert(ERROR_MSG.AJAX_FAILED_MSG);}});};var setValueToTheContactLogs=function(txt){try{var sharedContactLog=$('#sharedContactLog').val();if(isNotBlank(sharedContactLog)){sharedContactLog=sharedContactLog+'<br/>'+txt;}else{sharedContactLog=txt;}\n$('#sharedContactLog').val(sharedContactLog);}catch(e){console.log('setValueToTheContactLogs(): ',e);}};new TomSelect(\"#interactionLanguageCsv\",{maxItems:5,onItemAdd:function(value,item){this.setTextboxValue('');this.refreshOptions(false);},plugins:['remove_button','caret_position','input_autogrow'],});var isNameHasWordAdmin=function(name){if(isNotBlank(name)){var nameArr=name.split(\" \");for(var j=0;j<nameArr.length;j++){if(nameArr[j].toLowerCase()=='admin'){return true;}}}\nreturn false;}\nvar evaluateLevelRequiredFromCustomLevel=function(subjectIds){if(isBlank(subjectIds)){destroyTomSelectForLevel('levelId');initTomSelectForLevel();$(\".clsJobLevel\").show();return;}\n$.ajax({type:\"GET\",url:URL_POST_REQ_COMMON.EVALUATE_LEVEL_REQUIRED_FROM_SUBJECTS+\"?subjectIds=\"+subjectIds+\"&callingFlow=JOB_POST\",cache:false,beforeSend:function(){},error:function(jqXHR,textStatus,errorMessage){$.miniNoty(\"Evaluating Level Required: \"+ERROR_MSG.AJAX_FAILED_MSG,'error');},success:function(obj){console.log(obj);var showLevelDropdown=true;var minLevelSequence=0,maxLevelSequence=0,levelGroupName=0;if(obj.status=='SUCCESS'){if(obj.levelRequiredFromUser){if(isNotBlank(obj.minSearchSequence)&&isNotBlank(obj.maxSearchSequence)&&isNotBlank(obj.levelGroupName)){minLevelSequence=obj.minSearchSequence;maxLevelSequence=obj.maxSearchSequence;levelGroupName=obj.levelGroupName;}}else{showLevelDropdown=false;}}\nif(showLevelDropdown){$(\".clsJobLevel\").show();}else{$(\".clsJobLevel\").hide();}\ndestroyTomSelectForLevel('levelId');initTomSelectForLevel(minLevelSequence,maxLevelSequence,levelGroupName);},complete:function(){}});}\nvar prepareSubjectCsv=function(sId){var subjectIds=$(\"#subjectIds\").val();if(isNotBlank(sId)){if(isBlank(subjectIds))\nsubjectIds=sId;else\nsubjectIds=subjectIds+\",\"+sId;}\nreturn subjectIds;}\nvar waitForSubjectTomSelectToReady=function(){if(typeof subjectSearchTomSelect!=='undefined'){subjectSearchTomSelect.on('item_add',function(value,item){console.log(\"Subject added....\"+prepareSubjectCsv(value));evaluateLevelRequiredFromCustomLevel(prepareSubjectCsv(value));});subjectSearchTom