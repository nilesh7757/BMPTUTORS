          "content": {
            "size": 30422,
            "mimeType": "application/javascript",
            "text": "\nvar URL_VIEW_CONTACT_DETAILS=URL_PREFIX_API_USER+\"/viewContactDtl\";var VIEW_TUTOR_CONTACT_DTL=URL_PREFIX_API_USER+\"/viewTutorContactDtl\";var SHOW_CONTACT_SETTINGS_URL=MODULE_TEACHER+\"/showContactSettings\";var showStudentContactDetails=function(jobIdEnc){$.ajax({url:URL_VIEW_CONTACT_DETAILS,type:'GET',data:'jobCode='+jobIdEnc,cache:false,dataType:'json',success:function(resObj){if(resObj.status=='SUCCESS'&&resObj.action=='SHOW_APPLY_JOB_BTN'){showMessageBoxViewContact();}else{processAndShowStudentContacts(resObj)}},error:function(e){alert('Something went wrong while fetching contact details..');}});};var processAndShowStudentContacts=function(resData){var modalTitle='Student Contact Details';var modalBodyMsg='';var resObject=resData;if(resObject.status=='success'){modalBodyMsg=modalBodyMsg+'<div class=\"headline\"><h4>'+resObject.userName+'</h4></div>';for(var i=0;i<resObject.contactDetailModelList.length;i++){var phoneObj=resObject.contactDetailModelList[i];if(phoneObj.type=='email'){modalBodyMsg=modalBodyMsg+'Email: '+phoneObj.value+'<br/>';}else if(phoneObj.type=='phone'){modalBodyMsg=modalBodyMsg+'<i class=\"fas fa-mobile-alt\"></i> &nbsp;'+phoneObj.value+'<br/>';}else if(phoneObj.type=='noPhoneVerified'){modalBodyMsg=modalBodyMsg+''+phoneObj.value+'<br/>';}}\nmodalBodyMsg+=\"<hr style='margin: 20px 0;'/> <div class='text-center'><a class='btn btn-primary' href='https://www.teacheron.com/get-paid' target='_blank'>Get paid</a></div>\";}else if(resObject.status=='error'){if(isNotBlank(resObject.errorMsg)){modalTitle='Error occurred';modalBodyMsg=resObject.errorMsg;}else{alert('Error!! Something went wrong while process contact request.');}}\nvar contactDtlModel='';contactDtlModel=contactDtlModel+'<div class=\"modal small fade\" id=\"stdContactDtlId\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">';contactDtlModel=contactDtlModel+'<div class=\"modal-dialog modal-sm\">';contactDtlModel=contactDtlModel+'<div class=\"modal-content\">';contactDtlModel=contactDtlModel+'<div class=\"modal-header\">';contactDtlModel=contactDtlModel+'<button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>';contactDtlModel=contactDtlModel+modalBodyMsg;contactDtlModel=contactDtlModel+'</div>';contactDtlModel=contactDtlModel+' </div>';contactDtlModel=contactDtlModel+' </div>';contactDtlModel=contactDtlModel+' </div>';$('#contactDtlModelDiv').html(contactDtlModel);$('#stdContactDtlId').modal('show');};var showTutorContactDetails=function(msgThreadId){$.ajax({url:VIEW_TUTOR_CONTACT_DTL,type:'GET',data:'mThread='+msgThreadId,cache:false,dataType:'json',success:function(resObj){processAndShowTutorContacts(resObj);},error:function(e){alert('Something went wrong while fetching contact details..');}});};var processAndShowTutorContacts=function(resObject){var modalTitle='Tutor Contact Details';var modalBodyMsg='';if(resObject.status=='success'){displayTutorContactInfoModal(resObject.tutorContactMainJsonList,resObject.tutorFirstName,false,false);}else{if(resObject.status=='ERROR'){if(isNotBlank(resObject.action)&&resObject.action=='requiredLogin'){var loginUrl=getAppContext()+'login.html';modalBodyMsg=\"Required login, <a href='\"+loginUrl+\"'>Click here to login first</a>\";}else{modalBodyMsg=resObject.ERROR_MSG;}}else if(resObject.status=='NO_ACCESS'){modalBodyMsg=\"You don't have permission to view contacts.\";}\nif(isBlank(modalBodyMsg))\nmodalBodyMsg=ERROR_MSG.COMMON_ERROR_MSG;var contactDtlModel='';contactDtlModel=contactDtlModel+'<div class=\"modal small fade\" id=\"stdContactDtlId\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">';contactDtlModel=contactDtlModel+'<div class=\"modal-dialog modal-sm\">';contactDtlModel=contactDtlModel+'<div class=\"modal-content\">';contactDtlModel=contactDtlModel+'<div class=\"modal-header\">';contactDtlModel=contactDtlModel+'<button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>';contactDtlModel=contactDtlModel+modalBodyMsg;contactDtlModel=contactDtlModel+'</div>';contactDtlModel=contactDtlModel+' </div>';contactDtlModel=contactDtlModel+' </div>';contactDtlModel=contactDtlModel+' </div>';$('#tutorContactDetailCommonDiv').html(contactDtlModel);$('#stdContactDtlId').modal({backdrop:'static',keyboard:false});}};var displayTutorContactInfoModal=function(tutorContactMainJsonList,tutorFirstName,reloadPageOnClose,showManageSetting){var title='<span class=\"color-blue\">Contact '+tutorFirstName+'</span>';var contactDetails='<div class=\"text-center\"><ul class=\"list-unstyled who margin-bottom-30 text-left display-inline-block\">';for(var i=0;i<tutorContactMainJsonList.length;i++){var innerObj=tutorContactMainJsonList[i];contactDetails=parseContactDetails(contactDetails,innerObj.type,innerObj.otherTypeLabel,innerObj.value,innerObj.icon)}\ncontactDetails=contactDetails+\"</ul></div>\";contactDetails=contactDetails+'<div class=\"text-center\">';if(showManageSetting){contactDetails=contactDetails+'<a class=\"btn btn-u rounded margin-bottom-20\" href=\"'+SHOW_CONTACT_SETTINGS_URL+'\">Manage contact details settings</a>';contactDetails=contactDetails+'<br/><a href=\"javascript:void(0);\" onclick=\"closeStudentPhoneVerifyModal('+reloadPageOnClose+');\">Close</a>';}else{contactDetails=contactDetails+'<button type=\"button\" onclick=\"closeStudentPhoneVerifyModal('+reloadPageOnClose+');\" class=\"btn btn-u\">Close</button>';contactDetails+=\"<hr style='margin: 20px 0;'/><button data-dismiss='modal' class='btn-u btn-u-purple rounded clsPayToTutorFromDynContactModal' href='https://teacheron.com/pay-teachers'>Pay now</button>\";contactDetails+=\"<div class='margin-top-10'><a href='https://teacheron.com/pay-teachers' target='_blank'>Learn more</a></div>\";}\ncontactDetails=contactDetails+'</div>';showTutorProfileDynamicModal(title,contactDetails);};var closeStudentPhoneVerifyModal=function(reloadPageOnClose){if(reloadPageOnClose){window.location.reload();}else{$('#tContactModal').modal('hide');}};var parseContactDetails=function(mainData,type,otherTypeLabel,value,fa_icon){var data='';if(isNotBlank(fa_icon))\ndata=data+'<li><i class=\"'+fa_icon+' margin-right-10\"></i>';if(isNotBlank(otherTypeLabel)){data=data+otherTypeLabel+' - ';}\ndata=data+value+'</li>';mainData=mainData+data;return mainData;};var showTutorProfileDynamicModal=function(title,contactDetails){var tContact='';tContact=tContact+'<div class=\"modal fade autoWidthModal wordBreak\" id=\"tContactModal\"  tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">';tContact=tContact+'<div class=\"modal-dialog\" style=\"\">';tContact=tContact+'<div class=\"modal-content\">';tContact=tContact+'<div class=\"modal-header\">';tContact=tContact+'<button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>';tContact=tContact+'<h3 class=\"modal-title text-center\" id=\"commonMsgModalTitle\">'+title+'</h3>';tContact=tContact+'</div>';tContact=tContact+'<div class=\"modal-body\">';tContact=tContact+'<span id=\"commonMsgModalMsgBody\">'+contactDetails+'</span>';tContact=tContact+'</div>';tContact=tContact+'</div>';tContact=tContact+'</div>';tContact=tContact+'</div>';$('#tutorContactDetailCommonDiv').html(tContact);$('#tContactModal').modal({backdrop:'static',keyboard:false});};var checkStudentPhoneAndShowDirectly=function(jobIdEnc){$.ajax({url:URL_VIEW_CONTACT_DETAILS,type:'GET',data:'jobCode='+jobIdEnc,cache:false,success:function(resData){if(resData=='SHOW_APPLY_JOB_BTN'){}else{var resObject=JSON.parse(resData);var studentPhoneNumber='';if(resObject.status=='success'){for(var i=0;i<resObject.contactDetailModelList.length;i++){var phoneObj=resObject.contactDetailModelList[i];if(phoneObj.type=='phone'){if(isNotBlank(studentPhoneNumber))\nstudentPhoneNumber+='<br/>';studentPhoneNumber+='<i class=\"fas fa-mobile-alt\"></i> &nbsp;'+phoneObj.value;}}\nif(isNotBlank(studentPhoneNumber)){$(\"#studentNameDisplayDirect\").html(resObject.userName);$(\"#studentPhoneNumberDisplayDirect\").html(studentPhoneNumber);openModalCommon('studentPhoneDisplayDirectModal');}}}},error:function(e){alert('Something went wrong while fetching contact details..');}});}\n\nvar PAY_URL={PAY_TUTOR_OPTION:URL_PREFIX_API_USER+\"/pay-tutor-option\",VALIDATE_PAY_TUTOR:URL_PREFIX_API_USER+\"/validatePayTutor\",PAY_TUTOR:MODULE_USER+\"/payTutor\",RECEIVE_PAYPAL_PAYMENT_TUTOR_PAY:MODULE_USER+\"/receivePaypalPaymentTutorPay\",PAYMENT_BREAKUP_AMT_WISE:URL_PREFIX_API_STUDENT+\"/paymentBreakupAmtWise\",VALIDATE_MIN_AMT_FOR_TUTOR_PAY:URL_PREFIX_API_USER+\"/validateMinAmtForTutorPay\",TRANSFER_COINS_TO_TUTOR:URL_PREFIX_API_STUDENT+\"/transferCoinsToTutor\",PAYMENTS:MODULE_USER+\"/payments\",VALIDATE_MIN_COINS_FOR_TUTOR_PAY:URL_PREFIX_API_USER+\"/validateMinCoinsForTutorPay\",REGISTER_AS_CLIENT:MODULE_USER+\"/registerAsClient\",};var enterAmtError='Please enter a valid amount.';var TRANSFER_FLOW_MONEY='MONEY';var TRANSFER_FLOW_COINS='COINS';var commonPayFormMessageDivId='commonPayFormMessage';var payTutorDirect=function(tid,payFlow){payTutor(tid,'',payFlow);};var payTutorMsgThread=function(tid,mThreadId,payFlow){payTutor(tid,mThreadId,payFlow);};var payTutor=function(tid,mThreadId,payFlow){var urlToPost=PAY_URL.PAY_TUTOR_OPTION+'?tid='+tid;if(isNotBlank(mThreadId)){urlToPost=urlToPost+'&mThreadId='+mThreadId;}\nif(isNotBlank(payFlow))\nurlToPost=urlToPost+'&payFlow='+payFlow;$.ajax({url:urlToPost,type:'GET',cache:false,success:function(resData){var resObj=resData;var title='';var msgBody='';var initSelect2Currency=false;var payFlowFromResponse='';if(isNotBlank(resObj.payFlow)){payFlowFromResponse=resObj.payFlow;}\nif(resObj.status=='SUCCESS'){if(isNotBlank(resObj.PAYMENT_OR_COINS_BUTTON)&&resObj.PAYMENT_OR_COINS_BUTTON=='Y'){title='How do you want to pay?';msgBody+='<a type=\"button\" onclick=\"payTutor(\\''+tid+'\\',\\''+mThreadId+'\\',\\''+TRANSFER_FLOW_COINS+'\\');\" class=\"btn-u btn-u-blue btn-block btn-u-dark-sea\">Pay coins</a>';msgBody+='<a type=\"button\" onclick=\"payTutor(\\''+tid+'\\',\\''+mThreadId+'\\',\\''+TRANSFER_FLOW_MONEY+'\\');\" class=\"btn-u btn-u-blue btn-block \">Pay money</a>';}else{if(resObj.PAYOUT_ADDED=='N'){title='Tutor\\'s bank details required';msgBody='Please ask the tutor to add bank details (in settings) to receive payments.<br/>';msgBody=msgBody+'<div class=\"text-center\"><a class=\"btn-u btn-u-blue rounded text-center margin-top-20\" onclick=\"hidePaymentScreen();\" href=\"javascript:void(0);\">Close</a></div>';}else if(resObj.PAYOUT_ADDED=='Y'){initSelect2Currency=true;title='Pay tutor';var isMoneyTransferFlow=isBlank(payFlowFromResponse)||payFlowFromResponse==TRANSFER_FLOW_MONEY;msgBody=createPaymentForm(resObj.supportedCurrencyList,mThreadId,tid,isMoneyTransferFlow);showPaymentBreakUpAmountWise(0,isMoneyTransferFlow);}else{alert(\"Error: could not find payout flag.\");return false;}}\nshowPaymentScreen(title,msgBody);if(initSelect2Currency&&isNotBlank(resObj.supportedCurrencyList)){initSelect2ForPayTutorCurrency(resObj.supportedCurrencyList);}}else if(resObj.status=='ERROR'){if(isNotBlank(resObj.action)&&resObj.action=='reqLogin'){$('#contactFlowByAjaxError').html('<i class=\"fas fa-exclamation-triangle\"></i> '+resObj.ERROR_MSG);$('#contactFlowByAjaxError').show();}else if(isNotBlank(resObj.action)&&resObj.action=='CANNOT_PAY_TO_OWN_ACCOUNT'){$('#contactFlowByAjaxError').html('<i class=\"fas fa-exclamation-triangle\"></i> You can\\'t pay yourself.');$('#contactFlowByAjaxError').show();}else{alert(ERROR_MSG.COMMON_ERROR_MSG);}}else if(isNotBlank(resObj.action)&&resObj.action=='NO_ACCESS'){var errorMsg=\"Only students can pay tutors.<br>\";errorMsg+=\"<a class=\\\"btn btn-u rounded color-white\\\" href='\"+PAY_URL.REGISTER_AS_CLIENT+\"'>Open student account</a>\";$('#contactFlowByAjaxError').html(errorMsg);$('#contactFlowByAjaxError').show();$('#contactTutorBtnDiv').hide();}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);}});};var initSelect2ForPayTutorCurrency=function(supportedCurrencyList){var currencyHtmlData=[];if(supportedCurrencyList.length>=2){tempCurrencyObj={id:'',text:''};currencyHtmlData.push(tempCurrencyObj);}\nfor(var i=0;i<supportedCurrencyList.length;i++){var currencyCode=supportedCurrencyList[i].currencyCode;var currencyName=supportedCurrencyList[i].currencyName;tempCurrencyObj={id:currencyCode,text:currencyCode+' <small>('+currencyName+')</small>'};currencyHtmlData.push(tempCurrencyObj);}\n$(\".cls-select2-currency\").select2({data:currencyHtmlData,escapeMarkup:function(markup){return markup;},templateResult:function(data){return data.text;},templateSelection:function(data){return data.text;},placeholder:'-- Select Currency --',\"language\":{\"noResults\":function(){var addText='Add \"'+$('.select2-search__field').val()+'\"';return'<span class=\"alert alert-danger-light\">'+$('.select2-search__field').val()+\" not found </span>\";}},val:''});$('.select2-selection__rendered').hover(function(){$(this).removeAttr('title');});};var showPaymentBreakUpAmountWise=function(amount,isMoneyTransfer){if(isBlank(amount))\namount=0;var urlToPost=PAY_URL.PAYMENT_BREAKUP_AMT_WISE+'?amtOrCoins='+amount+'&isMoneyTransfer='+isMoneyTransfer;var currency=$('#payTutorCurrency').val();if(amount==0&&isBlank(currency))\n{currency=\"INR\";}\nif(isNotBlank(currency)){urlToPost+='&currencyCode='+currency;}else{urlToPost+='&currencyCode=INR';}\n$.ajax({url:urlToPost,type:'GET',cache:false,success:function(resData){var resObj=JSON.parse(resData);if(resObj.status=='SUCCESS'){$('#paymentBreakups').html(resObj.PAYOUT_TABLE);}else{$('#paymentBreakups').html(ERROR_MSG.COMMON_ERROR_MSG);}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);}});};var getPayTutorCurrency=function(){return $('#payTutorCurrency').val();};var getPayTutorReleasePaymentType=function(){return $('#payTutorReleasePaymentOption').val();};var getPayTutorAmount=function(){return $('#payTutorAmount').val();};var getPayTutorCoins=function(){return $('#paymentInCoins').val();};var getTutorUserIdEncry=function(){return $('#payTutorTid').val();};var validateFieldsAndMinAmtForTransfer=function(skipCurrencyValidation){showPayTutorAmountError(false,'');var isMoneyTransfer=true;var amount=getPayTutorAmount();if(isBlank(amount)||amount==0){showPayTutorAmountError(true,enterAmtError);showPaymentBreakUpAmountWise(0,isMoneyTransfer);showPayTutorCurrencyError(false);return false;}\nif(skipCurrencyValidation&&isBlank(getPayTutorCurrency()))\nreturn false;var currency='';var isValidCurrency=validatePayTutorCurrency();if(!isValidCurrency){showPaymentBreakUpAmountWise(0,isMoneyTransfer);return false;}\nvar currency=getPayTutorCurrency();$.ajax({url:PAY_URL.VALIDATE_MIN_AMT_FOR_TUTOR_PAY+'?amt='+amount+'&currencyCode='+currency+'&tid='+getTutorUserIdEncry(),type:'GET',cache:false,success:function(resData){var resObj=JSON.parse(resData);if(resObj.status=='SUCCESS'){showPayTutorAmountError(false,'');var paymentAmt=getPayTutorAmount();showPaymentBreakUpAmountWise(paymentAmt,isMoneyTransfer);}else if(resObj.status=='ERROR'&&isNotBlank(resObj.ERROR_MSG)){showPayTutorAmountError(true,resObj.ERROR_MSG);showPaymentBreakUpAmountWise(0,isMoneyTransfer);}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);}});};var getMsgThreadIdStr=function(mThreadId){if(isNotBlank(mThreadId)){return'value=\"'+mThreadId+'\"';}else{return' ';}};var createPaymentForm=function(supportedCurrencyList,mThreadId,tid,isMoneyTransferFlow){var form='';form=form+'<form id=\"payTutorForm\" class=\"sky-form\" method=\"post\" action=\"javascript:void(0);\" novalidate=\"novalidate\">';form=form+'<input type=\"hidden\" name=\"billingAddressId\" id=\"billingAddressId\">';form=form+'<input type=\"hidden\" name=\"payTutorTid\" id=\"payTutorTid\" value=\"'+tid+'\" >';form=form+'<input type=\"hidden\" name=\"payTutorMsgThreadId\" id=\"payTutorMsgThreadId\" '+getMsgThreadIdStr(mThreadId)+'>';if(isMoneyTransferFlow){form+='<section class=\"text-right-\">';form+='<div>';form+='<div class=\"label display-inline-block float-left- padding-top-5\"><b>Pay </b> </div>';form+='<div class=\"display-inline-block float-right- margin-left-5\">';form+='<label class=\"input- \">';form+='<input type=\"text\" onkeyup=\"validatePayTutorAmount(false);\" maxlength=\"12\" autocomplete=\"off\" name=\"payTutorAmount\" placeholder=\"Amount\" id=\"payTutorAmount\" size=\"12\" class=\"form-control display-inline-block currency-only\" style=\"font-size:15px;  height:36px;\">';form+='</label>';form+='<select onchange=\"validateFieldsAndMinAmtForTransfer(false);\" name=\"payTutorCurrency\" id=\"payTutorCurrency\" class=\"form-control width-auto display-inline-block cls-select2-currency\" tabindex=\"-1\" style=\"vertical-align: top; width: auto;\">';form+='</select>';form+='</div>';form+='<div class=\"clear-both\"></div>';form+='<div class=\"text-right\">';form+='<div style=\"display:none; padding: 2px 5px; margin-bottom: 0px;\" id=\"requiredAmountError\" class=\"alert alert-danger-light\">'+enterAmtError+'</div>';form+='<label style=\"display: none; padding: 2px 5px; margin-bottom: 0px;\" id=\"requiredCurrencyError\" class=\"alert alert-danger-light\">Please select currency</label>';form+='</section>';}else{form+='<section class=\"text-right-\">';form+='<div>';form+='<div class=\"label display-inline-block float-left padding-top-5\"><b>Coins to transfer</b> </div>';form+='<div class=\"display-inline-block float-right- margin-left-5\">';form+='<label class=\"input- \">';form+='<input type=\"text\" onkeyup=\"validatePayTutorCoins();\" name=\"paymentInCoins\" id=\"paymentInCoins\"  maxlength=\"12\" autocomplete=\"off\" placeholder=\"Coins\" size=\"20\" class=\"form-control display-inline-block\" style=\"font-size:15px;  height:36px; max-width: 150px\">';form+='</label>';form+='</div>';form+='<div class=\"clear-both\"></div>';form+='<div class=\"text-right\">';form+='<div style=\"display:none; padding: 2px 5px; margin-bottom: 0px;\" id=\"coinErrorDiv\" class=\"text-left alert alert-danger-light\"></div>';form+='</section>';}\nform=form+'<section id=\"paymentBreakups\"></section>';form=form+'<section>';form+='<label class=\"label\">Schedule payment release <a href=\"#\" data-toggle-slide=\"#schedulePaymentHelp\"><i class=\"fas fa-question-circle\"></i></a></label>';form+='<div class=\"alert alert-info text-left\" id=\"schedulePaymentHelp\" style=\"display:none; max-width:369px;\">Please chose to release payment immediately if the services have been delivered. <br> If you are giving an advance, then chose to release later.</div>';form=form+'<label class=\"select state-success\">';form=form+'<select onchange=\"showCbxPayImmediately(this.value);validatePayTutorReleasePayment();\" name=\"payTutorReleasePaymentOption\" id=\"payTutorReleasePaymentOption\" class=\"valid form-control\">';form=form+'<option value=\"\"> Please select </option>';form=form+'<option value=\"RELEASE_PAYMENT_ON_WORK_DONE\">Release later</option>';form=form+'<option value=\"RELEASE_PAYMENT_IMMEDIATELY\">Release immediately</option>';form=form+'</select>';form=form+'<i></i>';form=form+'</label>';form=form+'<label style=\"display: none\" id=\"requiredReleasePayment\" class=\"label alert alert-danger-light\">Please select release payment option</label>';form=form+'</section>';form=form+'<section class=\"text-left\" id=\"secPayImmediately\" style=\"display: none\">';form+='<label class=\"checkbox\">';form+='<input type=\"checkbox\" onclick=\"validateReleasePaymentCbx();\" name=\"cbxPayImmediately\" id=\"cbxPayImmediately\"><i></i>I have received the services satisfactorily';form+='</label>';form+='<label id=\"errorCbxPayImmediately\" class=\"label alert alert-danger-light\" style=\"display: none\">Please confirm that you have received the services.</label>';form=form+'</section>';form=form+'<section class=\"text-left\">';form+='<label class=\"checkbox\">';form+='<input type=\"checkbox\" onclick=\"validateTermsAndCondition();\" name=\"cbxTermsAndConditions\" id=\"cbxTermsAndConditions\"><i></i> I have read the <a target=\"_blank\" href=\"https://www.teacheron.com/refund-policy#refundFromTutorsThroughUs\"> terms</a>';form+='</label>';form+='<label id=\"errorCbxTermsAndConditions\" class=\"label alert alert-danger-light\" style=\"display: none\">Please confirm you have read the terms.</label>';form=form+'</section>';form=form+'<section>';form=form+'<button id=\"btnPayNow\" type=\"button\" onclick=\"processPayButton('+isMoneyTransferFlow+');\" class=\"btn-u btn-block rounded\">Pay now</button>';form+='<img id=\"imgLoaderForPayNow\" style=\"display: none;\" src=\"'+T_CONSTANTS.IMG_LOADER_SMALL_PATH+'\">';form=form+'</section>';form+='<div id=\"commonPayFormMessage\"></div>';form=form+'</form>';return form;};var processPayButton=function(isMoneyTransferFlow){if(isMoneyTransferFlow){submitPayTutorForm();}else{submitPayInCoinsForm();}};function submitFormFromBillingAddress(){document.getElementById('payTutorForm').action=PAY_URL.PAY_TUTOR;document.getElementById('payTutorForm').submit();};var validatePayTutorCurrency=function(){var paymentCurrency=getPayTutorCurrency();if(isBlank(paymentCurrency)){showPayTutorCurrencyError(true);return false;}else{showPayTutorCurrencyError(false);return true;}};var validatePayTutorReleasePayment=function(){var releaseOption=getPayTutorReleasePaymentType();if(isBlank(releaseOption)){showPayTutorReleasePaymentError(true);return false;}else{showPayTutorReleasePaymentError(false);return true;}};var showCbxPayImmediately=function(val){$(\"#cbxPayImmediately\").prop(\"checked\",false);if(isNotBlank(val)&&val=='RELEASE_PAYMENT_IMMEDIATELY'){$('#secPayImmediately').show();}else{$('#secPayImmediately').hide();}};var validateTermsAndCondition=function(){var isTermsAndConditionChecked=$(\"#cbxTermsAndConditions\").is(':checked');if(isTermsAndConditionChecked){$('#errorCbxTermsAndConditions').hide();return true;}else{$('#errorCbxTermsAndConditions').show();return false;}};var validateReleasePaymentCbx=function(){var isValidPaymentReleasedCbx=true;var releasePaymentOption=getPayTutorReleasePaymentType();if(isNotBlank(releasePaymentOption)&&releasePaymentOption=='RELEASE_PAYMENT_IMMEDIATELY'){isValidPaymentReleasedCbx=$(\"#cbxPayImmediately\").is(':checked');if(isValidPaymentReleasedCbx){$('#errorCbxPayImmediately').hide();}else{$('#errorCbxPayImmediately').show();}}else{$('#errorCbxPayImmediately').hide();}\nreturn isValidPaymentReleasedCbx;};var validatePayTutorAmount=function(showErrorToEnterAmt){var oldval=getPayTutorAmount();var isMoneyTransfer=true;if(isBlank(oldval)){if(showErrorToEnterAmt){showPayTutorAmountError(true,enterAmtError);}\nshowPaymentBreakUpAmountWise(0,isMoneyTransfer);return false;}else{showPayTutorAmountError(false,'');validateFieldsAndMinAmtForTransfer(true);return true;}};var showPayTutorCurrencyError=function(isShow){if(isShow){$('#requiredCurrencyError').show().addClass(\"display-inline-block\");}else{$('#requiredCurrencyError').hide().removeClass(\"display-inline-block\");}};var showPayTutorAmountError=function(isShow,errorMsg){if(isShow){$('#requiredAmountError').html(errorMsg);$('#requiredAmountError').show().addClass(\"display-inline-block\");}else{$('#requiredAmountError').html('');$('#requiredAmountError').hide().removeClass(\"display-inline-block\");}};var showPayTutorCoinsError=function(isShow,errorMsg){if(isShow){$('#coinErrorDiv').html(errorMsg);$('#coinErrorDiv').show().addClass(\"display-inline-block\");}else{$('#coinErrorDiv').html('');$('#coinErrorDiv').hide().removeClass(\"display-inline-block\");}};var showPayTutorReleasePaymentError=function(isShow){if(isShow){$('#requiredReleasePayment').show();}else{$('#requiredReleasePayment').hide();}};var submitPayTutorForm=function(){var payTutorCurrency=getPayTutorCurrency();var payTutorAmount=getPayTutorAmount();var releasePaymentOption=getPayTutorReleasePaymentType();var cbxPayImmediately=$(\"#cbxPayImmediately\").is(':checked');var cbxTermsAndConditions=$(\"#cbxTermsAndConditions\").is(':checked');var isValidCurrency=false;var isValidAmount=false;var paymentAmtVal=getPayTutorAmount();if(isBlank(paymentAmtVal)){isValidAmount=false;showPayTutorAmountError(true,enterAmtError);}else{isValidAmount=true;}\nif(isValidAmount&&validatePayTutorCurrency()){isValidCurrency=true;}\nvar isValidReleasePayment=validatePayTutorReleasePayment();var isValidPaymentReleasedCbx=validateReleasePaymentCbx();var isTermsAndConditionChecked=validateTermsAndCondition();var urlValidatePayTutor=PAY_URL.VALIDATE_PAY_TUTOR+\"?currency=\"+payTutorCurrency+\"&amount=\"+payTutorAmount+'&releasePaymentOption='+releasePaymentOption;urlValidatePayTutor+=\"&cbxPayImmediately=\"+cbxPayImmediately+\"&cbxTermsAndConditions=\"+cbxTermsAndConditions+'&tid='+getTutorUserIdEncry();if(isValidCurrency&&isValidAmount&&isValidReleasePayment&&isTermsAndConditionChecked&&isValidPaymentReleasedCbx){$.ajax({url:urlValidatePayTutor,type:'POST',cache:false,success:function(obj){if(obj.status=='SUCCESS'){closeModalCommon('tutorPayModal');askForBillingAddress();}else{if(isNotBlank(obj.req_currency)){showPayTutorCurrencyError(true);}\nif(isNotBlank(obj.req_amount)){showPayTutorAmountError(true,enterAmtError);}\nif(isNotBlank(obj.req_min_amount)){showPayTutorAmountError(true,obj.req_min_amount);}\nif(isNotBlank(obj.req_release_payment)){showPayTutorReleasePaymentError(true);}\nif(isNotBlank(obj.req_cbxPayImmediately)){$('#errorCbxPayImmediately').show();}\nif(isNotBlank(obj.req_cbxTermsAndConditions)){$('#errorCbxTermsAndConditions').show();}}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);}});}};var showPaymentScreen=function(title,messageBody){var tContact='';tContact=tContact+'<div class=\"modal fade autoWidthModal wordBreak\" id=\"tutorPayModal\"  role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">';tContact=tContact+'<div class=\"modal-dialog\" >';tContact=tContact+'<div class=\"modal-content \">';tContact=tContact+'<div class=\"modal-header\">';tContact=tContact+'<button type=\"button\" class=\"close\" onclick=\"hidePaymentScreen();\">&times;</button>';tContact=tContact+'<h3 class=\"modal-title text-center\" id=\"tutorPaymentModalTitle\">'+title+'</h3>';tContact=tContact+'</div>';tContact=tContact+'<div class=\"modal-body\">';tContact=tContact+'<span id=\"tutorPaymentModalMsgBody\">'+messageBody+'</span>';tContact=tContact+'</div>';tContact=tContact+'</div>';tContact=tContact+'</div>';tContact=tContact+'</div>';try{$('#tutorPayModal').modal('hide');$('.modal-backdrop').remove();}catch(e){}\n$('#tutorPayModalCommon').html(tContact);$('#tutorPayModal').modal({backdrop:'static',keyboard:false});};var hidePaymentScreen=function(){$('#tutorPayModal').modal('hide');};var submitPaypalForm=function(txnId,resJson){$('#paypalTxnRefId').val(txnId);$('#paypalPayJson').val(resJson);document.getElementById(\"paypalTutorPayForm\").action=PAY_URL.RECEIVE_PAYPAL_PAYMENT_TUTOR_PAY;document.getElementById(\"paypalTutorPayForm\").submit();};var validatePayTutorCoins=function(){var isMoneyTransfer=false;var oldval=getPayTutorCoins();if(isBlank(oldval)||oldval==0){showPayTutorCoinsError(true,errorMsgEnterCoins);showPaymentBreakUpAmountWise(0,isMoneyTransfer);return false;}else{var newval=oldval.replace(/[^0-9.]/,'');if(oldval!=newval)\n$('#paymentInCoins').val(newval);showPayTutorCoinsError(false,'');checkRequiredMinCoinsAjax(newval);return true;}};var checkRequiredMinCoinsAjax=function(coins){var isMoneyTransfer=false;$.ajax({url:PAY_URL.VALIDATE_MIN_COINS_FOR_TUTOR_PAY+'?coins='+coins,type:'GET',cache:false,success:function(resData){var resObj=JSON.parse(resData);if(resObj.status=='SUCCESS'){$('#commonPayFormMessage').hide();showPayTutorCoinsError(false,'');showPaymentBreakUpAmountWise(coins,isMoneyTransfer);}else if(resObj.status=='ERROR'){if(isNotBlank(resObj.ERROR_MSG)){showPayTutorCoinsError(true,resObj.ERROR_MSG);}else{showPayTutorCoinsError(true,ERROR_MSG.COMMON_ERROR_MSG);}\nshowPaymentBreakUpAmountWise(0,isMoneyTransfer);}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);}});};var errorMsgEnterCoins='Please enter coins.';var successCoinsTransferred='Transaction successful.';var submitPayInCoinsForm=function(){var coinVal=getPayTutorCoins();var isValidReleasePayment=validatePayTutorReleasePayment();var isValidPaymentReleasedCbx=validateReleasePaymentCbx();var isTermsAndConditionChecked=validateTermsAndCondition();var isValidCoins=isNotBlank(coinVal);if(!isValidCoins){showPayTutorCoinsError(true,errorMsgEnterCoins);}\nif(isValidReleasePayment&&isValidPaymentReleasedCbx&&isTermsAndConditionChecked&&isValidCoins){$('#coinErrorDiv').hide();$('#commonPayFormMessage').hide();var releasePaymentOption=getPayTutorReleasePaymentType();var cbxPayImmediately=$(\"#cbxPayImmediately\").is(':checked');var cbxTermsAndConditions=$(\"#cbxTermsAndConditions\").is(':checked');var formData=new FormData();formData.append(\"payTutorTid\",getTutorUserIdEncry());formData.append(\"paymentInCoins\",coinVal);formData.append(\"payTutorReleasePaymentOption\",releasePaymentOption);formData.append(\"cbxPayImmediately\",cbxPayImmediately);formData.append(\"cbxTermsAndConditions\",cbxTermsAndConditions);var msgThreadId=$('#payTutorMsgThreadId').val();if(isNotBlank(msgThreadId)){formData.append(\"payTutorMsgThreadId\",msgThreadId);}\nvar payBtnLoaderImgId='imgLoaderForPayNow';var payBtnId='btnPayNow';$.ajax({type:\"POST\",cache:false,url:PAY_URL.TRANSFER_COINS_TO_TUTOR,data:formData,contentType:false,processData:false,beforeSend:function(){showLoaderImgAndHideBtn(payBtnLoaderImgId,payBtnId);},success:function(resData){var showBtnAndHideLoaderImg=true;try{var obj=JSON.parse(resData);if(obj.status=='SUCCESS'){showBtnAndHideLoaderImg=false;showAlertSuccessSmallOrAlertDangerMsgCommon(successCoinsTransferred,true,commonPayFormMessageDivId);$('#'+payBtnId).hide();$('#'+payBtnLoaderImgId).hide();window.setTimeout(function(){window.location.href=PAY_URL.PAYMENTS;},1500);}else if(obj.status=='ERROR'){showBtnAndHideLoaderImg=true;if(isNotBlank(obj.action)&&obj.action=='REQ_COINS'){showPayTutorCoinsError(true,errorMsgEnterCoins);}else if(isNotBlank(obj.action)&&obj.action=='INSUFFICIENT_COIN_BALANCE'){showPayTutorCoinsError(true,obj.ERROR_MSG);}else if(isNotBlank(obj.action)&&obj.action=='TUTOR_NOT_FOUND'){window.location.reload();}else if(isNotBlank(obj.ERROR_MSG)){showAlertSuccessSmallOrAlertDangerMsgCommon(obj.ERROR_MSG,false,commonPayFormMessageDivId);}else{showAlertSuccessSmallOrAlertDangerMsgCommon(ERROR_MSG.COMMON_ERROR_MSG,false,commonPayFormMessageDivId);}}else if(obj.status=='NO_ACCESS'){hideLoaderImgAndShowBtn(payBtnLoaderImgId,payBtnId);showAlertSuccessSmallOrAlertDangerMsgCommon(ERROR_MSG.NO_PERMISSION_MSG,false,commonPayFormMessageDivId);}}catch(e){console.log('error: ',e);}finally{if(showBtnAndHideLoaderImg){hideLoaderImgAndShowBtn(payBtnLoaderImgId,payBtnId);}}},error:function(e){alert(ERROR_MSG.AJAX_FAILED_MSG);hideLoaderImgAndShowBtn(payBtnLoaderImgId,payBtnId);}});}};\n"
