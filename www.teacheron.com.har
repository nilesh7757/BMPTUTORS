\n\n\n\n\n\n\n\n\n\n\n\n\n<!-- Global site tag (gtag.js) - Google AdWords: 966223742 conversion tracking from adwords er account -->\n<!-- Commented temporarily as no ads running. \nConversion tracking is now managed with analytics account by plugging in gtag('config', 'AW-966223742');  -->\n<!-- <script async src=\"https://www.googletagmanager.com/gtag/js?id=AW-966223742\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'AW-966223742');\n</script>\n\n -->\n\n \n \n\n\n\n\n\n\n\n\n\n\n<!--[if lt IE 9]>\n<script src=\"https://assets2.teacheron.com/resources/assets/plugins/respond.js?t=1794067260024\"></script>\n<script src=\"https://assets2.teacheron.com/resources/assets/plugins/html5shiv.js?t=1794067260024\"></script>\n<script src=\"http://html5shim.googlecode.com/svn/trunk/html5.js\"></script>\n\n\t<script src=\"https://assets2.teacheron.com/resources/assets/plugins/sky-forms/version-2.0.1/js/sky-forms-ie8.js?t=1794067260024\"></script>\n\n<![endif]-->\n\n<!--[if lt IE 10]>\n<script src=\"https://assets2.teacheron.com/resources/assets/plugins/sky-forms/version-2.0.1/js/jquery.placeholder.min.js?t=1794067260024\"></script>\n<![endif]-->\n\n\n\n\t<script type=\"application/ld+json\">\n\t\t{\n\t\t\t\"@context\": \"http://schema.org\",\n\t\t\t\"@type\": \"Organization\",\n\t\t\t\"name\": \"TeacherOn.com\",\n\t\t\t\"sameAs\":[\"https://www.teacheron.com/\",\"https://www.facebook.com/teacherOnDotCom/\",\"https://twitter.com/teacherondotcom\",\n\t\t\t\t\"https://www.trustpilot.com/review/teacheron.com\",\"https://g.page/teacheron/\"],\n\t\t\t\"url\":\"https://www.teacheron.com/\",\n\t\t\t\"logo\":\"https://www.teacheron.com/resources/assets/img/customImages/tLogo.jpg\",\n\t\t\t\"aggregateRating\":{\n\t\t\t\t\"@type\":\"AggregateRating\",\n\t\t\t\t\"ratingValue\":\"4.7\",\n\t\t\t\t\"reviewCount\":\"623\",\n\t\t\t\t\"bestRating\":\"5\",\n\t\t\t\t\"author\":{\n\t\t\t\t\t\"@type\":\"Organization\",\n\t\t\t\t\t\"name\":\"Google\",\n\t\t\t\t\t\"sameAs\":\"https://www.google.com/\"\n\t\t\t\t},\n\t\t\t\t\"url\":\"https://www.google.com/maps/place/TeacherOn.com/@0.5597705,55.8218867,3z/data=!3m1!4b1!4m5!3m4!1s0x391a819ca794059f:0x35593190e9db20be!8m2!3d8.7507435!4d142.1827514\"}\n\t\t}\n\t</script>\n\n\r\n\n\n\r\n\r\n\r\n\r\n<style>\n    /*body {\n        margin: 2rem;\n    }*/\n\n    .modal-dialog-video {\n        max-width: 800px;\n        margin: 30px auto;\n    }\n\n    .modal-body-video {\n        position: relative;\n        padding: 0px;\n    }\n\n    /*.close-video {\n        position: absolute;\n        right: -30px;\n        top: 0;\n        z-index: 999;\n        font-size: 2rem;\n        font-weight: normal;\n        color: #fff;\n        opacity: 1;\n    }*/\n\n   .btn-u.close-video,.btn-u.close-video:hover,.btn-u.close-video:focus,.btn-u.close-video:active {\n        border-color: #555;\n        color: white;\n        background: black;\n        border: none;\n        box-shadow: none;\n\n        position: absolute;\n        right: 0px;\n        top: -2rem;\n        z-index: 999;\n        font-size: 2rem;\n        font-weight: normal;\n        /*color: #fff;*/\n        opacity: 1;\n    }\n</style>\n\n<!-- Button trigger modal -->\n\n\n<!-- Modal -->\n<div class=\"modal fade\" id=\"tutorIntroductionVideoModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"exampleModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-dialog-video\" role=\"document\">\n        <div class=\"modal-content\">\n            <div class=\"modal-body modal-body-video\">\n                <button type=\"button\" class=\"close btn-u btn-brd rounded-4x btn-u-dark btn-u-lg close-video\" data-dismiss=\"modal\" aria-label=\"Close\">\n                    <span aria-hidden=\"true\">&times;</span>\n                </button>\n                <!-- 16:9 aspect ratio -->\n                <div class=\"embed-responsive embed-responsive-16by9\">\n                    <iframe class=\"embed-responsive-item\" src=\"\" id=\"youtubeTutorIntroductionVideo\"  allowscriptaccess=\"always\" allow=\"autoplay\"></iframe>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n\n    \n\n    var openTutorIntroductionYoutubeVideoModal = function(videoUrl, hostedAt){\n        // both are same at this point, youtube video has autoplay functionality.\n        /*if(hostedAt=='youtube'){\n            $(\"#youtubeTutorIntroductionVideo\").attr('src', videoUrl + \"?autoplay=1&amp;modestbranding=1&amp;showinfo=0\");\n        } else { // bunny video\n\n        }*/\n        $(\"#youtubeTutorIntroductionVideo\").attr('src', videoUrl);\n        $('#tutorIntroductionVideoModal').modal('show');\n    }\n\n   /* jQuery(document).ready(function() {\n        $('#tutorIntroductionVideoModal').on('hide.bs.modal', function (e) {\n            $(\"#youtubeTutorIntroductionVideo\").attr('src', '');\n        })\n    });*/\n\n    // it won't work directly on tutor search page so doing this way.\n    function waitForJqueryTutorVideoOnYoutube(){\n        if(typeof $ !== \"undefined\"){\n            //console.log(' --- JQuery is ready now ---- ');\n            $(document).ready(function() {\n                // If user select level filter but did not click on apply button still call this to search by that filter.\n                $('#tutorIntroductionVideoModal').on('hide.bs.modal', function (e) {\n                    $(\"#youtubeTutorIntroductionVideo\").attr('src', '');\n                    //console.log('----video closed----');\n                })\n            });\n        }\n        else{\n            setTimeout(waitForJqueryTutorVideoOnYoutube, 50);\n        }\n    }\n    waitForJqueryTutorVideoOnYoutube();\n</script>\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    // when student accept it then share contact\r\n    var acceptTermsToShareMyContact = true;\r\n    let levelTomSelect;\r\n    let subjectSearchTomSelect;\r\n    var selectedLevelId;// Keep it empty, due to common import \"levelTomSelect.js\" its required.\r\n\r\n    \r\n    var isTutorProfilePage = true;\r\n    var tutorName = \"\";\r\n    var tutorFirstName = \"\";\r\n    // It should be before postRequirementCommon.js file.\r\n    var uploadFilesExtNotAllowed = '[action, apk, app, bat, bin, cmd, com, command, cpl, csh, exe, gadget, inf, inx, ipa, isu, job, jse, ksh, lnk, msc, msi, msp, mst, osx, out, paf, pif, prg, ps1, reg, rgs, run, scr, sct, shb, shs, u3p, vb, vbe, vbscript, workflow, ws, wsf, wsh]';\r\n    var searchedSessionSubjectJson = '';\r\n    \r\n    var maxJobFilesUploadLimitTmp = 10; // access from tutorProfileContactTutor flow\r\n\r\n    // this is used in postRequirementCommon file but put here because of separate logic (postReq/contact tutor flow)\r\n    var openSubjectAddModel = function(){\r\n        // clear preview subject input\r\n        $('#subjectName_add').val('');\r\n        // hide contact tutor model and open subject add model\r\n        $('#contactTutorModel').modal('hide');\r\n        // open subject add model\r\n        $('#subjectAddModel').modal('show');\r\n        // show button here, if its hidden from any other flow.\r\n        showOrHideLoaderImageAndBtnForAddNewSubject(true);\r\n    };\r\n</script>\r\n    \r\n    <script src=\"https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js\"></script>\r\n    <script defer type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/correctEmailDomainShowSuggestions.js?t=1794067260024\"></script>\r\n    <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/countryPhoneCodeTomSelect.js?t=1794067260024\"></script>\r\n    <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/levelTomSelect.js?t=1794067260024\"></script>\r\n    <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/subjectsTomSelectMultiple.js?t=1794067260024\"></script>\r\n    <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/customPlugin/select2/select2.min.js?t=1794067260024\"></script>\r\n    \r\n        <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/post-requirement-common-scripts.js?t=1794067260024\"></script>\r\n        <!-- due to maintain sequence it is duplicate -->\r\n        <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/tutorProfile.js?t=1794067260024\"></script>\r\n        <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/share-contact-and-pay-tutor-script.js?t=1794067260024\"></script>\r\n        <script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/js/forms/tutorProfileContactTutor.js?t=1794067260024\"></script>\r\n    \r\n\r\n\r\n\r\n\r\n    \r\n<link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/brand-buttons-combine-style.css?t=1794067260024\">\r\n\r\n\r\n<link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/assets/customPlugin/star-rating-rateyo/jquery.rateyo.min.css?t=1794067260024\">\r\n\r\n<!-- show model for review saved and link to review us -->\r\n<div class=\"modal fade autoWidthModal wordBreak\" id=\"askToReviewTeacherOnModel\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog\" style=\"\">\r\n        <input type=\"hidden\" name=\"askToReviewUs_redirectUrl\" id=\"askToReviewUs_redirectUrl\"/>\r\n\r\n        <div class=\"modal-content\" style=\"max-width: 400px;\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close\" id=\"askToReviewUs_closeBtn\">&times;</button>\r\n                <p class=\"modal-title\"><i class=\"fas fa-check-circle color-green\"></i> Review posted</p>\r\n            </div>\r\n            <div class=\"modal-body stripeBg-\" id=\"skipConfirmation\">\r\n                <p>\r\n                    We are very excited about your positive experience with us. <br/><br/>\r\n\r\n                    We are confident that you would like others to have a similar experience.\r\n                    A 5-star review would help us to reach others like you. <br/><br/>\r\n\r\n                    So, it would mean a lot if you leave us a gloriously awesome review on one or more of the following:<br/>\r\n\r\n                    <div class=\"text-center\">\r\n                        <a class=\"btn btn-xing-inversed rounded margin-bottom-10\" href=\"https://www.trustpilot.com/evaluate/teacheron.com\" target=\"_blank\">\r\n                            <i class=\"fas fa-star\"></i> Trustpilot\r\n                        </a>\r\n\r\n                        <a class=\"btn btn-googleplus-inversed rounded margin-bottom-10\" href=\"https://www.g.page/teacheron/review\" target=\"_blank\">\r\n                            <i class=\"fab fa-google\"></i> Google\r\n                        </a>\r\n\r\n                        <a class=\"btn btn-facebook-inversed rounded margin-bottom-10\" href=\"https://www.facebook.com/teacherOnDotCom\" target=\"_blank\">\r\n                            <i class=\"fab fa-facebook\"></i> Facebook\r\n                        </a>\r\n                    </div>\r\n                </p>\r\n\r\n            </div>\r\n            \r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n<!--------------------- Modal for User Rating and Review -----------  START -------->\r\n<div class=\"modal small fade\" id=\"reviewAndRatingMainDiv\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\r\n                <h4 class=\"modal-title\">Rate and review</h4>\r\n            </div>\r\n            <form id=\"userReviewForm\" class=\"sky-form\" method=\"post\" action=\"javascript:void(0);\">\r\n                <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n                <div class=\"modal-body\">\r\n                    <!-- it will be used when adding new review only -->\r\n                    <input type=\"hidden\" name=\"mainTxnIdForReview\" id=\"mainTxnIdForReview\"/>\r\n                    <input type=\"hidden\" name=\"rating\" id=\"rating\" value=\"0\"/>\r\n\r\n                    \r\n                    <input type=\"hidden\" name=\"id\" id=\"id\" />\r\n                    \r\n                    \r\n                    \r\n                    \r\n\r\n                    \r\n                    \r\n\r\n                    <section id=\"userEmailDiv\" style=\"display: none\">\r\n                        <div id=\"sendEmailTxtBtn\"></div>\r\n                        <label class=\"label\"><b>Review From user email:</b> <span id=\"fromUserEmailVal\"></span></label>\r\n                        <label class=\"label\"><b>Review to user email:</b> <span id=\"toUserEmailVal\"></span></label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">Rating</label>\r\n                        <label class=\"input\">\r\n                            <div id=\"rateYo\"></div>\r\n                        </label>\r\n                        <div id=\"ratingErrorMsg\" style=\"display: none;\" class=\"custom-form-validation-error\">Please select rating</div>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">Add a headline</label>\r\n                        <label class=\"input\">\r\n                            <input type=\"text\" autocomplete=\"off\" onkeypress=\"validateStarRating(false);\" placeholder=\"What's most important to know?\" name=\"reviewHeading\" id=\"reviewHeading\">\r\n                        </label>\r\n                        <span style=\"display: none\" id=\"reviewHeadingCount\"></span>\r\n                        <div id=\"reviewHeadingErrorMsg\"></div>\r\n                    </section>\r\n\r\n\r\n                    <section>\r\n                        <label class=\"label\">Write your review</label>\r\n                        <label class=\"textarea\">\r\n                            <textarea rows=\"4\" onkeypress=\"validateStarRating(false);\" placeholder=\"What did you like or dislike? What were the results?\" name=\"userReview\" id=\"userReview\"></textarea>\r\n                        </label>\r\n                        <span style=\"display: none\" id=\"userReviewCount\"></span>\r\n                        <div id=\"reviewErrorMsg\"></div>\r\n                        \r\n                        <div id=\"reviewEscalateReason\" style=\"display: none\" class=\"alert alert-warning fade in\"></div>\r\n                    </section>\r\n\r\n                    \r\n                    <div id=\"saveReviewError\"></div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    \r\n                    \r\n                    <button type=\"submit\" onclick=\"validateStarRating(true);\" id=\"btn_submitReview\" class=\"btn-u btn-u-blue\"><span id=\"btnLabelSaveOrUpdateReview\">Rate and review</span></button>\r\n                    <img id=\"imgLoader_review\" style=\"display: none;\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n</div>\r\n<!--------------------- Modal for User Rating and Review -----------  END -------->\r\n\r\n<script src=\"https://assets2.teacheron.com/resources/assets/customPlugin/star-rating-rateyo/jquery.rateyo.min.js?t=1794067260024\"></script>\r\n<script src=\"https://assets2.teacheron.com/resources/assets/customPlugin/maxCharsLength/MaxLength.min.js?t=1794067260024\"></script>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n\r\n    function updateBtnLabelChangeOrUpdateReview(flow){\r\n        var btnLabel = 'Rate and review';\r\n        if(flow == 'update'){\r\n            btnLabel = 'Update rate and review';\r\n        }\r\n        $('#btnLabelSaveOrUpdateReview').html(btnLabel);\r\n    }\r\n\r\n\r\n    var REVIEW_URL_VAL = {\r\n        DELETE_REVIEW : MODULE_USER+\"/deleteReview\",\r\n        FIND_REVIEW : URL_PREFIX_API_USER+\"/findReview\",\r\n        UPDATE_REVIEW : URL_PREFIX_API_USER+ \"/updateReview\",\r\n        SAVE_USER_REVIEW : URL_PREFIX_API_USER +\"/saveUserReview\",\r\n        SAVE_USER_REVIEW_DIRECTLY : URL_PREFIX_API_USER+\"/saveUserReviewDirectly\",\r\n        SHOW_OR_HIDE_USER_REVIEW : URL_PREFIX_API_AGENT + \"/showOrHideUserReview\",\r\n        CHECK_IF_REVIEW_PROVIDED_EARLIER  : URL_PREFIX_API_USER+\"/checkIfReviewProvidedEarlier\"\r\n    };\r\n\r\n    var req_heading_error = 'Please enter headline';\r\n    var req_review_error = 'Please enter review';\r\n    // it can be add or update, default is 'add' flow and it will be modified to update.\r\n    var reviewFlow = 'add';\r\n    // When review is provided at tutorProfile page then set value to this variable. If tutor profile detected then reload page\r\n    // because it will not work due to hashTag\r\n    var tutorProfileUrlForReviewRedirect = '';\r\n\r\n    var btnId = 'btn_submitReview';\r\n    var imgLoaderId = 'imgLoader_review';\r\n\r\n    var getStarRating = function(){\r\n        var $rateYo = $(\"#rateYo\").rateYo();\r\n        var rating = $rateYo.rateYo(\"rating\");\r\n        //alert('rating: '+rating);\r\n        return rating;\r\n    };\r\n\r\n    var validateStarRating = function(focusToDiv){\r\n        var rating = getStarRating();\r\n        if(isBlank(rating) || !(rating>=1 && rating<=5)){\r\n            if(focusToDiv){\r\n                // scroll to the rating UI\r\n                document.location.href=\"#rateYo\";\r\n            }\r\n            $('#ratingErrorMsg').show();\r\n            return false;\r\n        } else {\r\n            $('#ratingErrorMsg').hide();\r\n            return true;\r\n        }\r\n    };\r\n\r\n    var showOrHideErrorMsgCommon = function(msg, isSuccess, divId){\r\n        $('#'+divId).removeClass('alert-success');\r\n        $('#'+divId).removeClass('custom-form-validation-error');\r\n        if(isSuccess){\r\n            $('#'+divId).addClass('alert-success');\r\n        } else {\r\n            $('#'+divId).addClass('custom-form-validation-error');\r\n        }\r\n        $('#'+divId).html(msg);\r\n        $('#'+divId).show();\r\n    };\r\n\r\n    var resetErrorMsgToSaveReviewAndRating = function(){\r\n        $('#ratingErrorMsg').hide();\r\n\r\n        $('#reviewHeadingErrorMsg').html('');\r\n        $('#reviewHeadingErrorMsg').hide();\r\n\r\n        $('#reviewErrorMsg').html('');\r\n        $('#reviewErrorMsg').hide();\r\n\r\n        $('#saveReviewError').html('');\r\n        $('#saveReviewError').hide();\r\n    };\r\n\r\n    var closeReviewModal = function(){\r\n        $('#reviewAndRatingMainDiv').modal('hide');\r\n    };\r\n\r\n    var UserReviewFormVal = function () {\r\n        return {\r\n            initValidation: function () {\r\n                $(\"#userReviewForm\").validate({\r\n                    rules:\r\n                    {\r\n                        reviewHeading:{\r\n                            required: true\r\n                        },\r\n                        userReview:\r\n                        {\r\n                            required: true\r\n                        }\r\n                    },\r\n                    // Messages for form validation\r\n                    messages:\r\n                    {\r\n                        reviewHeading:{\r\n                            required: req_heading_error\r\n                        },\r\n                        userReview:{\r\n                            required: req_review_error\r\n                        }\r\n                    },\r\n\r\n                    // Do not change code below\r\n                    errorPlacement: function(error, element)\r\n                    {\r\n                        error.insertAfter(element.parent());\r\n                    },\r\n\r\n                    submitHandler : function(label){\r\n                        // get the value of rating and check whether its selected or not.\r\n                        var isValidStarRating = validateStarRating(false);\r\n                        if(!isValidStarRating)\r\n                            return false;\r\n\r\n                        resetErrorMsgToSaveReviewAndRating();\r\n\r\n                        if(reviewFlow == 'add'){\r\n                            saveUserReview();\r\n                        } else if(reviewFlow == 'update'){\r\n                            updateUserReview();\r\n                        } else if(reviewFlow == 'saveDirectly'){\r\n                            saveUserReviewDirectly();\r\n                        }\r\n                    }\r\n                });\r\n            }\r\n        };\r\n    }();\r\n\r\n    var saveUserReviewDirectly = function(){\r\n        var formData = new FormData($('form#userReviewForm')[0]);\r\n        $.ajax({\r\n            type: \"POST\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.SAVE_USER_REVIEW_DIRECTLY,\r\n            data: formData,\r\n            contentType: false,\r\n            processData: false,\r\n            beforeSend: function() {\r\n                showLoaderImgAndHideBtn(imgLoaderId, btnId);\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                alert(ERROR_MSG.AJAX_FAILED_MSG);\r\n                hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n            },\r\n            success: function(obj) {\r\n                try{\r\n                    //console.log('hideTutorPhoneEvent called, data is:', data);\r\n                    //var obj = JSON.parse(data);\r\n                    if(obj.status == 'SUCCESS'){\r\n                        if(isNotBlank(obj.showLinkToReviewUs) && obj.showLinkToReviewUs=='Y'){\r\n                            try { closeReviewModal(); } catch (e){}\r\n                            $(\"#askToReviewUs_redirectUrl\").val(obj.redirect_url);\r\n                            openModalCommon('askToReviewTeacherOnModel');\r\n                        } else {\r\n                            showOrHideErrorMsgCommon('Review & rating saved', true, 'saveReviewError');\r\n                            window.setTimeout(function() {\r\n                                // 14-Sep-21: Sometimes modal is not closed even after calling reload page so close modal first then reload page.\r\n                                try { closeReviewModal(); } catch (e){}\r\n                                checkCurrentUrlAndRedirect(obj.redirect_url);\r\n                            }, 1500);\r\n                        }\r\n                    } else if(obj.status == 'ERROR'){\r\n                        showValidationErrorMsgCommon(obj);\r\n                    } else if(obj.status == 'NO_ACCESS'){\r\n                        showOrHideErrorMsgCommon(ERROR_MSG.NO_PERMISSION_MSG, false, 'saveReviewError');\r\n                    }\r\n                } catch(e){\r\n                    hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        }); // ajax code end...\r\n    };\r\n\r\n\r\n    var saveUserReview = function(){\r\n        // Note: this will be applicable for payment screen only.\r\n        var mainTxnId = $('#mainTxnIdForReview').val();\r\n        //console.log('mainTxnId: ', mainTxnId);\r\n\r\n        var formData = new FormData($('form#userReviewForm')[0]);\r\n        $.ajax({\r\n            type: \"POST\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.SAVE_USER_REVIEW,\r\n            data: formData,\r\n            contentType: false,\r\n            processData: false,\r\n            beforeSend: function() {\r\n                showLoaderImgAndHideBtn(imgLoaderId, btnId);\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                alert(ERROR_MSG.AJAX_FAILED_MSG);\r\n                hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n            },\r\n            success: function(obj) {\r\n                try{\r\n                    //console.log('hideTutorPhoneEvent called, data is:', data);\r\n                    //var obj = JSON.parse(data);\r\n                    if(obj.status == 'SUCCESS'){\r\n\r\n                        // show message for normal case only.\r\n                        if(isBlank(obj.showLinkToReviewUs)){\r\n                            $.miniNoty('Review & rating saved', 'success');\r\n                        }\r\n\r\n                        $('#span_review_'+mainTxnId).html(obj.editReviewBtn);\r\n                        hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n                        closeReviewModal();\r\n\r\n                        \r\n                        if(isNotBlank(obj.showLinkToReviewUs) && obj.showLinkToReviewUs=='Y'){\r\n                            $(\"#askToReviewUs_redirectUrl\").val(\"\");\r\n                            openModalCommon('askToReviewTeacherOnModel');\r\n                        }\r\n\r\n                    } else if(obj.status == 'ERROR'){\r\n                        showValidationErrorMsgCommon(obj);\r\n                    } else if(obj.status == 'NO_ACCESS'){\r\n                        showOrHideErrorMsgCommon(ERROR_MSG.NO_PERMISSION_MSG, false, 'saveReviewError');\r\n                    }\r\n                } catch(e){\r\n                    hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        }); // ajax code end...\r\n    };\r\n\r\n    var showValidationErrorMsgCommon = function(obj){\r\n        // if it have error message with redirect url, special case: when user direct add review 2 times from 2 screen\r\n        if(isNotBlank(obj.redirect_url) && isNotBlank(obj.ERROR_MSG)){\r\n            // show error message, wait for some time and redirect to the screen\r\n            showOrHideErrorMsgCommon(obj.ERROR_MSG, false, 'saveReviewError');\r\n            window.setTimeout(function() {\r\n                checkCurrentUrlAndRedirect(obj.redirect_url);\r\n            }, 1500);\r\n        }\r\n        else if(isNotBlank(obj.redirect_url)){\r\n            checkCurrentUrlAndRedirect(obj.redirect_url);\r\n        } else if(isNotBlank(obj.action) && obj.action=='SELECT_RATING'){\r\n            $('#ratingErrorMsg').show();\r\n            // scroll to the rating UI\r\n            document.location.href=\"#rateYo\";\r\n        } else if(isNotBlank(obj.action) && obj.action=='REQ_HEADING'){\r\n            showOrHideErrorMsgCommon(req_heading_error, false, 'reviewHeadingErrorMsg');\r\n            $('#reviewHeading').focus();\r\n        }  else if(isNotBlank(obj.action) && obj.action=='REQ_REVIEW'){\r\n            showOrHideErrorMsgCommon(req_review_error, false, 'reviewErrorMsg');\r\n            $('#userReview').focus();\r\n        } else if(isNotBlank(obj.ERROR_MSG)){\r\n            showOrHideErrorMsgCommon(obj.ERROR_MSG, false, 'saveReviewError');\r\n        }\r\n        hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n    };\r\n\r\n    var updateUserReview = function(){\r\n        var formData = new FormData($('form#userReviewForm')[0]);\r\n        $.ajax({\r\n            type: \"POST\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.UPDATE_REVIEW,\r\n            data: formData,\r\n            contentType: false,\r\n            processData: false,\r\n            beforeSend: function() {\r\n                showLoaderImgAndHideBtn(imgLoaderId, btnId);\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                alert(ERROR_MSG.AJAX_FAILED_MSG);\r\n                hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n            },\r\n            success: function(obj) {\r\n                try{\r\n                    //console.log('hideTutorPhoneEvent called, data is:', data);\r\n                    //var obj = JSON.parse(data);\r\n                    if(obj.status == 'SUCCESS'){\r\n                        showOrHideErrorMsgCommon('Review updated', true, 'saveReviewError');\r\n                        \r\n                        window.setTimeout(function() {\r\n                            checkCurrentUrlAndRedirect(obj.redirect_url);\r\n                        }, 1500);\r\n                        \r\n                    } else if(obj.status == 'ERROR'){\r\n                        showValidationErrorMsgCommon(obj);\r\n                    } else if(obj.status == 'NO_ACCESS'){\r\n                        showOrHideErrorMsgCommon(ERROR_MSG.NO_PERMISSION_MSG, false, 'saveReviewError');\r\n                    }\r\n                } catch(e){\r\n                    hideLoaderImgAndShowBtn(imgLoaderId, btnId);\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        }); // ajax code end...\r\n    };\r\n\r\n    // access by agent to update the review\r\n    var changeShowReview = function(reviewId, showReviewVal, showReviewDivId){\r\n        $.ajax({\r\n            type: \"GET\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.SHOW_OR_HIDE_USER_REVIEW+\"?id=\"+reviewId+\"&showReview=\"+showReviewVal,\r\n            dataType: 'json',\r\n            beforeSend: function() {\r\n\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                alert(ERROR_MSG.AJAX_FAILED_MSG);\r\n            },\r\n            success: function(obj) {\r\n                try{\r\n                    //console.log('hideTutorPhoneEvent called, data is:', data);\r\n                    //var obj = JSON.parse(data);\r\n                    if(obj.status == 'SUCCESS'){\r\n                        $.miniNoty(obj.msg,'success');\r\n                        $('#'+showReviewDivId).html(obj.showReviewLink);\r\n                    } else if(obj.status == 'ERROR'){\r\n                        $.miniNoty(obj.ERROR_MSG,'error');\r\n                    } else if(obj.status == 'NO_ACCESS'){\r\n                        $.miniNoty(ERROR_MSG.NO_PERMISSION_MSG,'error');\r\n                    }\r\n                } catch(e){\r\n\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        }); // ajax code end...\r\n    };\r\n\r\n    var checkCurrentUrlAndRedirect = function(redirect_url){\r\n        // issue: when on same url and it contains hastag then redirect is not working. e.g. http://localhost:8080/teacheron/tutor-profile/14#r36\r\n        // when on different url and we use window.reload() it use same url to redirect again and again e.g. http://localhost:8080/teacheron/manageMyReviews?reviewId=36&redirectTid=14&flow=edit\r\n        // however it should redirect to tutorProfile page.\r\n        // solution: checking url and redirect accordingly.\r\n        var isSameUrl = 1;\r\n        try{\r\n            if(redirect_url.indexOf(window.location.href) == 0){\r\n                isSameUrl = 0;\r\n            }\r\n            if(isSameUrl==1 && tutorProfileUrlForReviewRedirect!='' && redirect_url.indexOf(tutorProfileUrlForReviewRedirect)){\r\n                isSameUrl = 0;\r\n            }\r\n        } catch(e){\r\n            console.log('error: checkCurrentUrlAndRedirect()', e);\r\n        }\r\n        window.location.href = redirect_url;\r\n        // if required only when on same url and hashtag found\r\n        if(isSameUrl==0){\r\n            location.reload();\r\n        }\r\n    };\r\n\r\n\r\n    var setRating = function(rating){\r\n        var $rateYo = $(\"#rateYo\").rateYo();\r\n        $rateYo.rateYo(\"rating\", rating);\r\n\r\n        // if rating is not blank and we are restting it to zero then hide error message.\r\n        // This is used to reset previous error when opening modal again.\r\n        if(isNotBlank(rating) && rating==0){\r\n            $('#ratingErrorMsg').hide();\r\n        }\r\n    };\r\n\r\n    // 12-Mar-20: it will be called from payment.jsp file and if same student made 2 payments to the tutor and provided review to first payment.\r\n    // when student try to provide review to the second payment it should check it and redirect to the preview review edit page because from now\r\n    // we are maintaining 1-1 review only and removing flow to take multiple reviews.\r\n    var checkForRedirectOrOpenModal = function(mainTxnId){\r\n        $.ajax({\r\n            type: \"GET\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.CHECK_IF_REVIEW_PROVIDED_EARLIER+\"?mainTxnId=\"+mainTxnId,\r\n            dataType: 'json',\r\n            beforeSend: function() {\r\n\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                window.location.reload();\r\n            },\r\n            success: function(obj) {\r\n                //var obj = JSON.parse(data);\r\n                if(obj.status == 'SUCCESS'){\r\n                    if(obj.action == 'OPEN_MODAL'){\r\n                        openReviewModal(mainTxnId);\r\n                    } else if(obj.action=='REDIRECT'){\r\n                        window.location.href = obj.redirect_url;\r\n                    }\r\n                } else if(obj.status=='ERROR'){\r\n                    if(isNotBlank(obj.ERROR_MSG)){\r\n                        // if payment is done but not release then show error message.\r\n                        $.miniNoty(obj.ERROR_MSG,'error');\r\n                    } else if(isNotBlank(obj.action) && obj.action=='RELOAD_PAGE'){\r\n                        window.location.reload();\r\n                    }\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        });\r\n    };\r\n\r\n    var openReviewModal = function(mainTxnId){\r\n        //alert('openReviewModal with mainTxnId: '+mainTxnId);\r\n        openModalCommon('reviewAndRatingMainDiv');\r\n        //alert('mainTxnId: '+mainTxnId);\r\n        $('#mainTxnIdForReview').val(mainTxnId);\r\n        // reset previous heading and review to blank.\r\n        $('#reviewHeading').val('');\r\n        $('#userReview').val('');\r\n\r\n        // reset textArea height which is increased by autogrow functionality. It does not affect height provided by rows. e.g. rows='4'\r\n        resetTextareaHeight('userReview');\r\n        resetFormErrorMsg('userReviewForm');\r\n        // it will reset review button label to 'Rate and review'\r\n        updateBtnLabelChangeOrUpdateReview('add');\r\n        // set rating 0 whenever opening modal and hide error message\r\n        setRating(0);\r\n    };\r\n\r\n    var openReviewModalDirect = function(){\r\n        //alert('openReviewModal directly....');\r\n        $('#reviewAndRatingMainDiv').modal({\r\n            backdrop: 'static',\r\n            keyboard: false\r\n        });\r\n    };\r\n\r\n    // ---------------- API to edit review ----------------------//\r\n    var fetchReviewForUpdate = function(reviewId){\r\n\r\n        // Before calling this ajax reset previous values if any\r\n        document.getElementById(\"userReviewForm\").id.value='';\r\n        document.getElementById('userReviewForm').userReview.value = '';\r\n        document.getElementById('userReviewForm').rating.value = '';\r\n\r\n        // For older record first reset it and hide it.\r\n        $('#reviewEscalateReason').html('');\r\n        $('#reviewEscalateReason').hide();\r\n\r\n\r\n        $.ajax({\r\n            type: \"GET\",\r\n            cache: false,\r\n            url: REVIEW_URL_VAL.FIND_REVIEW +\"?reviewId=\"+reviewId,\r\n            beforeSend: function() {\r\n\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                alert('Could not fetch record at this time.');\r\n            },\r\n            success: function(data) {\r\n                var obj = JSON.parse(data);\r\n                if(obj.status == 'SUCCESS'){\r\n                    document.getElementById('userReviewForm').id.value = obj.id;\r\n                    document.getElementById('userReviewForm').reviewHeading.value = obj.heading;\r\n                    document.getElementById('userReviewForm').userReview.value = obj.review;\r\n                    document.getElementById('userReviewForm').rating.value = obj.rating;\r\n\r\n                    // if user is admin/agent then it will have review status data.\r\n                    if(isNotBlank(obj.reviewStatus)){\r\n                        document.getElementById('userReviewForm').reviewStatus.value = obj.reviewStatus;\r\n                    }\r\n                    if(isNotBlank(obj.showReview)){\r\n                        if(obj.showReview == true){\r\n                            document.getElementById('userReviewForm').rdoShowReviewYes.checked=true;\r\n                        } else {\r\n                            document.getElementById('userReviewForm').rdoShowReviewNo.checked=true;\r\n                        }\r\n                    }\r\n\r\n                    if(isNotBlank(obj.fromUserEmail) && isNotBlank(obj.toUserEmail)){\r\n                        $('#fromUserEmailVal').html(obj.fromUserEmail);\r\n                        $('#toUserEmailVal').html(obj.toUserEmail);\r\n                        if(isNotBlank(obj.sendEmailTxt)){\r\n                            $('#sendEmailTxtBtn').html(obj.sendEmailTxt);\r\n                        }\r\n                        $('#userEmailDiv').show();\r\n                    }\r\n\r\n\r\n\r\n                    if(isNotBlank(obj.reviewEscalateReason)){\r\n                        $('#reviewEscalateReason').html(\"<b class='color-red'>Review escalate reason: </b><br/>\"+obj.reviewEscalateReason);\r\n                        $('#reviewEscalateReason').show();\r\n                    }\r\n\r\n\r\n                    reviewFlow = 'update'; // setting this to update.\r\n                    setRating(obj.rating);\r\n                    // during update operation changed review button label to 'Update rate and review'\r\n                    updateBtnLabelChangeOrUpdateReview('update');\r\n                    openReviewModalDirect();\r\n                } else if(obj.status=='ERROR'){\r\n                    if(isNotBlank(obj.action) && obj.action == 'NO_ACCESS'){\r\n                        $.miniNoty('You don\\'t have permission to edit review','error');\r\n                    } else if(isNotBlank(obj.action) && obj.action == 'REVIEW_NOT_FOUND'){\r\n                        $.miniNoty('No review found to edit','error');\r\n                    } else {\r\n                        $.miniNoty('Could not update review at this time. Please try later.','error');\r\n                    }\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        });\r\n    };\r\n\r\n\r\n    // ---------------- JQuery Ready code START ----------------------\r\n    jQuery(document).ready(function() {\r\n        UserReviewFormVal.initValidation();\r\n\r\n        // Reference: https://rateyo.fundoocode.ninja/#installation\r\n        $(\"#rateYo\").rateYo({\r\n            //rating: 1,  // for the default selected field.\r\n            fullStar: true,  // for the full star.\r\n            //starWidth: \"40px\", // default size: 18px,\r\n            //normalFill: \"#A0A0A0\", // define colors for empty (non selected) stars,\r\n            ratedFill: \"#72c02c\", // defines the colors of fill stars,\r\n            // numStars: 5, // define number of stars\r\n            spacing   : \"5px\",\r\n            // readOnly: true, // Make rating readonly\r\n            onSet: function (rating, rateYoInstance) {\r\n                $('#rating').val(rating);\r\n                // hide error message related to ratings\r\n                validateStarRating(false);\r\n            }\r\n            // readOnly: true\r\n            // 22-Nov-19: For agent disable it\r\n            \r\n\r\n\r\n            /*onChange: function (rating, rateYoInstance) {\r\n             $(this).next().text(rating);\r\n             }*/\r\n        });\r\n\r\n        // validate max characters for review heading\r\n        $(\"#reviewHeading\").MaxLength({\r\n            MaxLength: 100,\r\n            CharacterCountControl: $('#reviewHeadingCount')\r\n        });\r\n\r\n        // validation for max characters for user review\r\n        $(\"#userReview\").MaxLength({\r\n            MaxLength: 2500,\r\n            CharacterCountControl: $('#userReviewCount')\r\n        });\r\n\r\n\r\n\r\n        $(\"#askToReviewUs_closeBtn\").click(function() {\r\n            // Close model for all case and reload page if it is tutorSearch flow.\r\n            closeModalCommon('askToReviewTeacherOnModel');\r\n            var redirectUrl = $(\"#askToReviewUs_redirectUrl\").val();\r\n            if(isNotBlank(redirectUrl)){\r\n                checkCurrentUrlAndRedirect(redirectUrl);\r\n            }\r\n        });\r\n\r\n    }); // JQuery on load end\r\n</script>\r\n    <script>\r\n            // this variable should come after 'userReviewModalCommon.jsp'\r\n            reviewFlow = 'saveDirectly';\r\n            tutorProfileUrlForReviewRedirect = '';\r\n    </script>\r\n\r\n\r\n\r\n\r\n<link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/assets/customPlugin/select2/select2.min.css?t=1794067260024\">\r\n\r\n\r\n\r\n\r\n\r\n<!--------------------- Modal for User Rating and Review -----------  START -------->\r\n<div class=\"modal small fade scrollableModal\" id=\"billingAddressModal\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close clsModalCloseBtnOfBillingAddress\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\r\n                <h4 class=\"modal-title\">Billing address</h4>\r\n                <p class=\"no-margin-bottom\"><small>Should match with the name & address of the payment method</small></p>\r\n            </div>\r\n            <form id=\"billingAddressForm\" class=\"sky-form\" method=\"post\" action=\"javascript:void(0);\">\r\n                <div class=\"modal-body\">\r\n                    <input type=\"hidden\" name=\"id\" id=\"id\" value=\"\"/>\r\n                    <input type=\"hidden\" name=\"ipAddress\" id=\"ipAddress\"/>\r\n                    <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n\r\n                    \r\n                    <input type=\"hidden\" name=\"token\" value=\"\"/>\r\n\r\n\r\n                    <section>\r\n                        <label class=\"label\">Full name</label>\r\n                        <label class=\"input\">\r\n                            <input type=\"text\" name=\"fullName\" maxlength=\"100\" autocomplete=\"off\" id=\"fullName\" value=\"\"/>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">Country</label>\r\n                        <label class=\"select\">\r\n                                <select style=\"width: 100%\" id=\"countryId\" name=\"countryId\" onchange=\"checkPostalCode(this.value);\" class=\"country-select2 form-control\" tabindex=\"-1\">\r\n                                <option value=\"\"></option>\r\n                                \r\n                            </select>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">State</label>\r\n                        <label class=\"input\">\r\n                            <input type=\"text\" name=\"state\" id=\"state\" maxlength=\"100\" value=\"\" autocomplete=\"off\"/>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">City</label>\r\n                        <label class=\"input\">\r\n                            <input type=\"text\" name=\"city\" id=\"city\" maxlength=\"100\" value=\"\" autocomplete=\"off\"/>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section id=\"postalCodeDiv\" style=\"display: none\">\r\n                        <label class=\"label\">Postal code</label>\r\n                        <label class=\"input\">\r\n                            <input type=\"text\" maxlength=\"45\" name=\"postalCode\" id=\"postalCode\" value=\"\" autocomplete=\"off\"/>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <label class=\"label\">Address</label>\r\n                        <label class=\"textarea\">\r\n                            <textarea rows=\"3\" maxlength=\"1000\" name=\"address\" id=\"address\" autocomplete=\"off\"></textarea>\r\n                        </label>\r\n                    </section>\r\n\r\n                    <section>\r\n                        <div class=\"inline-group inline\">\r\n                            <label> Contact No. </label> <br/>\r\n                            <div class=\"phoneCodeDiv\">\r\n                                        <span>\r\n                                            \r\n                                            \r\n                                             <select style=\"width: 100%\" id=\"phoneCodeCountryIdBillingAddress\" name=\"phoneCodeCountryIdBillingAddress\" class=\"ts-custom-phone-code vertical-align-middle\"></select>\r\n                                        </span>\r\n                            </div>\r\n                            <div class=\"phoneDivAfterPhoneCode\">\r\n                                <input name=\"phoneNumber\" id=\"phoneNumber\" maxlength=\"15\" value=\"\" type=\"text\" class=\"numbers-only form-control\" inputmode=\"numeric\">\r\n                            </div>\r\n                        </div>\r\n                    </section>\r\n                    <div id=\"billingAddressCommonMsg\"></div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    \r\n                    <button type=\"submit\" id=\"btnSubmitBillingAddress\" class=\"btn-u btn-u-blue\">Submit</button>\r\n                    <img id=\"imgLoaderBillingAddress\" style=\"display: none;\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\" src=\"https://assets2.teacheron.com/resources/assets/customPlugin/select2/select2.min.js?t=1794067260024\"></script>\r\n<script>\r\n\r\n    var testAppPaymentFlow = false;\r\n    var SAVE_OR_UPDATE_BILLING_ADDRESS = URL_PREFIX_API_USER+\"/saveOrUpdateBillingAddress\";\r\n    var CHECK_POSTAL_CODE_BY_COUNTRY_ID = URL_PREFIX_API_USER+\"/checkPostalCodeByCountryId\";\r\n\r\n    \r\n\r\n    var BillingAddressFormVal = function () {\r\n        return {\r\n            initValidation: function () {\r\n                $(\"#billingAddressForm\").validate({\r\n                    rules:\r\n                    {\r\n                        fullName:{\r\n                            required : true\r\n                        },\r\n                        countryId:{\r\n                            required : true\r\n                        },\r\n                        city:{\r\n                            required: true\r\n                        },\r\n                        state:{\r\n                            required: true\r\n                        },\r\n                        address:{\r\n                            required : true\r\n                        },\r\n                        phoneCodeCountryIdBillingAddress:{\r\n                            required : true\r\n                        },\r\n                        phoneNumber:{\r\n                            required: true\r\n                        },\r\n                        postalCode:{\r\n                            required : true\r\n                        }\r\n                    },\r\n\r\n                    // Messages for form validation\r\n                    messages:\r\n                    {\r\n\r\n                        fullName:{\r\n                            required : 'Please enter full name.'\r\n                        },\r\n                        countryId:{\r\n                            required : 'Please select country.'\r\n                        },\r\n                        city:{\r\n                            required: 'Please enter city.'\r\n                        },\r\n                        state:{\r\n                            required: 'Please enter state.'\r\n                        },\r\n                        address:{\r\n                            required : 'Please enter address.'\r\n                        },\r\n                        phoneCodeCountryIdBillingAddress:{\r\n                            required : 'Required'\r\n                        },\r\n                        phoneNumber:{\r\n                            required: 'Please enter phone number.'\r\n                        },\r\n                        postalCode:{\r\n                            required : 'Please enter postal code.'\r\n                        }\r\n                    },\r\n                    // Do not change code below\r\n                    errorPlacement: function(error, element)\r\n                    {\r\n                        error.insertAfter(element.parent());\r\n                    },\r\n\r\n                    submitHandler : function(label){\r\n                        saveOrUpdateBillingAddress();\r\n                    }\r\n                });\r\n            }\r\n\r\n        };\r\n    }();\r\n\r\n\r\n    var initPhoneCodeSelect2 = function(){\r\n        $(\".phone-code-select2\").select2({\r\n            \"language\": {\r\n                \"noResults\": function(){\r\n                    return '<span class=\"alert alert-danger\">\"'+$('.select2-search__field').val()+'\" not found </span>';\r\n                }\r\n            },\r\n            //dropdownCssClass : 'phoneCode_open',\r\n            escapeMarkup: function (markup) {\r\n                return markup;\r\n            }\r\n        });\r\n    };\r\n\r\n    var initCountrySelect2 = function(){\r\n        $(\".country-select2\").select2({\r\n            dropdownParent: $('#billingAddressModal'),   // 31-Jun-26: <-- key fix for modal\r\n            \"language\": {\r\n                \"noResults\": function(){\r\n                    return '<span class=\"alert alert-danger\">\"'+$('.select2-search__field').val()+'\" not found </span>';\r\n                }\r\n            },\r\n            escapeMarkup: function (markup) {\r\n                return markup;\r\n            }\r\n        });\r\n    };\r\n\r\n    // 31-Jun-26: Fix for jQuery 3.6+ where select2 doesn't focus the search field on open\r\n    // Fixed issue: Country select2 - type options was not coming\r\n    $(document).on('select2:open', function () {\r\n        var searchField = document.querySelector('.select2-container--open .select2-search__field');\r\n        if (searchField) { searchField.focus(); }\r\n    });\r\n\r\n\r\n    function checkPostalCode(countryId){\r\n        $.ajax({\r\n            type: \"GET\",\r\n            url: CHECK_POSTAL_CODE_BY_COUNTRY_ID+\"?countryId=\"+countryId,\r\n            cache: false,\r\n            beforeSend: function() {\r\n\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                $('#postalCodeDiv').show();\r\n            },\r\n            success: function(data) {\r\n                var obj = JSON.parse(data);\r\n                if(obj.status == 'SUCCESS'){\r\n                    if(obj.askPostalCode == true){\r\n                        $('#postalCodeDiv').show();\r\n                    } else {\r\n                        $('#postalCodeDiv').hide();\r\n                        $('#postalCode').val('');\r\n                    }\r\n                } else if(obj.status=='ERROR'){\r\n                    $('#postalCodeDiv').show();\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        });\r\n    };\r\n\r\n    var imgLoaderId_billingAddress = 'imgLoaderBillingAddress';\r\n    var btnId_billingAddress = 'btnSubmitBillingAddress';\r\n    var commonMsgDivId_billingAddress = 'billingAddressCommonMsg';\r\n\r\n    function saveOrUpdateBillingAddress(){\r\n        // hide previous error before calling ajax\r\n        $('#billingAddressCommonMsg').val('');\r\n        $('#billingAddressCommonMsg').hide();\r\n\r\n        $.ajax({\r\n            type: \"GET\",\r\n            url: 'https://www.teacheron.com/api/user/check-login-status',\r\n            cache: false,\r\n            beforeSend: function() {\r\n                showLoaderImgAndHideBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                showAlertSuccessOrAlertDangerMsgCommon(ERROR_MSG.AJAX_FAILED_MSG, false, commonMsgDivId_billingAddress);\r\n                hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n            },\r\n            success: function(obj) {\r\n                //var obj = JSON.parse(data);\r\n                if(obj.status == 'USER_IS_LOGGED_OUT'){\r\n                    //hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n                    //showAlertSuccessOrAlertDangerMsgCommon(ERROR_MSG.PAGE_INSERT_SESSION_EXPIRED, false, commonMsgDivId_billingAddress);\r\n                    // 05-Jan-22: as discussed redirect user back to login screen instead of showing message.\r\n                    redirectToLoginPageWithCurrentUrl();\r\n                } else {\r\n                    saveBillingAddressAjax();\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        });\r\n    }\r\n\r\n    var askForBillingAddress = function(){\r\n        openModalCommon('billingAddressModal');\r\n        \r\n        // fetchIpAddressForPaymentAjax();\r\n    };\r\n\r\n    var saveBillingAddressAjax = function(){\r\n        var formData = new FormData($('form#billingAddressForm')[0]);\r\n        $.ajax({\r\n            type: \"POST\",\r\n            cache: false,\r\n            url: SAVE_OR_UPDATE_BILLING_ADDRESS,\r\n            data: formData,\r\n            contentType: false,\r\n            processData: false,\r\n            beforeSend: function() {\r\n                showLoaderImgAndHideBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n            },\r\n            error: function(jqXHR, textStatus, errorMessage) {\r\n                showAlertSuccessOrAlertDangerMsgCommon(ERROR_MSG.AJAX_FAILED_MSG, false, commonMsgDivId_billingAddress);\r\n                hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n            },\r\n            success: function(data) {\r\n                try{\r\n                    //console.log('hideTutorPhoneEvent called, data is:', data);\r\n                    var obj = JSON.parse(data);\r\n                    if(obj.status == 'SUCCESS'){\r\n                        // set billingId and submit form\r\n                        $('#billingAddressId').val(obj.billingAddressId);\r\n\r\n                        \r\n                        try{\r\n                            $('#billingAddressIdEncry').val(obj.billingAddressIdEncry);\r\n                        } catch(e){\r\n\r\n                        }\r\n\r\n\r\n                        if(testAppPaymentFlow){\r\n                            submitBillingAddressForTestPayment(obj.token);\r\n                        } else {\r\n                            submitFormFromBillingAddress();\r\n                        }\r\n                    } else if(obj.status=='ERROR'){\r\n                        showAlertSuccessOrAlertDangerMsgCommon(ERROR_MSG.COMMON_ERROR_MSG, false, commonMsgDivId_billingAddress);\r\n                        hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n                    } else if(obj.status == 'VALIDATION_ERROR'){\r\n                        hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n                        var missingFieldsArr = obj.missingFields;\r\n                        for(i=0; i<missingFieldsArr.length; i++){\r\n                            var errorKey = missingFieldsArr[i];\r\n                            if(errorKey == 'fullName'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#fullName\");\r\n                            } else if(errorKey == 'countryId'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#countryId\");\r\n                            } else if(errorKey == 'city'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#city\");\r\n                            } else if(errorKey == 'state'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#state\");\r\n                            } else if(errorKey == 'address'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#address\");\r\n                            } else if(errorKey == 'phoneCodeCountryIdBillingAddress'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#phoneCodeCountryIdBillingAddress\");\r\n                            } else if(errorKey == 'phoneNumber'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#phoneNumber\");\r\n                            } else if(errorKey == 'postalCode'){\r\n                                $(\"#billingAddressForm\").validate().element(\"#postalCode\");\r\n                            }\r\n                        }\r\n                    }\r\n                } catch(e){\r\n                    hideLoaderImgAndShowBtn(imgLoaderId_billingAddress, btnId_billingAddress);\r\n                }\r\n            },\r\n            complete: function() {\r\n\r\n            }\r\n        });\r\n    };\r\n\r\n\r\n    jQuery(document).ready(function() {\r\n        BillingAddressFormVal.initValidation();\r\n        // initPhoneCodeSelect2();\r\n        initCountrySelect2();\r\n        \r\n        // Show this when values comes from backend\r\n        \r\n\r\n        // Set value of selected phone country Id when modal is about to open.\r\n        $('#billingAddressModal').on('shown.bs.modal', function () {\r\n            \r\n        });\r\n\r\n    }); // JQuery onload end\r\n\r\n    \r\n\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n    maxDiagonalForJob = 40\r\n    var isSubjectScreenReached = false;\r\n    var convertedOnce = false;\r\n\tvar subjectsAddedCount = 0;\r\n\tvar isChangeTitleValid = true;\r\n    var isJsloaded = false;\r\n    var docContentReady = false;\r\n    jQuery(window).load(function () {\r\n    \tisJsloaded = true;\r\n    });\r\n\r\n    jQuery(document).ready(function() {\r\n        $(\"#autocomplete\").focus(function(){\r\n            geolocate();\r\n        });\r\n\r\n        \r\n        \r\n        userWithoutLogin = true;\r\n\r\n        // App.init();\r\n        //initSelect2MsgForViewTutorPhone();\r\n        //initSelectForPhoneCodeAndCountryId();\r\n        initTomSelectForPhoneCode();\r\n        // initTomSelectForPhoneCodeToVerifyPhone();\r\n        initTomSelectForLevel();\r\n\r\n        //initSubjectSearchAutoComplete();\r\n        initSubjectMultipleTomSelect();\r\n\r\n        PostRequirementFormVal.initValidation();\r\n        verifyStudentPhoneFormVal.initValidation();\r\n        PreviousPostFormVal.initValidation();\r\n        tutorFirstName = '';\r\n        userIdEncry = '';\r\n\r\n\r\n        try{\r\n            clearLoginPopupModalFields();\r\n        } catch(e){\r\n\r\n        }\r\n\r\n        //setDefaultAssociation();\r\n        //************************** Contact Tutor START ****************\r\n       /* $('#responsive').on('shown.bs.modal', function() {\r\n            $(\"#location_input\").focus();\r\n        });*/\r\n\r\n        $('.tutoring-options-group').on('change', function() {\r\n            if($(\"#cbxOnlineTutoring\").is(':checked') && $(\"#cbxHomeTutoring\").is(':checked') && $(\"#cbxWillingToTravel\").is(':checked')) {\r\n//                $(\"#tutoring_options_div\").hide(\"slide\");\r\n//                $(\"#travel_options_div\").show();\r\n                triggerValidation('travel_options_div','tutoring_options_div');setModelTitle('canTravel');\r\n                isChangeTitleValid = true;\r\n                setModelTitle('canTravel');\r\n            }\r\n        });\r\n/*\r\n        $('#cbxWillingToTravel').on('change', function() {\r\n            if($(\"#cbxWillingToTravel\").is(':checked')) {\r\n            \ttriggerValidation('continue_travel_options_btn','continue_to_subjects');\r\n            }\r\n            else\r\n            \ttriggerValidation('continue_to_subjects','continue_travel_options_btn');\r\n        });\r\n */\r\n\r\n        // Comment this one as it will impact sessionStore flow.\r\n        // uncommented as was able to accomodate the required functionality.\r\n        $(\"input:radio[name=travelDistance]\").on(\"click\",function() {\r\n//            $(\"#travel_options_div\").hide(\"slide\");\r\n//            $(\"#subjects_div\").show();\r\n            triggerValidation('subjects_div','travel_options_div');\r\n            setModelTitle('subjects');\r\n        });\r\n\r\n        //************************** Contact Tutor END ****************\r\n\r\n        $(\"#btnSubjectSave\").click(function(){\r\n            // its coming form postRequirenentCommon.js file.\r\n            saveNewSubjectByUser();\r\n        });\r\n\r\n\r\n        // **************** Either show error message or redirect user to the review page ****************\r\n        $(\".btnReviewTutor\").click(function(){\r\n            processTutorReviewAction();\r\n        });\r\n        docContentReady = true;\r\n\r\n        \r\n\r\n        $(\".clsContactBtnMobile\").on(\"click\", function(){\r\n            $('html, body').animate({\r\n                scrollTop: $(\"#contactTutorBtnDiv\").offset().top-15\r\n            }, 400);\r\n            //$(\".clsContactBtnMobileDiv\").hide();\r\n            $(\".clsContactBtnMobileDiv\").slideDown();\r\n        });\r\n\r\n        $('#email').on('change', function() {\r\n            try{ suggestCorrectEmail($(this).val(), 'emailErrorMsg');} catch(e){console.log('error in suggestCorrectEmail: ', e);}\r\n        });\r\n\r\n        $('#dueDateView').datepicker({\r\n            //changeYear: true,\r\n            //changeMonth: true,\r\n            //yearRange: '-100:+1',\r\n            //maxDate: '0',\r\n            minDate:0,// setting minimum date as today ->0, 1 for tomorrow\r\n            prevText: '<i class=\"fa fa-angle-left\"></i>',\r\n            nextText: '<i class=\"fa fa-angle-right\"></i>',\r\n            dateFormat: TEACHERON_COMMON_SETTING.VIEW_DATE_FORMAT,\r\n            altFormat: TEACHERON_COMMON_SETTING.SUBMIT_DATE_FORMAT,\r\n            altField: '#dueDate'\r\n        });\r\n        \r\n        $('.ui-datepicker').addClass('notranslate');\r\n\r\n\r\n\r\n    }); // JQuery ready END\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n    jQuery(document).ready(function() {\r\n        // -------------------- correct user phone model -------------- START\r\n        $(\".clsBtnCorrectPhoneNumber\").on(\"click\", function () {\r\n            $(\"#phone\").val($(\"#m_autoCorrectedPhoneNumberWithoutCode\").html());\r\n            closeInvalidPhoneAutoCorrectModel();\r\n\r\n            // open contact tutor model and navigate to the contact details model.\r\n            hideAllPostReqFormDiv();\r\n            //setModelTitle('contactDtl');\r\n            //$('#contact_details_div').fadeIn();\r\n            // go to the next screen once model is open. Copied from contact details screen button.\r\n            triggerValidation('summary_description_div', 'contact_details_div');\r\n            setModelTitle('myReq');\r\n\r\n            // to avoid delay open model later once all process are done.\r\n            contactTutor();\r\n        });\r\n\r\n        $(\".clsCloseButtonOfCorrectPhoneModel\").on(\"click\", function () {\r\n            // open contact tutor model and navigate to the contact details model.\r\n            hideAllPostReqFormDiv();\r\n            setModelTitle('contactDtl');\r\n            contactTutor();\r\n            $('#contact_details_div').fadeIn();\r\n        });\r\n        // -------------- END -----------\r\n\r\n        // add this inside jQuery once loaded\r\n        \r\n\r\n        $('#btnContactTutor').click(function () {\r\n            contactTutorEvent(false, false);\r\n        });\r\n\r\n        $('#btnTutorPhone').click(function () {\r\n            checkTutorPhoneOnProfile('');\r\n        });\r\n\r\n        $('#btnContactUsingNewPost').click(function () {\r\n            // close current open modal then open postRequirement modal\r\n            $('#contactTutorStudentPreviousJobListModal').modal('hide');\r\n            contactTutor(); // call function to open contact tutor screen\r\n        });\r\n        checkSessionStorageToCleanOrPopulateRec('');\r\n        setTutContactSeenCountOnLoad();\r\n        //initSubjectAsLanguageSelect2();\r\n\r\n        // this btnId is coming from backedn that why it wont visible here\r\n        // When pay tutor button is clicked, pass tutorId enc\r\n        $('#btnPayToTutor').click(function () {\r\n            payTutorDirect('', '');\r\n        });\r\n\r\n        \r\n\r\n        window.addEventListener('scroll', function () {\r\n            showOrHideContactBtnMobile();\r\n        });\r\n\r\n        // Listening to resize events\r\n        window.addEventListener('resize', function () {\r\n            showOrHideContactBtnMobile();\r\n        });\r\n\r\n\r\n        \r\n\r\n        \r\n        \r\n\r\n    }); // JQuery ready END\r\n\r\n    // When JQuery is ready then show contact button as per the case.\r\n    window.onload = function() {\r\n        //console.log(\"window.onload is called.\");\r\n        showOrHideContactBtnMobile();\r\n    };\r\n\r\n    \r\n    $(document).on('click','.clsPayToTutorFromDynContactModal',function(){\r\n        payTutorDirect('','');\r\n    });\r\n\r\n    var btnTutorContactEvent = function(){\r\n        \r\n            \r\n            \r\n                var title = '<span>Contact details not public</span>';\r\n                var msg = '<div class=\"text-center-\">'+tutorFirstName+' has not shared contact details publically.' +\r\n                        '<br>'+tutorFirstName+' can chose to reply after seeing your message.</div>'+\r\n                        '<div class=\"text-center margin-top-10\"><a href=\"javascript:void(0);\" onclick=\"contactTutorEvent(true, false);\" class=\"btn btn-u rounded\">Send message</a></div>';\r\n                        openCommonMsgModal(title, msg);\r\n            \r\n        \r\n    };\r\n</script>\r\n<script src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyDg6kCEaDXAO_n_F4bW83EnhKCYGsMsNOk&libraries=places&language=en&loading=async&callback=initAutocomplete\"  async ></script>\r\n\n<script>\n    var csrf_token;\n    var csrf_header;\n    \n    function waitForJquery_csrf(){\n        if(typeof $ !== \"undefined\"){\n            csrf_token = $(\"meta[name='_csrf']\").attr(\"content\");\n            csrf_header = $(\"meta[name='_csrf_header']\").attr(\"content\");\n\n            \n            $(document).ajaxSend(function(e, xhr, options) {\n                //console.log(' --- csrf ajax call --- ');\n                xhr.setRequestHeader(csrf_header, csrf_token);\n            });\n            // 05-May-25: Store module is already stopped so this is not required.\n            /*$(\".clsCloseStoreLaunchNotificationToTutor\").click(function(){\n                $(\".clsStoreNotificationDiv\").hide();\n                $.ajax({\n                    type: \"GET\",\n                    url: getAppContext()+'markStoreNotificationRead',\n                    cache: false,\n                    error: function(jqXHR, textStatus, errorMessage) {\n\n                    },\n                    success: function(data) {\n\n                    }\n                }); // Ajax end\n            });*/\n        } else {\n            setTimeout(waitForJquery_csrf, 50);\n        }\n    }\n    waitForJquery_csrf();\n</script>\r\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"858d9d2ea42e45cc8995f6f399b10a92\",\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body>\r\n</html>"
