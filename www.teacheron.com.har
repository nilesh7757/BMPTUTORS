          "content": {
            "size": 1122,
            "mimeType": "application/javascript",
            "text": "function suggestCorrectEmail(email, divId){\n    $(\"#\"+divId).html(\"\"); // Reset older values\n    $(\"#\"+divId).hide();\n\n    if(isBlank(email))\n        return;\n\n    var formData = new FormData();\n    formData.append(\"email\", email);\n\n    $.ajax({\n        url: URL_PREFIX_API_USER + \"/suggest-correct-email\",\n        type: \"POST\",\n        cache: false,\n        data: formData,\n        contentType: false,\n        processData: false,\n        //cache: false,\n        error: function(jqXHR, textStatus, errorMessage) {\n            console.log(\" --- suggestCorrectEmail --- ajax failed \");\n        },\n        success: function(resObj) {\n            //\n            if (resObj.status == 'SUCCESS' && isNotBlank(resObj.correctedDomain)) {\n                $('#'+divId).removeClass();\n                $('#'+divId).addClass(\"alert alert-warning\");\n                //$(\"#\" + divId).html(\"Did you mean \" + resObj.correctedDomain);\n                $(\"#\" + divId).html(\"Did you mean <b>\"+resObj.correctedDomain+\"</b>? Check for typos in your email address.</div>\");\n                $(\"#\" + divId).show();\n            }\n        }\n    });\n};"
          },
