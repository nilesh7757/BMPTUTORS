ssets2.teacheron.com/resources/common-combined-style.css?t=1794067260024\">\r\n    \r\n\r\n\r\n\r\n\r\n\r\n\t\t\r\n<style>\r\nbody, .ui-widget, h1, h2, h3, h4, h5, h6{\r\n\tfont-family: Arial, \"Helvetica Neue\", Helvetica, sans-serif;\r\n\tword-wrap: break-word;\r\n}\r\nbody,p,.p, .ui-widget {\r\n\tfont-size: 16px;\r\n\tfont-weight: 400;\r\n\tletter-spacing: .5px;\r\n    line-height: 23px;\r\n}\r\nh1, .h1 {\r\n    font-size: 30px;\r\n    line-height: 42px;\r\n}\r\nh2, .h2 {\r\n    font-size: 25px;\r\n    line-height: 33px;\r\n}\r\nh3, .h3 {\r\n    font-size: 21px;\r\n    line-height: 27px;\r\n}\r\nh4, .h4 {\r\n    font-size: 17px;\r\n    line-height: 25px;\r\n}\r\nh1, h2, h3, h4, h5, h6 {\r\n    font-weight: 500;\r\n    margin-top: 30px;\r\n}\r\n.form-control{\r\n\t/*font-size: 15px;*/\r\n    font-size: 1em;\r\n    /*height: auto;*/\r\n    height: 36px;\r\n}\r\n\r\n.list-inline>li {\r\n    display: inline-block;\r\n    padding-right: 5px;\r\n    padding-left: 5px;\r\n}\r\n.container {\r\n    width: 92.5%;\r\n}\r\n</style>\r\n  \r\n\r\n        \r\n            <link rel=\"preload\" href=\"https://assets2.teacheron.com/resources/sky-form-css.css?t=1794067260024\" as=\"style\" onload=\"this.rel='stylesheet'\">\r\n        \r\n    <!--[if lt IE 9]><link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/assets/plugins/sky-forms-pro/skyforms/css/sky-forms-ie8.css?t=1794067260024\"><![endif]-->\r\n\r\n\r\n\r\n<link rel=\"preload\" href=\"https://assets2.teacheron.com/resources/assets/customPlugin/jquery-ui-1.12.1.custom/jquery-ui.min.css?t=1794067260024\" as=\"style\" onload=\"this.rel='stylesheet'\">\r\n<link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/assets/plugins/fontawesome-free-5.8.1-web/css/all.min.css?t=1794067260024\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n \t\r\n\t\r\n \r\n <script>\r\n    var fixedAssetsUrlForIcon = \"https://assets2.teacheron.com\";\r\n    var lazyAssetsLoaded = false;\r\n    var CONTEXT = '/';\r\n    var TEST_APP_API_PREFIX_COMMON = 'api/testapp/';\r\n    var TEST_APP_URL_PREFIX_COMMON = 'testapp/';\r\n    var ajaxTimeoutVal = 10000;\r\n    var setContextPath = function() {\r\n        var hostName = window.location.host;\r\n        // For localhost use /teacheron/ as context\r\n        if(hostName.includes(':8080')){\r\n            CONTEXT = '/teacheron/';\r\n            ajaxTimeoutVal = 1000000; // for local increase its time to not to timeout\r\n        }\r\n    };\r\n    setContextPath();\r\n    var getAppContext = function(){\r\n        return CONTEXT;\r\n    };\r\n\r\n    var URL_PREFIX_API = CONTEXT + \"api\";\r\n    var URL_PREFIX_API_TEACHER = CONTEXT + \"api/teacher\";\r\n    var URL_PREFIX_API_AGENT = CONTEXT + \"api/agent\";\r\n    var URL_PREFIX_API_USER = CONTEXT + \"api/user\";\r\n    var URL_PREFIX_API_STUDENT = CONTEXT + \"api/student\";\r\n    var MODULE_USER = CONTEXT + \"user\";\r\n    var MODULE_TEACHER = CONTEXT + \"teacher\";\r\n    var MODULE_STUDENT = CONTEXT + \"student\";\r\n    var MODULE_AGENT = CONTEXT + \"agent\";\r\n\r\n\r\n    var GLOBAL_VAR = {\r\n        DEBUG : true\r\n    };\r\n // ref: https://stackoverflow.com/questions/24413881/why-is-is-not-equal-to-null\r\n    var isNotBlank = function(data){\r\n        return (data !== undefined) && (data !== null) && (data !== \"\") && (data!='null');\r\n    };\r\n    var isBlank = function(val){\r\n        // Note: val=='' if return true when val=0\r\n    \treturn (typeof val==\"undefined\" || val=='' || val==null || val=='null');\r\n    };\r\n    function Trim(str){\r\n        if(str === undefined){\r\n            return str;\r\n        }\r\n        str = str.replace(/^\\s+|\\s+$/g, '');\r\n        return str;\r\n    }\r\n    var replaceMultipleSpacesWithOne = function(val){\r\n        if(isNotBlank(val)){\r\n            val = val.replace(/ {2,}/g,' ');\r\n        }\r\n        return val;\r\n    };\r\n    function convertBase(value, from_base, to_base) {\r\n  \t  var range = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/'.split('');\r\n  \t  var from_range = range.slice(0, from_base);\r\n  \t  var to_range = range.slice(0, to_base);\r\n  \t  //customization\r\n  \t  value = String(value);\r\n  \t  var dec_value = value.split('').reverse().reduce(function (carry, digit, index) {\r\n  \t    if (from_range.indexOf(digit) === -1) throw new Error('Invalid digit `'+digit+'` for base '+from_base+'.');\r\n  \t    return carry += from_range.indexOf(digit) * (Math.pow(from_base, index));\r\n  \t  }, 0);\r\n  \t  \r\n  \t  var new_value = '';\r\n  \t  while (dec_value > 0) {\r\n  \t    new_value = to_range[dec_value % to_base] + new_value;\r\n  \t    dec_value = (dec_value - (dec_value % to_base)) / to_base;\r\n  \t  }\r\n  \t  return new_value || '0';\r\n  \t}\r\n    var intToBase62 = function(value){\r\n    \tif(isNotBlank(value)){\r\n    \t    /*var converted = (parseInt(value)).toString(36);*/\r\n    \t    var converted = convertBase(value, 10, 62);\r\n            return converted;\r\n    \t}\r\n    \telse{\r\n    \t\tconsole.log('Error in intToBase62() value=',value);\r\n    \t\treturn null;\r\n    \t}\r\n    };\r\n</script>\r\n    <link rel=\"stylesheet\" href=\"https://assets2.teacheron.com/resources/assets/customPlugin/select2/select2.min.css?t=1794067260024\">\r\n    \r\n    <link href=\"https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css\" rel=\"stylesheet\">\r\n    <style>\r\n    \t/* For making the icons look equally spaced in the sidebar */\r\n    \t.fixed-icon-margin{\r\n    \t\tmargin-right: 5px;\r\n\t\t    width: 23px;\r\n    \t}\r\n\r\n    \t/* to make visible subject auto-complete */\r\n        .ui-autocomplete {\r\n            z-index: 9999 !important;\r\n        }\r\n\r\n        /*This is for alignment when 2 text box used together.*/\r\n\t\t.select2-container{\r\n\t\t\tvertical-align:top;\r\n\t\t}\r\n        /*.item {\r\n            padding: 10px;\r\n        }*/\r\n        \r\n        /* .select2-selection__rendered small{\r\n        \tdisplay:none;\r\n        } */\r\n\r\n        .tutor-video-play-icon {\r\n            position: absolute;\r\n            bottom: 50%;\r\n            right: 50%;\r\n            margin: 0px -17px -12px 0px;\r\n            color: white;\r\n            display: flex;\r\n            align-items: center;\r\n            border-radius: 5px;\r\n            z-index: 2;\r\n            background-color: rgba(0, 0, 0, 0.5);\r\n            box-shadow: 0 0 15px rgba(0,0,0,0.75);\r\n            width: 1em;\r\n            height: 1em;\r\n            font-size: 2em;\r\n            padding-left: 1px\r\n        }\r\n    </style>\r\n    <meta property=\"og:url\"        content=\"\" />\r\n    <meta property=\"og:title\"              content=\"\" />\r\n    <meta property=\"og:description\"        content=\"\" />\r\n    <meta property=\"og:image\"              content=\"\" />\r\n    <meta property=\"og:type\"               content=\"profile\" />\r\n\r\n    \r\n    <meta name=\"_csrf\" content=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n    <meta name=\"_csrf_header\" content=\"X-XSRF-TOKEN\"/>\r\n    \r\n</head>\r\n\r\n<body>\r\n<div class=\"wrapper\">\r\n    <!--=== Header ===-->\r\n   \t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<style>\r\n    .img-teacheron-cart{\r\n        height: 22px;\r\n        width: 32px;\r\n    }\r\n    .img-teacheron{\r\n        height: 32px;\r\n        width: 32px;\r\n    }\r\n\r\n    /* 09-Apr-26: Added new design to show alert danger */\r\n    .alert-warning-banner {\r\n        padding: 12px 20px;\r\n        border-left: 4px solid #e74c3c;\r\n        background: #fff5f5;\r\n        border-radius: 4px;\r\n        color: #e74c3c;\r\n        font-weight: 500;\r\n    }\r\n    .alert-warning-text-color{\r\n        color:#e74c3c;\r\n        font-weight:500;\r\n    }\r\n    /* Yellow variant */\r\n    .alert-warning-banner.alert-yellow {\r\n        border-left-color: #f0a500;\r\n        background: #fffdf0;\r\n        color: #7d5a00;\r\n    }\r\n</style>\r\n\r\n\r\n\r\n\r\n<!-- ==== TOP BAR RELATED CODE cSTART ==== -->\r\n\r\n<noscript>\r\n    <div class=\"alert alert-danger fade in\">\r\n        <strong>JavaScript is turned off in your web browser. Please turn it on to use the teacherOn.com</strong>\r\n    </div>\r\n</noscript>\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\"hidden clsProfileSubmittedForReview\">\r\n    <div class=\"alert alert-success text-center\" style=\"padding: 8px;\">\r\n        You profile has been submitted for review.\r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"msgForIE\" style=\"display: none;\">\r\n    <div class=\"alert alert-danger-light text-center no-margin float-center alert-warning-banner\">\r\n        <div style=\"margin: 0 auto;  display: inline-block;\">\r\n            IE browser detected. We recommend you use a modern browser like <a rel=\"noreferrer\" href=\"https://www.google.com/chrome/\" target=\"_blank\">Chrome</a> or <a rel=\"noreferrer\" href=\"https://www.mozilla.org/en-US/firefox/new/\" target=\"_blank\">firefox</a> for the best experience.\r\n            <div class=\"clear-both\"></div>\r\n        </div>\r\n    </div>\r\n    <br/>\r\n</div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\"header\"> <!-- header div start.. will end at the end -->\r\n    <div class=\"container\">\r\n        <a class=\"logo\"\r\n                \r\n                    href=\"https://www.teacheron.com\"\r\n                \r\n                >\r\n            <img src=\"https://assets2.teacheron.com/resources/assets/img/customImages/teacheron-transparent-small.png\" alt=\"Logo\">\r\n        </a>\r\n        <!-- Topbar -->\r\n        <div class=\"topbar\">\r\n\r\n\r\n            <ul class=\"loginbar pull-right list-unstyled\">\r\n                <li class=\"showOnlyInMobile\">\r\n                    <!-- <div class=\"display-inline-block\"> -->\r\n                    <!-- Toggle get grouped for better mobile display -->\r\n                    \r\n                    <button type=\"button\" class=\"navbar-toggle \" id=\"menuForMobileBtnId\" data-toggle=\"collapse\" data-target=\".navbar-responsive-collapse\" style=\"clear: both; float:left;\">\r\n                        <span class=\"sr-only\">Toggle navigation</span>\r\n                        <!-- <span class=\"fas fa-bars\"></span> -->\r\n                        <img alt=\"menu\" src=\"data:image/svg+xml;base64,PHN2ZyBmaWxsPSIjRkZGIiBoZWlnaHQ9IjM2IiB2aWV3Qm94PSIwIDAgMjQgMjQiIHdpZHRoPSIzNiIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cGF0aCBkPSJNMyAxOGgxOHYtMkgzdjJ6bTAtNWgxOHYtMkgzdjJ6bTAtN3YyaDE4VjZIM3oiLz48L3N2Zz4K\" height=\"20px\" width=\"20px\">\r\n                    </button>\r\n                    \r\n                    <!-- End Toggle -->\r\n                    <!-- </div> -->\r\n                </li>\r\n\r\n                <li class=\"showOnlyInMobile\">\r\n                    <!-- Inline logo to be shown only in mobile. -->\r\n                    <a class=\"inlineLogo\"\r\n                            \r\n                       href=\"https://www.teacheron.com\"\r\n                            \r\n                            >\r\n                        <img class=\"hideBelow450\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/teacheron-transparent-small.png?t=1794067260024\" alt=\"Logo\">\r\n                        <div style=\"margin-top: 8px; padding-left: 6px; display:inline-block;\">\r\n                            <img class=\"showBelow450\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/teacheronLogoOnly.png?t=1794067260024\" alt=\"Logo\" style=\"height:30px;\">\r\n                        </div>\r\n                    </a>\r\n                    <!-- End Toggle -->\r\n                </li>\r\n\r\n                <li class=\"floatRightInMobile\">\r\n\r\n                    \r\n              \t<div class=\"showOnlyInMobile\">\r\n\t            \t<div class=\"margin-top-10\">\r\n\t\t            \t<a style=\"color: #687074; border: 1px solid #687074; /* border: none; */ padding: 8px 10px 8px 10px;\" href=\"https://www.teacheron.com/login.html\">Login</a>\r\n                        <a style=\"color: #fff; background-color: #e81c62;/*  margin-left:10px;  */padding: 9px 10px 9px 10px;\" href=\"https://www.teacheron.com/request-a-tutor\">Request tutor</a>\r\n\t\t\t\t\t</div>\r\n              \t</div>\r\n           \r\n            </li>\r\n            </ul>\r\n            <div class=\"clear-both\"></div>\r\n        </div>\r\n        <!-- End Topbar -->\r\n    </div>\r\n    <!--/end container-->\r\n\r\n    <!-- ==== TOP BAR RELATED CODE END ==== -->\r\n\r\n    <!-- ====MENU RELATED CODE START ==== -->\r\n    <!-- Collect the nav links, forms, and other content for toggling -->\r\n    <div class=\"collapse navbar-collapse mega-menu navbar-responsive-collapse margin-bottom-10\">\r\n        <div class=\"container margin-top-10 margin-bottom-20\">\r\n            <ul class=\"nav navbar-nav \"  style=\"margin-top:15px\"    >\r\n                \r\n\r\n                    \r\n\r\n\r\n\r\n\r\n    \r\n\r\n\r\n\r\n                 \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<li class=\"dropdown\">\r\n    <a href=\"/tutors\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">\r\n        Find Tutors\r\n    </a>\r\n    <ul class=\"dropdown-menu\">\r\n        <li><a href=\"https://www.teacheron.com/request-a-tutor\">Request a tutor</a></li>\r\n        <li><a href=\"https://www.teacheron.com/tutors\">All Tutors</a></li>\r\n         <li><a href=\"https://www.teacheron.com/tutors/online-tutors\">Online Tutors</a></li>\r\n         <li><a href=\"https://www.teacheron.com/tutors/home-tutors\">Home Tutors</a></li>\r\n    </ul>\r\n</li>\r\n\r\n<li class=\"dropdown\">\r\n    <a href=\"https://www.teacheron.com/jobs/tutor-jobs\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">\r\n        Find Tutor Jobs\r\n    </a>\r\n    <ul class=\"dropdown-menu\">\r\n        <li><a href=\"https://www.teacheron.com/jobs/tutor-jobs\">All Tutor Jobs</a></li>\r\n        <li><a href=\"https://www.teacheron.com/jobs/online-tutor-jobs\">Online Tutor Jobs</a></li>\r\n        <li><a href=\"https://www.teacheron.com/jobs/home-tutor-jobs\">Home Tutor Jobs</a></li>\r\n    </ul>\r\n</li>\r\n<li><a href=\"https://www.teacheron.com/request-a-tutor?type=assignment\">Assignment help</a></li>\r\n\r\n\r\n\r\n\r\n<li class=\"dropdown hideInMobile\" style=\"margin-left:5px;\">\r\n    <a style=\"color: #fff-; border: 1px solid #16a085; \" href=\"#\" data-target=\"#\" onclick=\"location.href='https://www.teacheron.com/login.html';\" class=\"dropdown-toggle hideDropdownArrow\" data-toggle=\"dropdown\">\r\n        Login\r\n    </a>\r\n    <ul class=\"dropdown-menu \" style=\"margin-left: -50px;\">\r\n\t\t<li class=\"text-center\">\r\n\t\t\t<a class=\"btn btn-primary color-white margin-left-10 margin-right-10 margin-top-10\" style=\"background:#16a085 !important;\" href=\"https://www.teacheron.com/login.html\"> Log in</a>\r\n\t\t\t or \r\n\t\t\t <a class=\"btn btn-primary color-white margin-left-10 margin-right-10  margin-bottom-10\" style=\"background:#cd5c5c!important;\"  href=\"https://www.teacheron.com/login.html?reg=t\"> Sign up</a>\r\n\t\t</li>        \r\n    </ul>\r\n</li>\r\n\r\n<li class=\"showOnlyInMobile\"><a style=\"color: #fff-; border: 1px solid #16a085; border-bottom:none; \" href=\"https://www.teacheron.com/login.html\">Login</a></li>\r\n<li class=\"showOnlyInMobile\"><a style=\"color: #fff-; border: 1px solid #16a085; border-top:none; margin-bottom: 5px; \" href=\"https://www.teacheron.com/login.html?reg=t\">Sign up</a></li>\r\n<li><a class=\"goPremiumMenuLink\" style=\";\"  href=\"https://www.teacheron.com/request-a-tutor\">Request a tutor</a></li>\r\n<!-- style=\"color: #fff; background-color: #e81c62; margin-left:20px;\" -->\r\n\r\n\r\n\r\n                \r\n            </ul>\r\n        </div><!--/end container-->\r\n    </div><!--/navbar-collapse-->\r\n    <!-- ====MENU RELATED CODE END ==== -->\r\n</div> <!-- header div end -->\r\n    \n<div class=\"modal fade autoWidthModal wordBreak in\" id=\"autoCorrectPhoneNumberModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\" style=\"\">\n        <div class=\"modal-content\" style=\"max-width: 400px;\">\n            <div class=\"modal-header\">\n                <p class=\"modal-title\">Invalid phone</p>\n            </div>\n            <div class=\"modal-body stripeBg\">\n                <p><span id=\"m_wrongPhoneNumber\"></span> is invalid.</p>\n                <p>Do you mean</p><p><span id=\"m_autoCorrectedPhoneNumber\"></span></p>\n                <span id=\"m_autoCorrectedPhoneNumberWithoutCode\" style=\"display: none\"></span>\n            </div>\n            <div class=\"modal-footer\">\n                <div class=\"text-right\">\n                    <button type=\"button\" class=\"btn btn-default btn-brd clsCloseButtonOfCorrectPhoneModel\" data-dismiss=\"modal\">No</button>\n                    <button type=\"button\" class=\"btn btn-primary clsBtnCorrectPhoneNumber\">Yes</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<script>\n    function setValueToInvalidPhoneModelAndOpenIt(phoneCode, obj, currentEnteredPhone){\n        $(\"#m_autoCorrectedPhoneNumber\").html(\"+\"+phoneCode+\"-\"+obj.newPhoneNumber);\n        // hidden phone number used to correct user phone.\n        $(\"#m_autoCorrectedPhoneNumberWithoutCode\").html(obj.newPhoneNumber);\n        $(\"#m_wrongPhoneNumber\").html(\"+\"+phoneCode+\"-\"+currentEnteredPhone);\n        openModalCommon('autoCorrectPhoneNumberModal');\n    }\n\n    function closeInvalidPhoneAutoCorrectModel(){\n        closeModalCommon('autoCorrectPhoneNumberModal');\n    }\n</script>\r\n\r\n    \r\n    \r\n    \n\n\n\n\n\n\n\n\n\n<!-- add popup for contact tutor success message -->\n<div class=\"modal small fade\" id=\"contactTutorSuccessMsgDiv\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n                <h4 class=\"modal-title\"> Please check your email to send message.</h4> <br/>\n                <button type=\"button\" class=\"btn-u btn-u-blue\" data-dismiss=\"modal\">Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- END -->\n\n\n\n\n<div id=\"pleaseWaitModal\" class=\"modal fade bs-example-modal-sm\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"mySmallModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-sm\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <button aria-hidden=\"true\" data-dismiss=\"modal\" class=\"close\" type=\"button\">x</button>\n                <h4 id=\"myLargeModalLabel3\" class=\"modal-title\">Loading form..</h4>\n            </div>\n            <div class=\"modal-body\">\n                <p>Slow internet :( <br>Please wait. Trying my best.</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<!-- Added error modal if tutor account already exists -->\n<div class=\"modal small fade\" id=\"emailErrorModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n                <h4 class=\"modal-title clsEmailErrorMsg\"></h4> <br/>\n                <span id=\"dynamicButtonForEmailError\"></span>\n                <button type=\"button\" class=\"btn btn-default\" data-dismiss=\"modal\">Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- END -->\n\n<!-- ************** Common msg modal (use this modal for all kind of messages) ****************  -->\n<div class=\"modal fade autoWidthModal wordBreak\" id=\"commonMsgModal\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n                <h3 class=\"modal-title text-center\" id=\"commonMsgModalTitle\">Dynamic title here</h3>\n            </div>\n            <div class=\"modal-body\">\n                <span id=\"commonMsgModalMsgBody\">Dynamic msg here</span>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<!-- ******************************** Subject Add Popup Form START ***********************************  -->\n<div class=\"modal fade\" id=\"subjectAddModel\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\" style=\"max-width: 400px\">\n        <form action=\"\" id=\"subjectAddPopupForm\" class=\"sky-form\" method=\"post\">\n            <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\" onclick=\"hideSubjectAddForm();\">&times;</button>\n                    <h4 class=\"modal-title\" id=\"myModalLabel\"> Add a new Subject here</h4>\n                </div>\n                <div class=\"modal-body\">\n                    <div class=\"row\">\n                        <div class=\"col-md-12\">\n                            <section>\n                                <label class=\"label\"> Subject Name </label>\n                                <div class=\"color-red\"><b>Please add only one subject at a time.</b></div>\n                                <label class=\"input\">\n                                    <input type=\"text\" class=\"remove-comma\" maxlength=\"100\" name=\"subjectName_add\" id=\"subjectName_add\" onblur=\"trimAndUpdateFieldVal('subjectName_add');\" onkeydown=\"return (event.keyCode!=13);\"/>\n                                </label>\n                            </section>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"modal-footer\">\n                    <button type=\"button\" class=\"clsAddNewSubject btn-u btn-brd btn-u-default\" data-dismiss=\"modal\" onclick=\"hideSubjectAddForm();\">Cancel</button>\n                    <button type=\"button\" class=\"clsAddNewSubject btn-u btn-u-blue\" id=\"btnSubjectSave\"> Save </button>\n                    <img id=\"imgLoaderAddNewSubject\" style=\"display: none;\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>\n                </div>\n            </div>\n        </form>\n    </div>\n</div>\n<!-- ******************************** Subject Add Popup Form  END***********************************  -->\n\n\n<div class=\"modal fade autoWidthModal wordBreak\" id=\"acceptTermsToShareContactModal\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <div class=\"modal-header\">\n                <h3 class=\"modal-title text-center\">Please read. It's important.</h3>\n            </div>\n            <div class=\"modal-body\">\n                <div>\n                    <p style=\"display: none\" id=\"acceptTermsAndCondTutorPhnNotVerified\"><b>This tutor's phone is not verified. IT MAY BE WRONG.</b></p>\n                    <p id=\"acceptTermsAndCondDeductCoinMsg\" style=\"display: none\"> <b>50 coins will be deducted</b> to contact this tutor.</p>\n                    <p>Please read our tips on how to <a target=\"_blank\" href=\"/stay-safe\">stay safe</a>.</p>\n                    <p>By contacting this tutor, you agree to our <a target=\"_blank\" href=\"/terms-and-conditions\">terms and conditions</a>.</p>\n                    <div id=\"studentContactDetailsDiv\" style=\"display: none\">\n                        <p>Following details will be shared with the tutors you will contact:</p>\n                        <ul id=\"studentContactDetailsToBeShared\" class=\"list-unstyled vertical-list margin-top-10 margin-left-10-\">\n\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"text-center\">\n                    <button type=\"submit\" id=\"btnAcceptToShowContact\" style=\"display: none\" class=\"btn-u btn-u-blue rounded\" onclick=\"acceptedToShowStudentContact();\">Accept</button>\n                    <button type=\"submit\" id=\"btnAcceptToSendMsg\" style=\"display: none\" class=\"btn-u btn-u-blue rounded\" onclick=\"acceptedToSendMessage();\">Accept</button>\n                    <button type=\"button\" class=\"btn-u btn-u-red rounded\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">Reject</button>\n                    <!-- delete this later after June 19 -->\n                    \n                </div>\n            </div>\n        </div>\n    </div>\n</div>\r\n    \n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n  \n    <div class=\" col-md-12 margin-top-20\">\n      <blockquote class=\"tag-box-v2 text-center\">\n        <p><em>This profile has been deleted.</em></p>\n      </blockquote>\n    </div>\n  \n\n  \n\n  \n\n  \n\r\n   \r\n\r\n    <style>\r\n        .pac-container{\r\n            max-width: 100%;\r\n        }\r\n    </style>\r\n\r\n    <div class=\"modal fade scrollableModal\" id=\"contactTutorModel\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog\">\r\n            <div class=\"modal-content\" style=\"max-width:600px; margin: 0 auto;\">\r\n\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\r\n                    \r\n                    <h3 class=\"modal-title\" id=\"headerTitle\">Contact </h3>\r\n                </div>\r\n\r\n                <div class=\"modal-body\">\r\n                    <div class=\"row\">\r\n                        <form method=\"POST\" id=\"postRequirementForm\" action=\"javascript:void(0);\" enctype=\"multipart/form-data\" class=\"sky-form\" role=\"form\">\r\n                            <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n                            <input type=\"hidden\" name=\"id\" id=\"id\" value=\"\"/>\r\n                            <input type=\"hidden\" name=\"userId\" id=\"userId\" value=\"\"/>\r\n                            \r\n                            <input type=\"hidden\" name=\"address_2\" id=\"address_2\"/>\r\n                            <input type=\"hidden\" name=\"address_json\" id=\"address_json\"/>\r\n                            <!-- Added autocomplete=\"off\" so that it can not populate using chrome auto form fill. -->\r\n                            <input type=\"hidden\" name=\"lat\" id=\"lat\" value=\"\" autocomplete=\"off\"/>\r\n                            <input type=\"hidden\" name=\"lng\" id=\"lng\" value=\"\" autocomplete=\"off\"/>\r\n                            <input type=\"hidden\" name=\"region_lat\" id=\"region_lat\" value=\"\" autocomplete=\"off\"/>\r\n                            <input type=\"hidden\" name=\"region_lng\" id=\"region_lng\" value=\"\" autocomplete=\"off\"/>\r\n                            <input type=\"hidden\" name=\"placeId\" id=\"placeId\" value=\"\" autocomplete=\"off\"/>\r\n                            <input type=\"hidden\" name=\"countryShortCode\" id=\"countryShortCode\"/>\r\n                            <input type=\"hidden\" name=\"countryName\" id=\"countryName\"/>\r\n                            <input type=\"hidden\" name=\"post_region_distance\" id=\"post_region_distance\"/>\r\n\r\n                            <input type=\"hidden\" name=\"locationCsv\" id=\"locationCsv\" value=\"\"/>\r\n                            <input type=\"hidden\" name=\"countryId\" id=\"countryId\" value=\"\"/>\r\n\r\n                            <input type=\"hidden\" name=\"distanceUnit\" id=\"distanceUnit\"/>\r\n                            <input type=\"hidden\" name=\"formattedAddress\" id=\"formattedAddress\"/>\r\n                            <input type=\"hidden\" name=\"googleLocationUIResponseJson\" id=\"googleLocationUIResponseJson\"/>\r\n\r\n                            <!-- additional field -->\r\n                            <input type=\"hidden\" name=\"contactTutorEncy\" id=\"contactTutorEncy\" value=\"\"/>\r\n                            <input type=\"hidden\" name=\"jobType\" id=\"jobType\"/>\r\n\r\n                            \r\n                            \r\n                            \r\n                            \r\n\r\n\r\n                            <input type=\"hidden\" name=\"tutContactSeenCount\" id=\"tutContactSeenCount\"/>\r\n                            <!-- added for country tutor + budget option flow -->\r\n                            <input type=\"hidden\" name=\"isPoor\" id=\"isPoor\"/>\r\n                            <!-- end -->\r\n\r\n                            \r\n                            <input type=\"hidden\" name=\"sharedContactLog\" id=\"sharedContactLog\"/>\r\n\r\n                            \r\n                            \r\n\r\n                                <div class=\"col-md-12\">\r\n                                    \n\n<script>\n  var currentScreenFlow = null;\n  const CALLING_FLOW_POST_REQUIREMENT = \"PostRequirement\";\n  const CALLING_FLOW_CONTACT_TUTOR = \"ContactTutor\";\n</script>\n\n<script src=\"https://accounts.google.com/gsi/client\" async defer></script>\n\n<div class=\"clsContinueWithGoogleOrEmailMainDiv text-center\">\n  <!-- Standard Google Sign-in Button -->\n  <div id=\"g_id_onload\"\n       data-client_id=\"952159028206-3n6sbirflu4heff5n3ha54ct7mvgo6e3.apps.googleusercontent.com\"\n       data-context=\"signin\"\n       data-ux_mode=\"popup\"\n       data-callback=\"handleCredentialResponse\"\n       data-auto_prompt=\"false\">\n  </div>\n\n  <div>\n    <div class=\"g_id_signin display-inline-block\"\n         data-type=\"standard\"\n         data-shape=\"rectangular\"\n         data-theme=\"outline\"\n         data-text=\"continue_with\"\n         data-size=\"large\"\n         data-logo_alignment=\"left\">\n    </div>\n  </div>\n\n  <!-- Custom Google Sign-in Button (Alternative), Not required. -->\n  \n  <div>\n    \n    <a class=\"btn btn-primary rounded clsContinueWithEmailBtn margin-top-10 color-white\" style=\"/* text-align: left!important; */font-size: .97em;/* height: 40px; *//* padding: 5px 16px 0 8px; */box-shadow: none;\">\n        <span><i class=\"fas fa-envelope hidden-\" style=\"width: 22px;/* font-size: 24px; *//* position: relative; */top: 4px;left: 5px;\"></i> Continue with Email</span>\n    </a>\n  </div>\n</div>\n\n<script>\n\n  async function validateGoogleSecretAndGetUserData(secret){\n    var submitUrl = \"https://www.teacheron.com/api/user/fetchUserFromGoogleAccessToken\";\n    // Create the JSON object\n    const payloadGoogleData = {\n      accessToken: secret,\n      callingFrom: \"PostRequirement\"\n    };\n\n    // Convert object to JSON string\n    const jsonString = JSON.stringify(payloadGoogleData);\n    const obj = await sendAjaxPostJsonRequest(submitUrl, jsonString, true, null);\n    if(obj.status == 'SUCCESS'){\n      if(isNotBlank(obj.action)){\n        if(obj.action=='RefreshPage'){\n          // user logged-in at this point and data are available in the session, reload the page.\n          window.location.reload();\n        } else if(obj.action=='register'){\n          if(currentScreenFlow==CALLING_FLOW_POST_REQUIREMENT){\n            // show form and prefilled email and name.\n            $(\"#email\").val(obj.email);\n            $(\"#name\").val(obj.name);\n            $(\".clsContinueWithGoogleOrEmailMainDiv\").hide();\n            $(\".clsHideForGoogleLogin\").show();\n            continue_step_1(); // Call this button so that it can show next field (name and phone) after email.\n          } else if(currentScreenFlow==CALLING_FLOW_CONTACT_TUTOR){\n            $(\"#email\").val(obj.email);\n            $(\"#name\").val(obj.name);\n            $(\".clsContinueWithGoogleOrEmailMainDiv\").hide();\n            $(\".clsHideForGoogleLogin\").show();\n          }\n        }\n      } // action check end\n      // TODO - Handle other case e.g. banned, account delete etc\n    }\n  }\n\n  // Function to handle Google credential response\n  async function handleCredentialResponse(response) {\n    // Decode the JWT token\n    /* const payload = parseJwt(response.credential);\n    console.log(\"ID: \" + payload.sub);\n    console.log(\"Email: \" + payload.email);\n    console.log(\"Name: \" + payload.name);*/\n\n    await validateGoogleSecretAndGetUserData(response.credential);\n\n    // Here you would typically:\n    // 1. Send this token to your server\n    // 2. Verify the token on your server\n    // 3. Create a session or JWT for your app\n    // 4. Redirect the user to your app's authenticated area\n  }\n\n  // Function to parse JWT token\n  function parseJwt(token) {\n    const base64Url = token.split('.')[1];\n    const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');\n    const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {\n      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);\n    }).join(''));\n\n    return JSON.parse(jsonPayload);\n  }\n\n  // If you want to show your custom button instead of Google's standard button\n  document.addEventListener('DOMContentLoaded', function() {\n    // Uncomment these lines to use your custom button instead of Google's standard one\n    // document.querySelector('.g_id_signin').style.display = 'none';\n    // document.getElementById('custom-google-btn').style.display = 'flex';\n\n    // Add click handler for custom button\n   /* document.getElementById('custom-google-btn').addEventListener('click', function() {\n      // Trigger Google Sign-in\n      google.accounts.id.prompt();\n    });*/\n  });\n</script>\n\n<script>\n  function waitForJQueryLoginWithGoogleOrEmailFlow(callback) {\n    if (typeof jQuery !== 'undefined') {\n      // jQuery is already loaded, execute callback immediately\n      callback();\n    } else {\n      // Check again after a short delay\n      setTimeout(function() {\n        waitForJQueryLoginWithGoogleOrEmailFlow(callback);\n      }, 100);\n    }\n  }\n\n  // Usage example:\n  waitForJQueryLoginWithGoogleOrEmailFlow(function() {\n    // Your code that depends on jQuery goes here\n    console.log(\"jQuery is now available!\");\n\n    // Example: Now you can safely use jQuery\n    jQuery(document).ready(function() {\n       $(\".clsContinueWithEmailBtn\").on(\"click\", function(){\n           if(currentScreenFlow==CALLING_FLOW_POST_REQUIREMENT){\n             $(\".clsContinueWithGoogleOrEmailMainDiv\").hide();\n             // show hidden fields for guest user e.g. email field.\n             $(\".clsHideForGoogleLogin\").show();\n           } else if(currentScreenFlow==CALLING_FLOW_CONTACT_TUTOR){\n             $(\".clsContinueWithGoogleOrEmailMainDiv\").hide();\n             // show hidden fields for guest user e.g. email field.\n             $(\".clsHideForGoogleLogin\").show();\n             $(\"#headerTitle\").html(\"My Email\");\n           }\n       });\n    });\n  });\n</script>\n\r\n                                    <script>currentScreenFlow = CALLING_FLOW_CONTACT_TUTOR;</script>\r\n                                </div>\r\n\r\n\r\n                                <div class=\"col-md-12 clsHideForGoogleLogin\" id=\"user_email_div\" style=\"display: none\">\r\n                                    <section>\r\n                                        <label class=\"label asterisk_required hidden\">Email</label>\r\n                                        <label class=\"input\">\r\n                                                \r\n                                            <input  data-hj-whitelist type=\"text\" maxlength=\"80\" name=\"email\" id=\"email\" value=\"\"/>\r\n                                            <span id=\"emailErrorMsg\" class=\"custom-form-validation-error\"></span>\r\n                                        </label>\r\n                                    </section>\r\n\r\n                                    <section>\r\n                                        <button type=\"button\" class=\"btn-u btn-u-primary btn-u-blue\" onclick=\"triggerValidation('location_div','user_email_div');\" data-focus=\"#autocomplete\">Continue</button>\r\n                                    </section>\r\n                                </div>\r\n                            \r\n\r\n                            \r\n                            <div class=\"col-md-12\" id=\"location_div\" style=\"display:none;\">\r\n                                <section>\r\n                                    <div class=\"input\">\r\n                                        <input data-hj-whitelist id=\"autocomplete\" type=\"text\" name=\"inputLocationName\" class=\"form-control tooltips\"\r\n                                         data-toggle=\"tooltip\" data-placement=\"top\"\r\n                                               title=\"Please select your location from the suggested options\" onkeyup=\"clearLocationData(event.keyCode);\" autocomplete=\"off\" onkeydown=\"return (event.keyCode!=13);\">\r\n                                    </div>\r\n                                    <div class=\"clear-both\"></div>\r\n                                    <div id=\"wrongLocationNameErrorDiv\" class=\"\" style=\"display: none\">\r\n                                        <div class=\"alert alert-danger-light\" id=\"locationErrorMsg\" style=\"display: inline-block;\">  </div>\r\n                                        <div class=\"clear-both\"></div>\r\n                                    </div>\r\n                                </section>\r\n\r\n                                <div class=\"clear-both\"></div>\r\n\r\n                                <section>\r\n                                    <button type=\"button\" class=\"btn-u btn-u-primary  btn-u-blue\" onclick=\"triggerValidation('contact_details_div','location_div');setModelTitle('contactDtl');\"  data-focus=\"#name\">Continue</button>\r\n                                    \r\n                                        <a href=\"javascript:void(0);\" onclick=\"setModelTitle('email')\" data-hide-slide-up=\"#location_div\" data-show-slide-down=\"#user_email_div\" data-focus=\"#email\" >Back</a>\r\n                                    \r\n                                </section>\r\n                            </div>\r\n\r\n\r\n                            <div class=\"col-md-12\" id=\"contact_details_div\" style=\"display:none;\">\r\n                                \r\n                                    <section>\r\n                                        <label class=\"label asterisk_required\">Name</label>\r\n                                        <label class=\"input\">\r\n                                            <input data-hj-whitelist type=\"text\" maxlength=\"50\" name=\"name\" id=\"name\" onblur=\"validateName();\" value=\"\"/>\r\n                                        </label>\r\n                                        <span style=\"display: none\" id=\"nameErrorMsg\" class=\"custom-form-validation-error\"></span>\r\n                                    </section>\r\n                                \r\n\r\n                                <section>\r\n                                    <label class=\"label asterisk_required\">Phone</label>\r\n                                    <div class=\"input-- row\">\r\n                                        <div class=\"col-sm-12 no-gutter-\">\r\n                                            <style>#userPhoneCountryId{width:150px !important;}</style>\r\n                                            <div class=\"phoneCodeDiv\" >\r\n                                                <span>\r\n\r\n                                                    <select id=\"userPhoneCountryId\" name=\"userPhoneCountryIdTmp\" class=\"ts-custom-phone-code vertical-align-middle\"></select>\r\n                                                    \r\n                                                    <input type=\"hidden\" id=\"userPhoneCountryIdHidden\" name=\"userPhoneCountryId\"/>\r\n                                                    <span style=\"display: none\" id=\"phoneCodeLoader\"> <img src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>  </span>\r\n                                                </span>\r\n                                            </div>\r\n                                            <div class=\"phoneDivAfterPhoneCode\">\r\n                                                \r\n                                                <span><input data-hj-whitelist id=\"phone\" maxlength=\"18\" type=\"text\" name=\"phone\" placeholder=\"Number\" class=\"form-control col-sm-8 numbers-only\" value=\"\" style=\"\" inputmode=\"numeric\"></span>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </section>\r\n\r\n                                <section>\r\n                                    <button type=\"button\" class=\"btn-u btn-u-primary btn-u-blue\" onclick=\"triggerValidation('summary_description_div','contact_details_div');setModelTitle('myReq')\"  data-focus=\"#description\"  >Continue</button>\r\n                                    \r\n                                    <a href=\"javascript:void(0);\" onclick=\"setModelTitle('loc')\" data-hide-slide-up=\"#contact_details_div\" data-show-slide-down=\"#location_div\" data-focus=\"#autocomplete\" >Back</a>\r\n                                    \r\n                                </section>\r\n                            </div>\r\n\r\n\r\n                            <div class=\"col-md-12\" id=\"summary_description_div\" style=\"display:none;\">\r\n                                <section>\r\n                                    \r\n                                    <label class=\"textarea\">\r\n                                        <textarea data-hj-whitelist id=\"description\" name=\"description\" rows=\"4\"></textarea>\r\n                                    </label>\r\n                                </section>\r\n\r\n                                <section>\r\n                                    <button type=\"button\" class=\"btn-u btn-u-primary  btn-u-blue\" onclick=\"triggerValidation('assignment_tutoring_div','summary_description_div');readDescAndFindSubjects();setModelTitle('helpMeWith');\"  data-focus=\"#assignment_tutoring_div\">Continue</button>\r\n                                    <a href=\"javascript:void(0);\" onclick=\"setModelTitle('contactDtl');\" data-hide-slide-up=\"#summary_description_div\" data-show-slide-down=\"#contact_details_div\" data-focus=\"#name\" >Back</a>\r\n                                </section>\r\n                            </div>\r\n\r\n\r\n                            <div class=\"col-md-12 text-center\" id=\"assignment_tutoring_div\" style=\"display:none;\">\r\n                                <a href=\"javascript:void(0);\" data-hide-slide-up=\"#assignment_tutoring_div\" onclick=\"setModelTitle('myReq')\" data-show-slide-down=\"#summary_description_div\" data-focus=\"#title\" class=\"float-left hidden\" >Back</a>\r\n\r\n                                \r\n                                <button type=\"button\" class=\"btn-u btn-u-primary btn-u-blue margin-right-20\" onclick=\"triggerValidation('tutoring_options_div','assignment_tutoring_div');setModelTitle('tutOptions');setJobType('Tutoring');setJobTypeFields('Tutoring');\" >Tutoring</button>\r\n                                <button type=\"button\" class=\"btn-u btn-u-primary\"  onclick=\"triggerValidation('tutoring_options_div','assignment_tutoring_div');setModelTitle('tutOptions');setJobType('Assignment_help');setJobTypeFields('Assignment_help');\" >Assignment help</button>\r\n                            </div>\r\n                            <div class=\"col-md-12 \" id=\"tutoring_options_div\" style=\"display:none;\">\r\n                                \r\n                                <div class=\"text-left\" id=\"tutoringCbxErrorDiv\">\r\n                                    <div class=\"checkbox\"><label class=\"no-padding\"><input type=\"checkbox\" onclick=\"hideCbxError();showOrHideGetTutorFromOption();\" name=\"cbxOnlineTutoring\" id=\"cbxOnlineTutoring\" class=\"tutoring-options-group\"><i></i>Online tutoring (using Skype etc)</label></div>\r\n                                    <div class=\"checkbox\"><label class=\"no-padding\"><input type=\"checkbox\" onclick=\"hideCbxError();\" name=\"cbxHomeTutoring\" id=\"cbxHomeTutoring\" class=\"tutoring-options-group\"><i></i>In my home </label></div>\r\n                                    <div class=\"checkbox\"><label class=\"no-padding\"><input type=\"checkbox\" onclick=\"hideCbxError();\" name=\"cbxWillingToTravel\" id=\"cbxWillingToTravel\" class=\"tutoring-options-group\" onclick=\"\" data-hide=\"#continue_to_subjects\" data-show=\"#continue_travel_options_btn\"><i></i>Travel to tutor</label></div>\r\n\r\n                                    <div class=\"\" id=\"cbxErrorDiv\" style=\"display: none;\">\r\n                                        <span class=\"alert alert-danger padding-5 \">Please select at least one option.</span>\r\n                                    </div>\r\n                                </div>\r\n                                <button type=\"button\" class=\"btn-u btn-u-primary btn-u-blue margin-top-20\" onclick=\"triggerValidation('subjects_div','tutoring_options_div');setModelTitle('subjects');\"  id=\"continue_to_subjects\" >Continue</button>\r\n                                <button type=\"button\" class=\"btn-u btn-u-primary btn-u-blue margin-top-20\" onclick=\"triggerValidation('travel_options_div','tutoring_options_div');setModelTitle('canTravel');\"  id=\"continue_travel_options_btn\" style=\"display:none;\">Continue</button>\r\n                                <a href=\"javascript:void(0);\" data-hide-slide-up=\"#tutoring_options_div\" onclick=\"setModelTitle('helpMeWith')\" data-show-slide-down=\"#assignment_tutoring_div\" >Back</a>\r\n\r\n                            </div>\r\n                            <div class=\"col-md-12 \" id=\"travel_options_div\" style=\"display:none;\">\r\n                                <div class=\"radio\"><label class=\"no-padding\"><input type=\"radio\" id=\"travelDistance_2\" name=\"travelDistance\" value=\"2\" ><i></i>2 km</label></div>\r\n                                <div class=\"radio\"><label class=\"no-padding\" ><input type=\"radio\" id=\"travelDistance_5\" name=\"travelDistance\" value=\"5\" ><i></i>5 km</label></div>\r\n                                <div class=\"radio\"><label class=\"no-padding\"><input type=\"radio\" id=\"travelDistance_10\" name=\"travelDistance\" value=\"10\" ><i></i>10 km</label></div>\r\n                                <div class=\"radio\"><label class=\"no-padding\"><input type=\"radio\" id=\"travelDistance_15\" name=\"travelDistance\" value=\"15\" ><i></i>15 km</label></div>\r\n                                <div class=\"radio\"><label class=\"no-padding\"><input type=\"radio\" id=\"travelDistance_20\" name=\"travelDistance\" value=\"20\" ><i></i>20 km</label></div>\r\n                                <div class=\"radio\"><label class=\"no-padding\"><input type=\"radio\" id=\"travelDistance_30\" name=\"travelDistance\" value=\"30\" ><i></i>30 km</label></div>\r\n                                <button type=\"button\" class=\"btn-u btn-u-primary  btn-u-blue\" onclick=\"triggerValidation('subjects_div','travel_options_div');setModelTitle('subjects')\" data-focus=\"#subjectIds\">Continue</button>\r\n                                <a href=\"javascript:void(0);\" data-hide-slide-up=\"#travel_options_div\" onclick=\"setModelTitle('tutOptions')\" data-show-slide-down=\"#tutoring_options_div\" >Back</a>\r\n                            </div>\r\n\r\n                            <div class=\"col-md-12 \" id=\"subjects_div\" style=\"display:none;\">\r\n\r\n                                <div class=\"form-group\" id=\"suggestedSubjectsDiv\" style=\"display: none\">\r\n                                    <label for=\"\" class=\"col-sm-3- control-label \"></label>\r\n                                    <div class=\"col-sm-9-\">Suggested subjects:\r\n                                        <ul class=\"list-inline up-ul\"><li class=\"no-padding\"><ul class=\"list-inline up-ul tags-v2 clsAppendSuggestedSubject\">\r\n                                            \r\n                                        </ul></li></ul>\r\n                                    </div>\r\n                                </div>\r\n\r\n                                <section class=\"no-margin-bottom\">\r\n                                    <label class=\" hidden label asterisk_required\"><a href=\"javascript:void(0);\" onclick=\"openSubjectAddModel();\">Can't find you subject? Add a new subject</a></label>\r\n                                    \r\n                                    <select style=\"width: 100%\" data-toggle=\"tooltip\" id=\"subjectIds\" name=\"subjectIds\" class=\"subject-search-autocomplete tooltips\" multiple=\"multiple\"> </select>\r\n                                </section>\r\n                                \r\n                                \r\n                                <section class=\"margin-top-20\">\r\n                                    <button type=\"button\" class=\"btn-u btn-u-primary  btn-u-blue\" id=\"\" onclick=\"triggerValidation('additional_options_div','subjects_div');setModelTitle('optionalInfo');\"  data-focus=\"name\">Continue</button>\r\n                                    <a href=\"javascript:void(0);\" data-hide-slide-up=\"#subjects_div\" onclick=\"setModelTitle('helpMeWith');\" data-show-slide-down=\"#assignment_tutoring_div\" >Back</a>\r\n                                </section>\r\n                            </div>\r\n\r\n                            <div class=\"col-md-12\" id=\"additional_options_div\" style=\"display:none;\">\r\n\r\n                                <section class=\"clsJobLevel\">\r\n                                    <label class=\"label\">Your level</label>\r\n                                    <label class=\"select\">\r\n                                        <select name=\"levelId\" id=\"levelId\">\r\n                                            <option value=\"\"> -- Select Level -- </option>\r\n                                            \r\n                                        </select>\r\n                                        <i></i>\r\n                                    </label>\r\n                                </section>\r\n\r\n                                <section>\r\n                                    <label class=\"label\">Budget</label>\r\n                                    <span>\r\n                                    <label class=\"input moneyinput float-left\">\r\n                                        <i class=\"icon-prepend\"><span id=\"currencyFormat\">USD</span></i>\r\n                                        <input data-hj-whitelist maxlength=\"12\" id=\"budget\" onkeyup=\"convertCurrency(this.value);\" onchange=\"convertCurrency(this.value);\" type=\"text\" name=\"budget\" style=\"max-width: 150px;\" class=\"currency-only form-control width-auto-\" autocomplete=\"off\" inputmode=\"numeric\">\r\n                                        <span id=\"currencyInUsdDiv\" class=\"hidden\"></span>\r\n                                        <input data-hj-whitelist id=\"budgetInDollar\" type=\"hidden\" name=\"budgetInDollar\">\r\n                                    </label>\r\n                                </span>\r\n                                    <span>\r\n                                    <label class=\"select- float-left margin-left-5\">\r\n                                    <span>\r\n                                        <select name=\"budgetType\" id=\"budgetType\" class=\"form-control width-auto\" >\r\n                                            <option value=\"\"></option>\r\n                                            \r\n                                        </select>\r\n                                        <i></i>\r\n                                    </span>\r\n                                    </label>\r\n                                </span>\r\n\r\n                                </section>\r\n\r\n                                <div class=\"clear-both\"></div>\r\n                                <section id=\"associationDiv\" style=\"display: none\" class=\"margin-top-20\">\r\n                                    <label class=\"label\">Association</label>\r\n                                    <label class=\"select\">\r\n                                        <select name=\"association\" id=\"association\" class=\"form-control\">\r\n                                            \r\n                                        </select>\r\n                                        <i></i>\r\n                                    </label>\r\n                                </section>\r\n\r\n                                <!-- **************** Contact option div **************** -->\r\n                                <div class=\"clear-both\"></div>\r\n                                <section id=\"contactOptionDiv\" class=\"margin-top-20\">\r\n                                    <label class=\"label\"> Make my requirements visible to other tutors?</label>\r\n                                    <label class=\"select\">\r\n                                        <select name=\"isPublicStudent\" id=\"isPublicStudent\" onchange=\"showOrHideGetTutorFromOption();\" class=\"form-control- col-sm-12-\">\r\n                                            <option value=\"\">-- Please select --</option>\r\n                                            <option value=\"1\">Yes - Let other teachers contact me</option>\r\n                                            <option value=\"0\">No - Keep my request private</option>\r\n                                        </select>\r\n                                        <i></i>\r\n\r\n                                    </label>\r\n                                </section>\r\n\r\n                                <!-- **************** Interactive language **************** -->\r\n                                <div class=\"clear-both\"></div>\r\n                                <section class=\"margin-top-10\">\r\n                                    <label class=\"label\">I can communicate with the tutor in (languages)</label>\r\n                                    <select style=\"width: 100%\" data-toggle=\"tooltip\" id=\"interactionLanguageCsv\" name=\"interactionLanguageCsv\"\r\n                                            class=\"subject-as-language--discarded tooltips\" multiple=\"multiple\">\r\n                                        \r\n                                    </select>\r\n                                </section>\r\n\r\n                                <!-- **************** Tutor country option **************** -->\r\n                                <div class=\"clear-both\"></div>\r\n                                <section id=\"tutorCountryOptionDiv\" class=\"margin-top-20\" style=\"display: none\">\r\n                                    <label class=\"label\">Get tutors from</label>\r\n                                    <label class=\"select\">\r\n                                        <span><select name=\"getTutorFrom\" id=\"getTutorFrom\" class=\"form-control- col-sm-12-\"></select></span>\r\n                                        <i></i>\r\n                                    </label>\r\n                                </section>\r\n\r\n                                <!-- **************** Upload file option **************** -->\r\n                                <div class=\"clear-both\"></div>\r\n                                <section class=\"margin-top-10\">\r\n                                    <label class=\"label\">Upload files</label>\r\n                                    <div id=\"divQue\">\r\n                                        <label for=\"downloadableFilesList\" class=\"input input-file \">\r\n                                            <div class=\"button opaque\">\r\n                                                <input data-hj-whitelist type=\"file\" name=\"filesList\" onchange=\"getFileName(this,'fileNames');\"/>\r\n                                                <span><i class=\"fas fa-plus\"></i> Add</span>\r\n                                            </div>\r\n                                            <input type=\"text\" readonly=\"\" id=\"fileNames\" name=\"fileNames\"/>\r\n                                        </label>\r\n                                    </div>\r\n                                </section>\r\n\r\n\r\n\r\n                                <section id=\"dueDateDiv\" style=\"display: none;\">\r\n                                    <label class=\"label\">Due date</label>\r\n                                    <label class=\"input\">\r\n                                        <input data-hj-whitelist type=\"text\" placeholder=\"Due Date\" name=\"dueDateView\" id=\"dueDateView\" class=\"form-control\"/>\r\n                                        <input type=\"hidden\" id=\"dueDate\" name=\"dueDate\" maxlength=\"10\">\r\n                                    </label>\r\n                                </section>\r\n\r\n                                \r\n\r\n                                <section style=\"display: none\" class=\"alert alert-danger-light\" id=\"userLoggedOutReqLoginErrorMsg\">\r\n                                    <div class=\"margin-bottom-10\">You have been logged out</div>\r\n                                    <button type=\"button\" class=\"btn btn-default\" onclick=\"window.location.reload();\">Reload page</button>\r\n                                    <button type=\"button\" class=\"btn btn-primary\" onclick=\"openLoginScreenInPopupWindow();\">Login</button>\r\n                                </section>\r\n\r\n\r\n                                <section>\r\n                                    \r\n                                    <div id=\"commonMsg\" style=\"display: none; margin-bottom: 10px\" class=\"alert alert-danger-light\"></div>\r\n                                    <button type=\"button\" id=\"btnSave\" onclick=\"submitForm();\" class=\"btn-u btn-u-primary  btn-u-blue\" data-show=\"\" data-hide-slide-left=\"\" >Contact  now</button>\r\n                                    <img id=\"imageLoader\" style=\"display: none;\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/> &nbsp;\r\n                                    <a href=\"javascript:void(0);\" data-hide-slide-up=\"#additional_options_div\" onclick=\"setModelTitle('subjects');\" data-show-slide-down=\"#subjects_div\" >Back</a>\r\n                                </section>\r\n\r\n                            </div>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ******************************** Verify Phone number model START ***********************************  -->\r\n    \r\n    <div class=\"modal fade autoWidthModal wordBreak\" id=\"verifyPhoneAndViewTutorPhoneModal\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog\">\r\n            <form action=\"#\" id=\"verifyStudentPhoneForm\" class=\"sky-form\" method=\"post\">\r\n                <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n                <input type=\"hidden\" name=\"tutorId\" value=\"\"/>\r\n                <div class=\"modal-content text-center\">\r\n                    <div class=\"modal-header\" id=\"phoneVerifyHeader\">\r\n                        <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\r\n                        <h3 class=\"modal-title\"><span class=\"h1\"><i class=\"fas fa-mobile-alt color-blue\"></i></span> Verify Mobile</h3>\r\n                    </div>\r\n\r\n                    <div class=\"modal-body\" id=\"phoneVerifyMainBody\">\r\n\r\n                        <div id=\"verifyPhone_phoneNo\"></div>\r\n\r\n                        <!-- add dyanamic success/error message -->\r\n                        <div id=\"otpSentContainerDiv\" class=\"margin-top-20\">\r\n                            <div id=\"verifyNumCommonMsgParent\" class=\"\">\r\n                                <span id=\"verifyNumCommonMsg\"></span>\r\n                                <span id=\"timer\"></span>\r\n                                <span id=\"btnResendOTP\" style=\"display: none\"></span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"row text-right-\" id=\"sendOtpDiv\">\r\n                            <div class=\"col-md-12\">\r\n                                \r\n                                <div class=\"phoneCodeDiv\">\r\n                                        \r\n                                    <select id=\"studentPhoneCodeCountryId\" name=\"studentPhoneCodeCountryId\" data-placeholder=\"Code\" class=\"ts-custom-phone-code vertical-align-middle\" tabindex=\"-1\"></select>\r\n                                </div>\r\n                                <div class=\"phoneDivAfterPhoneCode\">\r\n                                    <input name=\"studentPhone\" id=\"studentPhone\" maxlength=\"15\" type=\"text\" class=\"form-control col-sm-8 numbers-only\" placeholder=\"Number\" inputmode=\"numeric\">\r\n                                </div>\r\n                                <div class=\"color-red\" id=\"studentPhoneValidationMsg\"></div>\r\n                            </div>\r\n\r\n                            <div class=\"margin-bottom-10\"></div>\r\n\r\n                            <div class=\"col-md-12\">\r\n                                <!-- hide below buttons during OTP genetation -->\r\n                                <div id=\"sendOtpDivBtns text-center\">\r\n                                    <button type=\"button\" class=\"btn-u btn-u-blue margin-bottom-10\" id=\"btnSendOTP\"><span class=\"h3 hidden\"><i class=\"fas fa-mobile-alt\"></i></span> Get OTP </button>\r\n                                    \r\n                                </div>\r\n                                <img id=\"imageLoader_sendOTPDiv\" style=\"display: none;\" src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div id=\"verifyOTPDiv\" style=\"display: none\">\r\n                            <div class=\"row\" id=\"otpDiv\">\r\n                                <div class=\"col-md-12\">\r\n                                    <section>\r\n                                        \r\n                                        <label class=\"input\">\r\n                                            <input type=\"text\" placeholder=\"Enter OTP\" maxlength=\"4\" name=\"otp\" id=\"otp\" class=\"format-text numbers-only\" inputmode=\"numeric\"/>\r\n                                            <input type=\"hidden\" name=\"tidEncry\" value=\"\"/>\r\n                                            <input type=\"hidden\" name=\"acceptTermsToShareContact\" id=\"acceptTermsToShareContact\" value=\"false\"/>\r\n                                        </label>\r\n                                    </section>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <div class=\"row\">\r\n                                <div class=\"col-md-12\" id=\"verifyOTPBtns\" style=\"display: none;\">\r\n                                    <button type=\"submit\" class=\"btn-u btn-u-blue margin-bottom-10 btn-block\" id=\"btnVerifyOTP\">Submit</button>\r\n                                    \r\n                                </div>\r\n                                <div class=\"col-md-12\" id=\"imageLoader_verifyOTPDiv\" style=\"display: none;\" >\r\n                                    <img src=\"https://assets2.teacheron.com/resources/assets/img/customImages/load.gif\"/>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </form>\r\n        </div>\r\n</div>\r\n    <!-- ******************************** Verify Phone number model  END***********************************  -->\r\n\r\n\r\n    \r\n    <span id=\"tutorContactDetailCommonDiv\"></span>\r\n\r\n\r\n\r\n\r\n    \r\n    <div class=\"modal fade autoWidthModal wordBreak\" id=\"contactTutorStudentPreviousJobListModal\" role=\"dialog\" aria-labelledby=\"myModalLabel\" aria-hidden=\"true\">\r\n        <div class=\"modal-dialog\" >\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\r\n                    <h3 class=\"modal-title text-center\">Message </h3>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <form action=\"javascript:void(0);\" id=\"previousPostForm\" class=\"sky-form\" method=\"get\">\r\n                        <input type=\"hidden\" name=\"_csrf\" value=\"QDkbELhA5sXd4B125Z7f5m1pfdIo4CqvXHW7kuEmHU2O4lsTJF8pKIhy3vLwhn4Q3bPr0QhdUOpJ0RyCaRDY8NkXLXTrhGwk\"/>\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-12\">\r\n                                <section>\r\n                                    <label class=\"label\"></label>\r\n                                    <label class=\"select\">\r\n                                        <select name=\"previousPostId\" id=\"previousPostId\">\r\n                                            <option value=\"\">-- Select a post --</option>\r\n                                        </select>\r\n                                        <i></i>\r\n                                    </label>\r\n                                </section>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-12\">\r\n                                <section>\r\n                                    <button id=\"btnContactUsingPreviousPost\" type=\"submit\" class=\"btn-u btn-block btn-u-blue\">Submit</button>\r\n                                </section>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-12\"> <center>------------ OR --------------- </center> </div>\r\n                        </div>\r\n\r\n                        <div class=\"row margin-top-20\">\r\n                            <div class=\"col-md-12\">\r\n                                <section>\r\n                                    <button id=\"btnContactUsingNewPost\" type=\"button\" class=\"btn-u btn-block btn-u-purple\">Contact for new requirement</button>\r\n                                </section>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!--=== Footer ===-->\r\n  \t\t<!--=== Footer Version 1 ===-->\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\"footer-v1 sticky-footer\">\r\n\t<div class=\"copyright\">\r\n\t\t<div class=\"container\">\r\n\t\t\r\n\t\t\r\n\t\t\t<div class=\"text-center\">\r\n\t\t\t\t<div class=\"display-inline-block\" style=\"max-width: 500px;clear: both;margin-top: 20px;padding-bottom: 20px;\">\r\n\t\t\t\t\t<p class=\"headline\" style=\"color: #fff;margin-bottom: 15px;font-weight: bold;text-align: center;display: none;\">Download our App</p>\r\n\t\t\t\t\t<div style=\"display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;\">\r\n\t\t\t\t\t\t<a href=\"https://play.google.com/store/apps/details?id=com.teacheron.teacheron_production&hl=en_IN\" target=\"_blank\" style=\"text-decoration: none;\">\r\n\t\t\t\t\t\t\t<img class=\"lozad-custom\" data-src=\"https://assets2.teacheron.com/resources/assets/img/GooglePlay.png\" alt=\"Get it on Google Play\" style=\"height: 45px; width: auto;\">\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t<a href=\"https://apps.apple.com/in/app/teacheron/id6736878030\" target=\"_blank\" style=\"text-decoration: none;\">\r\n\t\