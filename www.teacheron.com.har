          "content": {
            "size": 16103,
            "mimeType": "application/javascript",
            "text": "var URL_TUTOR_CONTACT = {\n    POST_REQUIREMENT_CONTACTTUTOR : URL_PREFIX_API_STUDENT+\"/contact-tutor-postreq\",\n    VALIDATE_AND_REDIRECT_TO_REVIEW : getAppContext()+'validate-and-redirect-to-review',\n    REGISTER_AS_CLIENT : MODULE_USER+\"/registerAsClient\",\n}\n\nvar setModelTitle = function(titleKey){\n    var title = 'My Email';\n    if(titleKey=='email'){\n        title = 'My Email';\n    }else if(titleKey=='loc'){\n        title = 'My Location';\n    } else if(titleKey=='contactDtl'){\n        title = 'My contact Details';\n    } else if(titleKey=='myReq'){\n        title = 'My requirements';\n    } else if(titleKey=='helpMeWith'){\n        title = '<small><a href=\"javascript:void(0);\" data-hide-slide-up=\"#assignment_tutoring_div\" onclick=\"setModelTitle(\\'myReq\\')\" data-show-slide-down=\"#summary_description_div\" data-focus=\"#title\" class=\"float-left\">Back</a></small><div class=\"text-center\">I want</div>';\n    } else if(titleKey=='tutOptions'){\n        title = 'Meeting Options';\n    }  else if(titleKey=='subjects'){\n        // Do not repopulate subejct when this screen reached.\n        isSubjectScreenReached = true;\n        title = 'Subjects';\n    } else if(titleKey=='canTravel'){\n        title = 'I can travel';\n    } else if(titleKey=='optionalInfo'){\n        title = 'Final step';\n    }\n    //console.log(title);\n    if(isChangeTitleValid)\n        $('#headerTitle').html(title);\n};\n\n// when new subject is added from popup after adding that subject close that model and again open contact tutor model.\nvar hideSubjectAddForm = function(){\n    // hide subject add model and open contact tutor model.\n    $('#subjectAddModel').modal('hide');\n    $('#contactTutorModel').modal('show');\n};\n\n// combine all validation in single method, that are required in last section of post requirement form.\nvar validateAdditionalOptionLastPart = function(){\n    // ------ validate budget and budgetType\n    var budgetVal = $('#budget').val();\n    var budgetTypeVal = $('#budgetType').val();\n    var isValidBudgetAndBudgetType = true;\n    if(isNotBlank(budgetVal) && isBlank(budgetTypeVal)){\n        isValidBudgetAndBudgetType = false;\n        validator.showErrors({\n            \"budgetType\": \"Please select budget type\"\n        });\n    }\n\n    // -------- Validate level\n    var levelId = $('#levelId').val();\n    var isValidLevel = true;\n    var isLevelDivVisible = $(\".clsAiLevelRequiredFromUserDiv\").is(':visible');\n    if(isBlank(levelId) && isLevelDivVisible){\n        isValidLevel = false;\n        validator.showErrors({\n            \"levelId\": \"Please select your level\"\n        });\n    }\n    // -------- Validate post visibility option (isPublicStudent)\n    var isValidStudentPublic  = $(\"#postRequirementForm\").validate().element(\"#isPublicStudent\");\n\n    // 29-May-23: scroll the form while showing the error\n    if(!isValidLevel){\n        $(\"#levelId\").focus();\n    } else if(!isValidBudgetAndBudgetType){\n        $(\"#budgetType\").focus();\n    } else if(!isValidStudentPublic){\n        $(\"#isPublicStudent\").focus();\n    }\n    // ----- END ---\n\n    var isTermsSelected = true;\n    // add code to check whether its visible or not. divId: \"termsAndConditionDiv\"\n    if($(\"#termsAndConditionDiv\").is(':visible')){\n        isTermsSelected  = $(\"#postRequirementForm\").validate().element(\"#terms\");\n    }\n    return isValidBudgetAndBudgetType && isValidLevel && isValidStudentPublic && isTermsSelected;\n};\n\nvar showMissingFieldErrorMessage = function(data){\n    var errorArr = data.split('@@');\n    for(var i=0; i<errorArr.length; i++){\n        var errorField = errorArr[i];\n        if(isNotBlank(errorField)){\n            if(errorField == 'USER_LOGGED_OUT_REQ_LOGIN'){\n                $('#userLoggedOutReqLoginErrorMsg').show();\n                break;\n            } else if(errorField == 'TUTOR_FOUND_RELOAD_PAGE'){\n                window.location.reload();\n            } else if(errorField=='req_location'){\n                hideAllPostReqFormDiv();\n                $('#autocomplete').val('');\n                clearLocationData(null);\n                // hide current screen and show location div\n                $('#location_div').fadeIn();//show();\n                validateLocation();\n\n                $('#locationErrorMsg').html('Please enter proper Location Name.');\n                $('#wrongLocationNameErrorDiv').show();\n\n                setModelTitle('loc');\n                $('#location_div').fadeIn();//show();\n            } else if(errorField=='req_subjects'){\n                hideAllPostReqFormDiv();\n                setModelTitle('subjects');\n                $('#subjects_div').fadeIn();\n                $(\"#postRequirementForm\").validate().element(\"#subjectIds\");\n            } else if(errorField == 'error_emailFoundWithName'){\n                hideAllPostReqFormDiv();\n                setModelTitle('contactDtl');\n                $('#contact_details_div').fadeIn();\n                $('#nameErrorMsg').html(ERROR_MSG.ERROR_NAME_AS_EMAIL_OR_PHONE);\n                $('#nameErrorMsg').show();\n                //$('#name').focus(); // 20-Feb-20: dont use focus() it is hiding error (due to validateName() - called automatically after onBlur) when user enters name+email\n            } else if(errorField == 'error_adminWordInName'){\n                hideAllPostReqFormDiv();\n                setModelTitle('contactDtl');\n                $('#contact_details_div').fadeIn();\n                $('#nameErrorMsg').html(ERROR_MSG.ADMIN_AS_NAME_NOT_ALLOWED);\n                $('#nameErrorMsg').show();\n                //$('#name').focus(); // 20-Feb-20: dont use focus() it is hiding error (due to validateName() - called automatically after onBlur) when user enters name+email\n            } else if(errorField == 'req_phoneCodeCountryId' || errorField=='req_phone'){\n                hideAllPostReqFormDiv();\n                setModelTitle('contactDtl');\n                $('#contact_details_div').fadeIn();\n                // Trigger validation\n                var isValidPhoneCode  = $(\"#postRequirementForm\").validate().element(\"#userPhoneCountryId\");\n                var isValidPhone  = $(\"#postRequirementForm\").validate().element(\"#phone\");\n            } else if(errorField == 'invalid_phone_length'){\n                hideAllPostReqFormDiv();\n                setModelTitle('contactDtl');\n                $('#contact_details_div').fadeIn();\n                showInvalidPhoneLengthError();\n            } else if(errorField == 'req_getTutorFrom'){\n                $(\"#postRequirementForm\").validate().element(\"#getTutorFrom\");\n                $('#getTutorFrom').addClass(\"state-error\").parents(\"span\").addClass(\"state-error\").removeClass(\"state-success\");\n                //$()\n            } else if(errorField == 'req_isStudentPublic'){\n                // trigger validation if this field is not selected.\n                var isValidStudentPublic  = $(\"#postRequirementForm\").validate().element(\"#isPublicStudent\");\n            }\n        }\n    }\n};\n\nvar submitForm = function(){\n    if(validateAdditionalOptionLastPart()){\n        // Fetch phoneCode from phone -> countryId dropdown\n        /*var userPhoneCode = $('#userPhoneCountryId').select2('data')[0].title;\n        if(isNotBlank(userPhoneCode)){\n            $('#userPhoneCode').val(userPhoneCode);\n        }*/\n        setPhoneCountryIdToHiddenFieldUsingTomSelect('userPhoneCountryId');\n        // This one is optional, because we are setting it on changing location. For contactTutorCase only.\n        $('#isPoor').val(isPoor);\n\n        var formData = new FormData($('form#postRequirementForm')[0]);\n        var commonMsgDivId = 'commonMsg';\n\n        // Before calling ajax, hide previous error if any.\n        $('#'+commonMsgDivId).html('');\n        $('#'+commonMsgDivId).hide();\n\n        $.ajax({\n            url: URL_TUTOR_CONTACT.POST_REQUIREMENT_CONTACTTUTOR,\n            type: 'POST',\n            data: formData,\n            cache: false,\n            contentType: false,\n            processData: false,\n            beforeSend: function() {\n                hideShowForSave(true);\n            },\n            success: function (data) {\n                // Note: in case of killPage words it will hang and show only loader image, it's ajax response was a html page that we are not processing.\n                var obj = JSON.parse(data);\n                if(obj.status == 'SUCCESS'){\n                    // once record saved successfully, remove data from browser storage\n                    var keyNames = listOfKeys+\"@@\"+locationKeys;\n                    removeValueFromSession(keyNames);\n\n                    // redirect user to given URL\n                    if(isNotBlank(obj.redirect_url)){\n                        // message comes from session, so direct redirect to another screen.\n                        window.location.href = obj.redirect_url;\n                    }\n                } else if(obj.status == 'ERROR'){\n                    var showBtnOnError = true;\n                    if(isNotBlank(obj.action) && obj.action == 'missingFields'){\n                        // check missing fields and show error message accordingly.\n                        showMissingFieldErrorMessage(obj.fieldDetails);\n                        if(isNotBlank(obj.contactSharedLogs)){\n                            setValueToTheContactLogs(obj.contactSharedLogs);\n                        }\n                    } else if(isNotBlank(obj.action) && obj.action == 'appCrashed'){\n                        showBtnOnError = false; // keep showing loader image.\n                    } else if(isNotBlank(obj.ERROR_MSG)){\n                        //alert(\"Error message: \"+obj.ERROR_MSG);\n                        showCustomErrorOrSuccessMsg(commonMsgDivId, obj.ERROR_MSG, MSG_TYPE_ERROR);\n                    }\n                    if(showBtnOnError){\n                        hideShowForSave(false);\n                    }\n                } else if(obj.status == 'NO_ACCESS'){\n                    showCustomErrorOrSuccessMsg(commonMsgDivId, ERROR_MSG.NO_PERMISSION_MSG, MSG_TYPE_ERROR);\n                }\n            },\n            complete: function() {\n\n            }\n        });\n    }\n};\n\nvar hideShowForSave = function(hideFlag){\n    if(hideFlag){\n        $('#btnSave').hide();\n        $('#imageLoader').show();\n    } else {\n        $('#btnSave').show();\n        $('#imageLoader').hide();\n    }\n};\n\n// ----------- Upload job file button start ----------------- START\nvar fs1 = '<label for=\"filesList\" class=\"input input-file\"><div class=\"button opaque\"><input type=\"file\" name=\"filesList\" onchange=\"getFileName(this,\\'textId\\');\" /><i class=\"fas fa-plus\"></i>Add</div><input type=\"text\" readonly=\"\" id=\"fileNames';\nvar fsCounter = 1;\nvar fs2 = '\"/></label>';\nvar textIdCounter = 0;\nvar textIdCounterString = \"\";\nvar totalUploadedFile = 0;\n\nfunction getFileName(src,textId) {\n    var isValidFile = validateFileExtension(src.value);\n    if(!isValidFile){\n        src.value = '';\n        return false;\n    } else {\n        var files = src.files;\n        var text = \"\";\n        for (var i = 0; i < files.length; i++) {\n            text += (files[i].name + \", \");\n        }\n        text = text.substring(0, text.length - 2);\n\n        textIdCounterString = textId.replace(\"fileNames\",\"\");\n        if(textIdCounterString!=\"\") textIdCounter = parseInt(textIdCounterString);\n\n        $('#'+textId).val(text);\n\n        if(textIdCounter+1==fsCounter){\n            totalUploadedFile++;\n            // don't show upload button when max file upload limit crossed.\n            if(totalUploadedFile < maxJobFilesUploadLimitTmp){\n                //$('#divQue').append(fs1.replace(\"textId\",\"fileNames\"+fsCounter)+fsCounter++ +fs2);\n                addOneMoreUploadBtn();\n            }\n        }\n    }\n};\n\nvar addOneMoreUploadBtn = function(){\n    $('.input-file').each(function() {\n        if($(this).find('.deleteFileButton').length != 1)\n            $(this).append('<div class=\"button btn-red opaque deleteFileButton\" style=\"background-color:#cd5c5c;\"><i class=\"fas fa-trash-alt\"></i> Delete</div>');\n    });\n    $('#divQue').append(fs1.replace(\"textId\",\"fileNames\"+fsCounter)+fsCounter++ +fs2);\n};\n\n$(document).on('click','.deleteFileButton',function(){\n    $(this).parent(\".input-file\").remove();\n    totalUploadedFile--;\n});\n// ----------- Upload job file button start -----------------END\n\nvar processTutorReviewAction = function(){\n    // reset previous error\n    $('#contactFlowByAjaxError').html('');\n    $('#contactFlowByAjaxError').hide();\n\n    $('#reqLogicToReviewErrorBottom').html('');\n    $('#reqLogicToReviewErrorBottom').hide();\n\n    // show error message as per the calling source.\n    var callingSource = $(this).attr(\"data-review-btn-source\");\n\n    var errorDivId = '';\n    if(callingSource!='' && callingSource == 'reviewLinkBottomSide'){\n        errorDivId = 'reqLogicToReviewErrorBottom';\n    } else if(callingSource == 'reviewBtnTopSide' || true){\n        errorDivId = 'contactFlowByAjaxError';\n    }\n\n    $.ajax({\n        url: URL_TUTOR_CONTACT.VALIDATE_AND_REDIRECT_TO_REVIEW+'?tid='+userIdEncry, // userIdEncry: It comes from tutorProfile.jsp\n        type: 'GET',\n        cache: false,\n        dataType: 'json',\n        success: function(obj) {\n            //var obj = JSON.parse(data);\n            if(obj.status == 'SUCCESS'){\n                if(isNotBlank(obj.action) && obj.action=='allowToReviewAndPaymentDone'){\n                    // when student does not pay to tutor, still student can provide review to tutor.\n                    // calling this method from userReviewModalCommon file.\n                    openReviewModalDirect();\n                } else if(isNotBlank(obj.action) && obj.action=='allowToEditReview'){\n                    // if there is only 1 review then allow to edit here.\n                    fetchReviewForUpdate(obj.reviewId);\n                } else {\n                    // redirect to payment screen to provide review. This case work only when student pay to tutor.\n                    window.location.href = obj.redirect_url;\n                }\n\n            } else if(obj.status == 'ERROR'){\n                if(isNotBlank(obj.action) && obj.action=='reqLogin'){\n                    $('#'+errorDivId).html('<i class=\"fas fa-exclamation-triangle\"></i> '+obj.ERROR_MSG);\n                    $('#'+errorDivId).show();\n                } else if(isNotBlank(obj.action) && obj.action=='paymentNotDone'){\n                    $('#'+errorDivId).html('<i class=\"fas fa-exclamation-triangle\"></i> '+obj.ERROR_MSG);\n                    $('#'+errorDivId).show();\n                } else {\n                    $('#'+errorDivId).html(obj.ERROR_MSG);\n                    $('#'+errorDivId).show();\n                }\n            } else if(obj.status == 'NO_ACCESS'){\n                //$('#'+errorDivId).html('<i class=\"fas fa-exclamation-triangle\"></i> Only student can review tutors.');\n                //$('#'+errorDivId).show();\n                var errorMsg = \"Only students can review tutors.<br>\";\n                errorMsg+= \"<a class=\\\"btn btn-u rounded color-white\\\" href='\"+URL_TUTOR_CONTACT.REGISTER_AS_CLIENT+\"'>Open student account</a>\";\n                $('#'+errorDivId).html(errorMsg);\n                $('#'+errorDivId).show();\n                // hide all 4 buttons (message, view phone, pay and review)\n                $('#contactTutorBtnDiv').hide();\n            }\n        },\n        error: function(e) {\n            $('#'+errorDivId).html(ERROR_MSG.COMMON_ERROR_MSG);\n            $('#'+errorDivId).show();\n        }\n    });\n}\n\nvar setJobType = function(jobType){\n    $('#jobType').val(jobType);\n};\n\nfunction readDescAndFindSubjects(){\n    // once student reached subject screen do not allow to re-generate tags.\n    if(!isSubjectScreenReached){\n        readDescAndFindSubjectsCommon();\n    }\n};\n\nvar contactTutor = function(){\n    $('#contactTutorModel').modal({\n        backdrop: 'static',\n        keyboard: false\n    });\n    //$(\"#autocomplete\").focus();\n};\n\nvar showContactErrorMsg = function(){\n    // hide all 4 buttons (message, view phone, pay and review)\n    $('#contactTutorBtnDiv').hide();\n    $('#contactErrorDiv').show();\n};"
          },
