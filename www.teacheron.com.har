          "content": {
            "size": 7051,
            "mimeType": "application/javascript",
            "text": "var subjectSearchCallingFlow = \"\";\n// 03-Sep-24: Commented Bootstrap select2 - subject autocomplete code and adding \"tom select\"\nfunction initSubjectMultipleTomSelect(){\n    // 21-Nov-24: Now api is restricted, csrf is required.\n    const csrfToken = document.querySelector('meta[name=\"_csrf\"]').getAttribute('content');\n    const csrfHeader = document.querySelector('meta[name=\"_csrf_header\"]').getAttribute('content');\n\n    // document.addEventListener('DOMContentLoaded', function () {\n        subjectSearchTomSelect = new TomSelect('#subjectIds', {\n            valueField: 'value',        // The field that represents the option's value\n            labelField: 'label',        // The field that represents the option's label\n            searchField: 'label',       // The field to search in (using 'label' here)\n            maxItems: null,             // Allow multiple selections\n            create: false,  // Disable the creation of new items,\n            duplicates: true, // Custom property to enable handling duplicates (can ignore if not needed)\n            load: function (query, callback) {\n                if (!query.length) return callback();\n\n                // Perform an AJAX request to fetch data using POST method\n                fetch(URL_POST_REQ_COMMON.SUBJECT_SEARCH_AJAX, {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json',\n                        [csrfHeader]: csrfToken // Add the CSRF token to the headers\n                    },\n                    body: JSON.stringify({\n                        // subjectName: query  // Sending the query as \"subjectName\" in the body\n                        subjectName: removeSmileys(query),\n                        max: 50, // Setting 50 instead of 10\n                        // excludeSubjectIds: getSelectedSubjectIds()\n                        callingFlow: subjectSearchCallingFlow\n                    })\n                })\n                    .then(response => response.json())\n                    .then(results => {\n                        // Parse and return results to Tom Select\n                        callback(results);\n                    }).catch(() => {\n                    // Handle any errors\n                    callback();\n                });\n            },\n            // Optional: To load some initial options (if you have pre-existing data)\n            options: [],  // Start with no options\n            optgroups: [], // Start with no optgroups\n            placeholder: 'Enter subjects',\n\n            // remove_button Allows users to remove selected options when clicked on x button.\n            // caret_position','input_autogrow' allows movement among selected options with arrow keys\n            plugins: ['remove_button','caret_position','input_autogrow'],\n\n            render: {\n                option: function(item, escape) {\n                    return generateOptionItemHtml(item);\n                },\n                item: function(item, escape) {\n                    return generateOptionItemHtml(item);\n                },\n                no_results: function(data, escape) {\n                    //return `<div class=\"no-results-message\">No results found for `+data.input+`.<a href=\"https://example.com/suggest\" target=\"_blank\">Suggest a new subject</a></div>`;\n                    return  '<div class=\"alert-\" style=\"padding: 10px\">'+\" ...not found <a class='btn btn-primary color-white btn-xs' href='javascript:void(0);' onclick='openSubjectAddModel();' class='js-programmatic-close'>Add \"+data.input+\"</a> </div>\";\n                }\n            },\n\n            // onType event to capture when the user types in the input\n            onType: function(str) {\n                subjectSearchTomSelect.removeOption(0);\n                this.settings.openOnFocus = false; // added as people think only the options they see are available\n                this.settings.closeAfterSelect = true; // added as people think only the options they see are available\n            },\n            // Callback when an item is added (selected)\n            onItemAdd: function(value, item) {\n                console.log(\" ------ subject added ------ \");\n                // this.clear();  // Clear the search input after selecting an item\n                this.setTextboxValue('');  // Clear only the search input field after selecting an item\n\n                // Refresh options so it doesn't give error - not found for already selected item\n                this.refreshOptions(false);\n\n                stopSubjectSuggestionFromDescription = true;\n                // Hide the placeholder when an item is added\n                this.settings.placeholder = '';  // Clear placeholder\n            },\n            // Event triggered when a value is unselected (item removed)\n            onItemRemove: function(value) {\n                //console.log(' ------ subject item removed ------ ', value);\n                stopSubjectSuggestionFromDescription = true;\n            },\n            // Event triggered when the dropdown is opened\n            onDropdownOpen: function(dropdown) {\n                // console.log(' ------- Dropdown selected -------- ', dropdown);\n                stopSubjectSuggestionFromDescription = true;\n            },\n        });\n    // });\n};\n\nfunction generateOptionItemHtml(item) {\n    const customClass = item.customClass ? item.customClass : '';\n\n    // Create the main container div\n    const div = document.createElement('div');\n    div.className = customClass;\n\n    // Create the main label span\n    const span = document.createElement('span');\n    span.innerText = item.label;\n    div.append(span);\n\n    // Optionally append description span if it's not blank\n    if (isNotBlank(item.description)) {\n        const descSpan = document.createElement('span');\n        descSpan.innerText = \" (\" + item.description + \") \";\n        div.append(descSpan);\n    }\n\n    // Optionally append tutor count and link if needed\n    if (showTutorCountWithSubjectSearch) {\n        console.log('item.countActiveTutorSelf',item.countActiveTutorSelf)\n        if (isBlank(item.countActiveTutorSelf) && item.countActiveTutorSelf!==0) item.countActiveTutorSelf = \"?\";\n        const countSpan = document.createElement('span');\n        countSpan.innerText = \" (\" + item.countActiveTutorSelf + \") \";\n        countSpan.style.fontSize = \"65%\";\n        div.append(countSpan);\n\n        const a = document.createElement('a');\n        a.className = 'small padding-left-5';\n        a.href = MODULE_AGENT + \"/subjectFindByIdAI?id=\" + item.value;\n\n        const linkIconSpan = document.createElement('span');\n        linkIconSpan.className = 'fas fa-link';\n        a.append(linkIconSpan);\n        div.append(a);\n\n        // Add click event handler to open link in new tab\n        a.addEventListener('click', function (evt) {\n            evt.preventDefault();\n            evt.stopPropagation();\n            var href = $(this).attr('href');\n            window.open(href, '_blank');\n        });\n    }\n\n    return div;\n}"
          },
