          "content": {
            "size": 13625,
            "mimeType": "application/javascript",
            "text": "/*\n * 07-Nov-2026 (R-44): Level picker as rows of pills. The endpoint (pickerRows=true) sends one row per stage,\n * e.g. \"Grade 10 · IGCSE · GCSE · O level\". A row is listed and searched but can't be picked, every level on it is a pill\n * that saves its own level id, so the form posts the same levelId as before.\n * Options: one per pill (kind 'level', never listed, it is what gets selected) and one per row (kind 'row', disabled).\n */\nTomSelect.define('level_pill_rows', function(){\n    const self = this, origSearch = self.search;\n    // list rows only, pills are shown inside their row\n    self.search = function(query){\n        const result = origSearch.call(self, query);\n        result.items = result.items.filter(i => self.options[i.id].kind !== 'level');\n        return result;\n    };\n    // a row shows the typed search word as a pill, so render rows again for every query\n    self.hook('before', 'refreshOptions', () => self.clearCache());\n    self.on('initialize', () => {\n        // show the active pill only after typing or arrow keys, so an untouched dropdown has no grey row\n        self.control_input.addEventListener('keydown', e => {\n            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') self.dropdown.classList.add('show-active');\n        });\n        // a row with one pill can be clicked anywhere, rows with more pills need the pill itself\n        self.dropdown.addEventListener('click', e => {\n            const row = e.target.closest('.level-row.single');\n            if (row && !e.target.closest('.level-pill')) self.onOptionSelect(e, row.querySelector('.level-pill'));\n        });\n    });\n    // mark the saved pill, and make the pill that best matches the typed text the one Enter picks\n    self.hook('after', 'refreshOptions', () => {\n        const pills = [...self.dropdown_content.querySelectorAll('.level-pill')];\n        if (!pills.length) return;\n        const saved = self.items[0] != null ? String(self.items[0]) : null;\n        pills.forEach(p => p.classList.toggle('selected', p.dataset.value === saved));\n        const q = (self.lastQuery || '').trim().toLowerCase();\n        const name = p => p.textContent.trim().toLowerCase();\n        self.dropdown.classList.toggle('show-active', !!q);\n        let best = null;\n        if (q) {\n            const wordStart = new RegExp('^' + q.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\b');\n            best = pills.find(p => name(p) === q) || pills.find(p => wordStart.test(name(p)))\n                || pills.find(p => name(p).startsWith(q)) || pills.find(p => name(p).includes(q));\n        } else {\n            best = pills.find(p => p.dataset.value === saved);\n        }\n        self.setActiveOption(best || pills[0]);\n    });\n});\n\n// 07-Nov-2026 (R-44): Rows from the endpoint become Tom Select options.\nvar prepareLevelPickerOptions = function(rows){\n    const options = [];\n    rows.forEach(r => {\n        // one option per pill: never listed, it is what gets selected and shown in the field\n        r.pills.forEach(p => options.push({id: p.id, level: p.name, kind: 'level', groupName: r.group}));\n        // one option per row: listed and searched, never selected itself (disabled), its pills are\n        options.push({id: 'row-' + r.rowId, kind: 'row', disabled: true, groupName: r.group, pills: r.pills, search: r.search,\n            level: r.pills.map(p => p.name).join(' · '), names: r.search.map(s => s.word).join(',')});\n    });\n    return options;\n};\n\n// 07-Nov-2026 (R-44): A row is its pills on one or more lines. Old response (no rows) renders one level as before.\nvar renderLevelOption = function(item, escape){\n    if (item.kind !== 'row') {\n        let customClass = '';\n        if (item.customClass) {\n            customClass = item.customClass;\n        }\n        return `<div class=\"`+customClass+`\"><span>`+item.level+`</span></div>`;\n    }\n    const q = (this.lastQuery || '').trim().toLowerCase();\n    let pills = item.pills;\n    // typed a search word e.g. \"10th\": show it as a pill next to the level it means, it saves that level\n    if (q && !item.level.toLowerCase().includes(q)) {\n        const hit = item.search.find(s => s.word.toLowerCase().includes(q));\n        if (hit) {\n            const i = pills.findIndex(p => p.id === hit.pill);\n            const typed = {id: hit.pill, name: hit.word, line: i < 0 ? 0 : pills[i].line};\n            pills = i < 0 ? [...pills, typed] : [...pills.slice(0, i + 1), typed, ...pills.slice(i + 1)];\n        }\n    }\n    const lines = [...new Set(pills.map(p => p.line || 0))].sort((a, b) => a - b);\n    const html = lines.map(n => pills.filter(p => (p.line || 0) === n)\n        .map(p => `<span class=\"level-pill\" data-selectable data-value=\"${escape(String(p.id))}\">${escape(p.name)}</span>`).join(''))\n        .join('<span class=\"level-row-break\"></span>');\n    return `<div class=\"level-row${item.pills.length === 1 ? ' single' : ''}\">${html}</div>`;\n};\n\n\n// document.addEventListener('DOMContentLoaded', function () {\nvar initTomSelectForLevel = function(minLevelSeq=0, maxLevelSeq=0, levelGroupName=0){\n    console.log('initTomSelectForLevel(): minLevelSeq: '+minLevelSeq+', maxLevelSeq: '+maxLevelSeq+', levelGroupName: '+levelGroupName);\n    levelTomSelect = new TomSelect('#levelId', {\n        options: [],\n        optgroups: [\n            {order: 1, id: '2', name: 'Grades'},\n            //{order: 2, id: '1', name: '--- Skills ---'},\n            {order: 2, id: '1', name: 'Skill'},\n        ],\n        labelField: 'level',\n        valueField: 'id',\n        optgroupField: 'groupName', // column name who decide group of level.\n        optgroupLabelField: 'name',\n        optgroupValueField: 'id',\n        lockOptgroupOrder: true,\n        // 07-Nov-2026 (R-44): 'names' are the row's search words, 'synonymLevel' is kept for the old response\n        searchField: ['level', 'synonymLevel', 'names'],\n        sortField: [{field: '$score', direction: 'desc'}, {field: '$order'}],\n        // 07-Nov-2026 (R-44): a row holding the whole typed phrase (\"a level\") ranks above rows matching its words apart\n        score: function(search) {\n            const baseScore = this.getScoreFunction(search), q = search.trim().toLowerCase();\n            return function(item) {\n                const score = baseScore(item);\n                if (!score || !q)\n                    return score;\n                const names = [...item.level.split(' · '), ...(item.names || '').split(',')];\n                return names.some(n => n.toLowerCase().includes(q)) ? score + 1 : score;\n            };\n        },\n        // 07-Nov-2026 (R-44): rows of pills in one column, replaces optgroup_columns\n        plugins: ['level_pill_rows'],\n        /*load: function(query, callback) {\n            // Do nothing, so no loader appears.\n            callback();\n        },*/\n        onInitialize: function() {\n            // Access the ts-wrapper element\n            const tsWrapper = this.wrapper;\n            // Remove the unwanted class from the ts-wrapper\n            if (tsWrapper.classList.contains('form-control')) {\n                tsWrapper.classList.remove('form-control');\n            }\n        },\n        // Event to hide cursor after selection\n        onItemAdd: function(value, item) {\n            this.blur();\n        },\n        // Handle when the user opens the dropdown to change selection\n        onDropdownOpen: function(dropdown) {\n            const input = this.control_input;\n            input.value = '';  // Clear the input field\n            input.focus();     // Place focus in the search field\n\n            const selectedItem = this.control.querySelector('.item');  // Select the currently selected item\n            // Apply a custom class to the selected item\n            if (selectedItem) {\n                selectedItem.classList.add('ts-float-selected');\n            }\n            dropdown.classList.add('displayTable');\n\n            // const selectedValue = this.getValue();  // Get the currently selected value\n        },\n        onDropdownClose: function(dropdown) {\n            const selectedItem = this.control.querySelector('.item');  // Select the currently selected item\n            // Apply a custom class to the selected item\n            if (selectedItem) {\n                selectedItem.classList.remove('ts-float-selected');\n            }\n            dropdown.classList.remove('displayTable');\n            this.blur();\n        },\n        render: {\n            optgroup_header: function(data) {\n                // Customize the optgroup header with an additional class\n                return `<div class=\"optgroup-header-- dropdown-header\">`+data.name+`</div>`;\n            },\n            // 07-Nov-2026 (R-44): rows of pills, see renderLevelOption()\n            option: renderLevelOption,\n        }\n    });\n\n    // fetch option data and set it.\n    // Manually trigger loading the data after initializing TomSelect\n    // 07-Nov-2026 (R-44): pickerRows=true sends levels as rows of pills\n    var levelUrl = URL_PREFIX_API_USER+\"/all-levels-group-by-type?pickerRows=true\";\n    if(isNotBlank(minLevelSeq) && isNotBlank(maxLevelSeq) && isNotBlank(levelGroupName) && levelGroupName>0)\n        levelUrl = levelUrl + \"&minSearchSequence=\"+minLevelSeq+\"&maxSearchSequence=\"+maxLevelSeq+\"&levelGroupName=\"+levelGroupName;\n\n    fetch(levelUrl)\n        .then(response => response.json())\n        .then(json => {\n            // 07-Nov-2026 (R-44): rows of pills, groups come from the response (short ladders first)\n            if (json && json.status=='SUCCESS' && json.rows && json.rows.length) {\n                levelTomSelect.clearOptionGroups();\n                json.groups.forEach(group => levelTomSelect.addOptionGroup(String(group.id), {name: group.name}));\n                levelTomSelect.addOption(prepareLevelPickerOptions(json.rows));\n                if (isNotBlank(selectedLevelId)) {\n                    levelTomSelect.setValue(selectedLevelId);\n                }\n            } else if (json && json.status=='SUCCESS') {\n                // Modify the options to disable the specific field with id 1111\n                /*const modifiedOptions = json.levels.map(option => {\n                    // If you want to modify any level data\n                    /!*if (option.id === 11111) {\n                        option.disabled = true; // Disable the option with id 1111\n                        option.customClass = 'dropdown-header';\n                    }*!/\n                    return option;\n                });*/\n\n                // Logic to add group name dynamically.\n                /*const modifiedOptionsGroup = json.levelGroups.map(optionGroup => {\n                    // Modify the level, id, and order based on the condition\n                    if (optionGroup.level.indexOf(\"Skill\") > -1) {\n                        return { id: '2', name: \"Skill\", order: 2 };\n                        //{order: 1, id: '2', name: 'Grades'}\n                    } else if (optionGroup.level.indexOf(\"Grades\") > -1) {\n                        return { id: '1', name: \"Grades\", order: 1 };\n                    } else if (optionGroup.level.indexOf(\"Others\") > -1) {\n                        return { id: '2', name: \"Others\", order: 2 }; // Ensure unique id\n                    }\n                    return null; // Return null for non-matching cases\n                }).filter(group => group !== null); // Filter out null values\n\n                // Sort groups based on the order property\n                modifiedOptionsGroup.sort((a, b) => a.order - b.order);\n\n                // Adding option groups dynamically\n                modifiedOptionsGroup.forEach(group => {\n                    // Make sure to check that group.id and group.level are defined\n                    if (group.id && group.name) {\n                        levelTomSelect.addOptionGroup(group.id, group.name);\n                    }\n                });*/\n\n\n                const modifiedOptions = [...json.levels]; // Create a shallow copy of the original array\n                // Find the index of the record with id = 39\n                const index = modifiedOptions.findIndex(option => option.id === 39);\n                if(index!==-1){\n                    modifiedOptions[index].groupName = 1;\n                    // Define the new data you want to insert\n                    const newOptionGroupForAdultAndCasualLearning = {\n                        id: 99,\n                        disabled: true,\n                        customClass: 'dropdown-header',\n                        level: \"Others\",\n                        groupName: 1,\n                    };\n                    // Check if the record with id 39 exists\n                    if (index !== -1) {\n                        // Insert the new data just before the record with id = 39\n                        modifiedOptions.splice(index, 0, newOptionGroupForAdultAndCasualLearning);\n                    }\n                }\n                // levelTomSelect.addOption(json.data);  // Add options programmatically\n                levelTomSelect.addOption(modifiedOptions);\n                //levelTomSelect.refreshOptions();  // Refresh options\n                if (isNotBlank(selectedLevelId)) {\n                    levelTomSelect.setValue(selectedLevelId);\n                }\n            }\n        })\n        .catch((error) => {\n            console.error(\"Failed to initialize Level tom select. Error: \", error);\n        });\n// });\n};\n\nvar destroyTomSelectForLevel = function(inputId) {\n    const el = document.querySelector('#'+inputId);\n    // Check if TomSelect is already bound\n    if (el.tomselect) {\n        el.tomselect.destroy();\n    }\n}"
          },
